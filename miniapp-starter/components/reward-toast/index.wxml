<view wx:if="{{visible}}"
      class="reward-overlay reward-overlay--{{kind}}"
      bindtap="handleSkip">
  <block wx:if="{{kind === 'task'}}">
    <view class="reward-task" catchtap="handleSkip">
      <text class="reward-task__pet">{{petEmoji}}</text>
      <view wx:if="{{coins > 0}}" class="reward-task__coin">
        <view class="coin coin--sm"><text class="coin__sym">¥</text></view>
        <text class="reward-task__coin-text">+{{coins}}</text>
      </view>
      <text wx:if="{{subtitle}}" class="reward-task__caption">{{subtitle}}</text>
    </view>
  </block>

  <block wx:elif="{{kind === 'allDone'}}">
    <!-- Coin rain spans the whole overlay so coins can fall from above the card -->
    <view class="reward-rain">
      <view class="reward-rain__c reward-rain__c--1"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--2"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--3"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--4"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--5"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--6"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--7"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--8"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--9"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--10"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--11"><view class="coin"><text class="coin__sym">¥</text></view></view>
      <view class="reward-rain__c reward-rain__c--12"><view class="coin"><text class="coin__sym">¥</text></view></view>
    </view>

    <view class="reward-alldone" catchtap="noop">
      <text class="reward-alldone__star reward-alldone__star--s1">⭐</text>
      <text class="reward-alldone__star reward-alldone__star--s2">✨</text>
      <text class="reward-alldone__star reward-alldone__star--s3">🌟</text>
      <text class="reward-alldone__star reward-alldone__star--s4">⭐</text>
      <text class="reward-alldone__star reward-alldone__star--s5">✨</text>
      <text class="reward-alldone__star reward-alldone__star--s6">🌟</text>
      <text class="reward-alldone__star reward-alldone__star--s7">⭐</text>
      <text class="reward-alldone__star reward-alldone__star--s8">✨</text>
      <text class="reward-alldone__star reward-alldone__star--s9">🌟</text>
      <text class="reward-alldone__star reward-alldone__star--s10">⭐</text>
      <text class="reward-alldone__star reward-alldone__star--s11">✨</text>
      <text class="reward-alldone__star reward-alldone__star--s12">🌟</text>

      <view class="reward-alldone__pet-wrap">
        <text class="reward-alldone__pet">{{petEmoji}}</text>
      </view>
      <text class="reward-alldone__title">{{subtitle || '今日全部完成!'}}</text>

      <!-- Single big TOTAL — the daily-perfect bonus rushing in from small
           to large. The per-task +10 already played in the task toast right
           before this card; we don't repeat it here. -->
      <view class="reward-alldone__stage">
        <view class="reward-alldone__total">
          <view class="coin coin--lg"><text class="coin__sym">¥</text></view>
          <text class="reward-alldone__total-text">+{{coins}}</text>
          <text class="reward-alldone__total-suffix">金币!</text>
        </view>
      </view>

    </view>
  </block>
</view>
