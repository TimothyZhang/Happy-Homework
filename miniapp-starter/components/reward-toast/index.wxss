/* ===== Shared overlay ===== */
.reward-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  /* Non-blocking: scrolling underneath stays possible because we set
     pointer-events to none on the backdrop and re-enable only on the card. */
  pointer-events: none;
}

.reward-overlay--allDone {
  background: rgba(15, 23, 42, 0.32);
  pointer-events: auto;
  animation: reward-fade-in 220ms ease-out;
}

/* ===== Single-task: small floating cluster, no backdrop ===== */
.reward-task {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(31, 35, 41, 0.18);
  pointer-events: auto;
  animation: reward-task-pop 1200ms ease-out forwards;
}

.reward-task__pet {
  font-size: 88rpx;
  line-height: 1;
  display: inline-block;
  animation: reward-task-wobble 600ms ease-in-out 80ms 2;
}

.reward-task__coin {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffd76a 0%, #ffa826 100%);
  box-shadow: 0 6rpx 14rpx rgba(255, 168, 38, 0.36);
  animation: reward-coin-fly 700ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  opacity: 0;
}

/* === CSS coin (used in all three slots: task pill, big total, rain) === */
.coin {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #fff6c8 0%, #ffd76a 38%, #d68a0c 100%);
  border: 3rpx solid #c97a06;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -4rpx 8rpx rgba(120, 60, 0, 0.32),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.55),
              0 4rpx 10rpx rgba(180, 100, 10, 0.32);
}
.coin__sym {
  font-size: 32rpx;
  font-weight: 900;
  color: #7a3d00;
  line-height: 1;
  letter-spacing: 0;
}
/* Small variant: lives inside the task-toast gold pill. */
.coin--sm { width: 38rpx; height: 38rpx; border-width: 2rpx; }
.coin--sm .coin__sym { font-size: 22rpx; }
/* Large variant: the all-done card's main coin next to "+N 金币!". */
.coin--lg { width: 86rpx; height: 86rpx; border-width: 4rpx; }
.coin--lg .coin__sym { font-size: 50rpx; }

.reward-task__coin-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #6b3c00;
  letter-spacing: 1rpx;
}

/* Happiness pill on the task toast — pink to mirror the 💖 icon and stand
   apart from the gold coin pill. Same flying-in animation as the coin pill
   so the two land together. */
.reward-task__happy {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffd0e2 0%, #ff7eb6 100%);
  box-shadow: 0 6rpx 14rpx rgba(255, 126, 182, 0.32);
  animation: reward-coin-fly 700ms cubic-bezier(0.34, 1.56, 0.64, 1) 60ms forwards;
  opacity: 0;
}
.reward-task__happy-icon {
  font-size: 24rpx;
  line-height: 1;
}
.reward-task__happy-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #8a2057;
  letter-spacing: 1rpx;
}

/* Subtitle line under the +N pill — used for tier hints like
   "提前完成 +5" or "今日已达 20 项上限". Sits to the right of the coin
   pill, slightly muted, with a fade-in tied to the coin animation. */
.reward-task__caption {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a4a00;
  letter-spacing: 0.5rpx;
  margin-left: 4rpx;
  animation: reward-coin-fly 700ms cubic-bezier(0.34, 1.56, 0.64, 1) 80ms forwards;
  opacity: 0;
}

/* ===== All done: full overlay with pet hero ===== */
.reward-alldone {
  position: relative;
  width: 600rpx;
  padding: 60rpx 36rpx 60rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #fff8e6 0%, #ffe1a8 100%);
  text-align: center;
  box-shadow: 0 28rpx 72rpx rgba(0, 0, 0, 0.28);
  animation: reward-card-pop 600ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
             reward-card-out 360ms ease-in 2840ms forwards;
}

.reward-alldone__pet-wrap {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #fffceb 0%, #ffd76a 70%, #ffa826 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(255, 168, 38, 0.42);
  animation: reward-pet-superhype 2200ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.reward-alldone__pet {
  font-size: 144rpx;
  line-height: 1;
}

.reward-alldone__title {
  display: block;
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #b9540c;
  letter-spacing: 2rpx;
}

/* Single big TOTAL stage — the daily bonus rushes in from small to huge,
   then settles. No flash / no equation — the per-task +10 already played
   in the task toast immediately before this card. */
.reward-alldone__stage {
  position: relative;
  height: 180rpx;
  margin-top: 28rpx;
}

.reward-alldone__total {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  opacity: 0;
  animation: reward-alldone-total 1700ms cubic-bezier(0.16, 1, 0.3, 1) 380ms forwards;
}

.reward-alldone__total-text {
  font-size: 140rpx;
  font-weight: 900;
  color: #6b2c00;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #ffb14a 0%, #ff7a1a 50%, #ffd76a 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 0 32rpx rgba(255, 168, 38, 0.7),
               0 6rpx 16rpx rgba(255, 138, 31, 0.5);
}

.reward-alldone__total-suffix {
  font-size: 50rpx;
  font-weight: 900;
  color: #6b2c00;
  letter-spacing: 2rpx;
}

/* Happiness line under the big coin total — pink pill matching the task
   toast's happy chip but rendered as a full-width row so the message
   ("加满啦！") fits. Fades in slightly after the coin total settles. */
.reward-alldone__happy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffd0e2 0%, #ff7eb6 100%);
  box-shadow: 0 6rpx 18rpx rgba(255, 126, 182, 0.36);
  opacity: 0;
  animation: reward-coin-fly 700ms cubic-bezier(0.34, 1.56, 0.64, 1) 1400ms forwards;
}
.reward-alldone__happy-icon {
  font-size: 36rpx;
  line-height: 1;
}
.reward-alldone__happy-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #8a2057;
  letter-spacing: 1rpx;
}

/* Sparkle stars around the card (12 total, scattered farther than v1). */
.reward-alldone__star {
  position: absolute;
  font-size: 48rpx;
  line-height: 1;
  opacity: 0;
  pointer-events: none;
  animation: reward-star-burst 2200ms ease-out 360ms forwards;
}

.reward-alldone__star--s1  { top: -10rpx;   left: 50%;     --tx: -160rpx; --ty: -260rpx; }
.reward-alldone__star--s2  { top: 30rpx;    right: -20rpx; --tx: 220rpx;  --ty: -180rpx; }
.reward-alldone__star--s3  { bottom: 60rpx; right: -30rpx; --tx: 240rpx;  --ty: 180rpx; }
.reward-alldone__star--s4  { bottom: -10rpx; left: 50%;    --tx: 100rpx;  --ty: 280rpx; }
.reward-alldone__star--s5  { bottom: 60rpx; left: -30rpx;  --tx: -240rpx; --ty: 180rpx; }
.reward-alldone__star--s6  { top: 30rpx;    left: -20rpx;  --tx: -220rpx; --ty: -160rpx; }
.reward-alldone__star--s7  { top: 100rpx;   left: 50%;     --tx: -80rpx;  --ty: -300rpx; }
.reward-alldone__star--s8  { bottom: 100rpx; left: 50%;    --tx: 80rpx;   --ty: 300rpx; }
.reward-alldone__star--s9  { top: 50%;      right: -10rpx; --tx: 280rpx;  --ty: 60rpx; }
.reward-alldone__star--s10 { top: 50%;      left: -10rpx;  --tx: -280rpx; --ty: 60rpx; }
.reward-alldone__star--s11 { top: 0;        left: 28%;     --tx: -200rpx; --ty: -240rpx; }
.reward-alldone__star--s12 { bottom: 30rpx; right: 28%;    --tx: 180rpx;  --ty: 260rpx; }

/* ===== Coin rain (12 CSS coins falling from top) ===== */
.reward-rain {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.reward-rain__c {
  position: absolute;
  top: -120rpx;
  left: 50%;
  opacity: 0;
  animation: reward-coin-rain 2400ms ease-in forwards;
}

.reward-rain__c--1  { --rx: -300rpx; animation-delay: 80ms; }
.reward-rain__c--2  { --rx: -220rpx; animation-delay: 260ms; }
.reward-rain__c--3  { --rx: -140rpx; animation-delay: 480ms; }
.reward-rain__c--4  { --rx:  -60rpx; animation-delay: 660ms; }
.reward-rain__c--5  { --rx:   60rpx; animation-delay: 200ms; }
.reward-rain__c--6  { --rx:  140rpx; animation-delay: 420ms; }
.reward-rain__c--7  { --rx:  220rpx; animation-delay: 600ms; }
.reward-rain__c--8  { --rx:  300rpx; animation-delay: 800ms; }
.reward-rain__c--9  { --rx: -260rpx; animation-delay: 1000ms; }
.reward-rain__c--10 { --rx: -100rpx; animation-delay: 1180ms; }
.reward-rain__c--11 { --rx:  100rpx; animation-delay: 1320ms; }
.reward-rain__c--12 { --rx:  260rpx; animation-delay: 1500ms; }

/* ===== Keyframes ===== */
@keyframes reward-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes reward-task-pop {
  0%   { opacity: 0; transform: translateY(40rpx) scale(0.7); }
  18%  { opacity: 1; transform: translateY(-8rpx) scale(1.05); }
  30%  { transform: translateY(0) scale(1); }
  75%  { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(-30rpx) scale(0.96); }
}

@keyframes reward-task-wobble {
  0%, 100% { transform: rotate(0deg); }
  25%      { transform: rotate(-12deg); }
  75%      { transform: rotate(12deg); }
}

@keyframes reward-coin-fly {
  0%   { opacity: 0; transform: translate(40rpx, 30rpx) scale(0.5); }
  60%  { opacity: 1; transform: translate(-6rpx, -10rpx) scale(1.18); }
  100% { opacity: 1; transform: translate(0, 0) scale(1); }
}

@keyframes reward-card-pop {
  0%   { opacity: 0; transform: scale(0.5); }
  70%  { opacity: 1; transform: scale(1.04); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes reward-card-out {
  from { opacity: 1; transform: scale(1); }
  to   { opacity: 0; transform: scale(0.92); }
}

/* Pet does jump 1 → 360° spin → jump 2 → settles in a happy floating pose
   that holds until the card fades. */
@keyframes reward-pet-superhype {
  0%   { transform: rotate(-20deg) scale(0.4) translateY(0); }
  10%  { transform: rotate(-10deg) scale(1.1)  translateY(-30rpx); }
  20%  { transform: rotate(0deg)   scale(1.0)  translateY(0); }
  35%  { transform: rotate(180deg) scale(1.18) translateY(-22rpx); }
  55%  { transform: rotate(360deg) scale(1.0)  translateY(0); }
  70%  { transform: rotate(360deg) scale(1.18) translateY(-44rpx); }
  85%  { transform: rotate(360deg) scale(1.0)  translateY(0); }
  100% { transform: rotate(360deg) scale(1.06) translateY(-6rpx); }
}

@keyframes reward-star-burst {
  0%   { opacity: 0; transform: translate(0, 0) scale(0.4); }
  20%  { opacity: 1; transform: translate(calc(var(--tx) * 0.5), calc(var(--ty) * 0.5)) scale(1.2); }
  100% { opacity: 0; transform: translate(var(--tx), var(--ty)) scale(0.6); }
}

@keyframes reward-coin-rain {
  0%   { opacity: 0; transform: translate(calc(-50% + var(--rx)), 0)        rotate(0deg); }
  10%  { opacity: 1; }
  85%  { opacity: 1; }
  100% { opacity: 0; transform: translate(calc(-50% + var(--rx)), 120vh)    rotate(720deg); }
}

/* Dramatic count-up: starts tiny, rushes up past full size with a bouncy
   overshoot, settles into a steady glow-pose for the rest of the card. */
@keyframes reward-alldone-total {
  0%   { opacity: 0; transform: scale(0.2); }
  20%  { opacity: 1; transform: scale(1.0); }
  45%  { opacity: 1; transform: scale(1.45); }
  62%  { opacity: 1; transform: scale(0.96); }
  78%  { opacity: 1; transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1.04); }
}
