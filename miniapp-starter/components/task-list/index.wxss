.task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 18rpx 18rpx 32rpx;
  background: #f8fafc;
  border-radius: 22rpx;
  /* 不加 transform 的 transition — 拖动 reorder 时 shiftY 切换必须瞬间生效,
     不然松手帧 row 会处于"过渡中跨 swipable 边界"的状态露出底层 swipe-action
     (Tim 反复报的"松手过程中出现编辑按钮 + 从下往上动画"就是这个)。box-shadow
     transition 仅给 is-dragging 时的阴影抬起用,留着。 */
  transition: box-shadow 0.16s ease;
}

.task-row.is-overdue {
  background: #fff1f0;
}

/* 补做项(makeup):occurrenceDate < 今天且在今天才完成,显示在今日"已完成"
   区域。黄底跟 is-overdue 红底区分开 —— 红色 = 这天没做完(出现在历史日期
   的未完成区),黄色 = 是补做的(出现在今日的已完成区)。
   selector 顺序:放在 .is-overdue 之后、.doing 之前 —— makeup row 永远是 done
   状态,不会跟 doing 撞,但理论上历史视图里同一 occurrence 不会既 overdue 又
   makeup(互斥)。 */
.task-row.is-makeup {
  background: #fff8e1;
}

/* Doing wins over overdue: when a row is mid-task it should look "active",
   not "overdue". Selector order matters — keep .doing after .is-overdue. */
.task-row.doing {
  background: #eaf2ff;
  box-shadow: inset 0 0 0 1rpx rgba(36, 91, 219, 0.18);
}

/* 左侧整条状态色带 — 高度等于卡片,宽度 ≈ 旧圆点直径。颜色由 row 的状态类决定;
   doing 时叠加脉动透明度动画。
   todo(默认):柔和蓝,跟 doing 的主题亮蓝 #245bdb 区分 —— 之前用大红 #e54545
   太扎眼,Tim 反馈后改。其它状态(doing / paused / done)不变。 */
.status-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 18rpx;
  border-radius: 22rpx 0 0 22rpx;
  background: #8aa4d4;
}

.task-row.doing  .status-stripe {
  background: #245bdb;
  animation: doing-pulse 1.6s ease-in-out infinite;
}
.task-row.paused .status-stripe { background: #ff8c1a; }
.task-row.done   .status-stripe { background: #07c160; }

/* 重复类型作业:状态条叠加斜条纹,与一次性作业区分。background-image 单独设,
   不覆盖各状态色的 background-color;rgba 半透明白条对四种底色都看得见。
   曾试过紫色条纹跟 chip 同色,Tim 反馈难看,改回白色。 */
.task-row.is-recurring .status-stripe {
  background-image: repeating-linear-gradient(
    -45deg,
    rgba(255, 255, 255, 0.55) 0 5rpx,
    transparent 5rpx 10rpx
  );
}

@keyframes doing-pulse {
  0%, 100% { opacity: 0.55; }
  50%      { opacity: 1; }
}

.task-row.is-dragging {
  transition: none;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(31, 35, 41, 0.18);
  transform: scale(1.02);
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.row-content {
  font-size: 28rpx;
  line-height: 1.4;
  color: #1f2329;
  font-weight: 500;
}

.row-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

/* 除了 subject 之外的 chip 都用统一的灰黑色,避免行内五彩斑斓。
   过期日期保留 font-weight 突出,但不再染红。 */
.chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.5;
  white-space: nowrap;
  background: #f0f2f5;
  color: #44505e;
}

.subject-chip { background: #eef4ff; color: #245bdb; font-weight: 600; }
.recurring-chip { background: #f1ebfa; color: #7c4dff; font-weight: 600; }
.overdue-chip { font-weight: 700; }

.row-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.icon-btn.start-btn { background: #245bdb; }
.icon-btn.resume-btn { background: #245bdb; }
.icon-btn.pause-btn { background: #f5a623; font-size: 20rpx; letter-spacing: 2rpx; }
.icon-btn.finish-btn { background: #07c160; font-size: 32rpx; }
.icon-btn.done-mark {
  background: #e8f7ee;
  color: #067647;
  box-shadow: none;
  font-size: 32rpx;
}

/* === Swipe-to-reveal on done rows === */
.task-row-swipable {
  position: relative;
  border-radius: 22rpx;
  overflow: hidden;
}

/* drag 模式:所有 swipable 容器解除 overflow:hidden,否则 task-row 被
   shiftY=±itemH translate 后超出自己的 swipable container 边界,会被
   overflow 整个 clip 掉(Tim 截图里 4 行全消失就是这个)。drag 结束后
   class 移除,回到 hidden 保 border-radius 的圆角 clip。 */
.task-list.is-dragging-mode .task-row-swipable {
  overflow: visible;
}

/* drag 中 swipe-action(右侧"编辑"按钮)应该藏起来:之前靠 overflow:hidden
   不显示,现在 visible 后会露出,视觉很乱。 */
.task-list.is-dragging-mode .swipe-action {
  visibility: hidden;
}

.task-row-swipable .swipe-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 120rpx;
  display: flex;
  align-items: stretch;
  /* 默认完全不绘 —— .task-row 自己有 22rpx border-radius,4 个圆角切掉的
     三角区不绘 bg,会漏底层 swipe-action 的颜色(尤其是 done row 右侧
     蓝色"继续"按钮)。静态下 .task-row-swipable overflow:hidden 限制到圆角
     内,三角刚好暴露蓝色一点点;快速滚屏时 .task-row 有 transform 走独立
     合成层,跟 scroll-view 主层有微妙合成时差,瞬时漏得更多。让 swipe-action
     默认 hidden,用户真要 swipe / 菜单展开时才显,根上断掉漏底问题。 */
  visibility: hidden;
}

.task-row-swipable.is-swiping .swipe-action,
.task-row-swipable.is-open .swipe-action {
  visibility: visible;
}

.task-row-swipable .swipe-action.swipe-action-double {
  width: 240rpx;
}

.swipe-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.revert-swipe-btn { background: #245bdb; }
.edit-swipe-btn { background: #44505e; }
.delete-swipe-btn { background: #e54545; }
/* 左滑菜单改用图标(不用文字):放大字号、白色继承自 .swipe-btn */
.swipe-ico { font-size: 48rpx; line-height: 1; }

.task-row-swipable .task-row {
  position: relative;
  z-index: 1;
  /* 不加 transition — 任何 shiftY/dragDy 变化都瞬间应用。之前各种"松手
     后从下往上动画 / 露按钮"都是因为 transition 在松手帧仍跑 0.18s,row
     处于"过渡中跨自己 swipable 边界"的状态,被 overflow:hidden 露出底层
     swipe-action。drag 中邻居推开也是瞬间到位,虽然没有平滑过渡但视觉上
     更确定 — 跟 Tim 反馈"动画多余"一致。 */
}

.task-row-swipable.is-swiping .task-row {
  transition: none;
}

/* 右滑顺延 transition:postpone 期间给 transform transition(松手飞出/回弹有动画);
   拖动中用 .is-postponing 覆盖成 none 跟手(同特异性,写后面胜出)。task-row 默认
   禁 transform transition(drag 推邻居会出 bug),所以只在 postpone row 上局部开。 */
.task-row-swipable.is-postpone-row .task-row {
  transition: transform 0.2s ease;
}
.task-row-swipable.is-postponing .task-row {
  transition: none;
}

/* 顺延色块:绝对定位垫在 row 底层铺满,卡片滑走后露出。背景色由 JS 按滑动进度
   红→琥珀→绿渐变(inline style 写 postponeColor),滑到 40% 满绿=松手生效;往回
   滑进度回落、颜色退回红。下面的 background 只是兜底(渲染时 inline 永远覆盖)。
   右滑露左侧(文字靠左)、左滑露右侧(文字靠右)。 */
.task-row-swipable .postpone-action {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 0 44rpx;
  border-radius: 22rpx;
  background: #cf1322;
  z-index: 0;
  transition: background 0.15s ease;
}
.task-row-swipable .postpone-action.postpone-right {
  justify-content: flex-start;
}
.task-row-swipable .postpone-action.postpone-left {
  justify-content: flex-end;
}
/* 拖动中禁背景过渡:颜色每帧跟手即时变;松手(去掉 .is-postponing)后基础 0.15s
   接管,平滑落到红(回弹)或绿(飞出)。 */
.task-row-swipable.is-postponing .postpone-action {
  transition: none;
}
.postpone-text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

/* === 「预计需要时间」可点 chip + 设置弹窗 === */
.est-chip-hover { opacity: 0.55; }
.est-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 9000;
  background: rgba(20, 16, 10, 0.45);
  display: flex; align-items: center; justify-content: center;
}
.est-sheet {
  width: 620rpx; box-sizing: border-box;
  background: #ffffff; border-radius: 28rpx;
  padding: 34rpx 28rpx 30rpx;
}
.est-title { font-size: 32rpx; font-weight: 800; color: #1f2329; text-align: center; }
/* 预设网格放进 scroll-view 并限高 → 横屏矮屏不会把下面的「确认」按钮顶出屏外
   (弹窗用 scroll-view + max-height 才稳,见踩坑记录) */
.est-grid-scroll { margin-top: 24rpx; max-height: 46vh; }
.est-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.est-opt {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box; height: 92rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: #f4f6fa; color: #1f2329; font-size: 34rpx; font-weight: 800;
}
.est-opt.on { background: #245bdb; color: #ffffff; }
.est-opt-hover { background: #e6ebf3; }
.est-unit { font-size: 22rpx; font-weight: 600; margin-left: 3rpx; opacity: 0.7; }
.est-custom { margin-top: 22rpx; display: flex; gap: 14rpx; }
.est-input {
  flex: 1; min-width: 0; height: 88rpx; padding: 0 24rpx;
  background: #f4f6fa; border-radius: 16rpx; font-size: 30rpx; color: #1f2329;
}
.est-confirm {
  flex-shrink: 0; padding: 0 40rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  background: #245bdb; color: #ffffff; font-size: 30rpx; font-weight: 700; border-radius: 16rpx;
}
.est-confirm-hover { background: #1e4fc0; }

/* === 紧凑模式(横屏 compact):row 压低,内容单行 + chip 行(字更小) === */
.task-list.compact { gap: 8rpx; }
.task-list.compact .task-row { padding: 8rpx 16rpx 8rpx 24rpx; gap: 12rpx; }
.task-list.compact .row-content {
  font-size: 26rpx; line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.task-list.compact .row-chips { margin-top: 4rpx; gap: 6rpx; }
.task-list.compact .chip { padding: 1rpx 10rpx; font-size: 16rpx; line-height: 1.4; }
