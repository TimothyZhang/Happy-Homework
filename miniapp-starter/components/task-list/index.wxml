<view class="task-list {{dragId ? 'is-dragging-mode' : ''}}">
  <block wx:for="{{list}}" wx:key="id">
    <view class="task-row-swipable {{swipeId === item.id ? 'is-swiping' : ''}}"
          data-id="{{item.id}}">

      <!-- Swipe-revealed action zone. Undone: 仅编辑(删除入口在编辑页内);Done: 编辑 + 继续。 -->
      <view wx:if="{{item.status !== 'done'}}" class="swipe-action">
        <view class="swipe-btn edit-swipe-btn"
              data-id="{{item.id}}"
              data-task-id="{{item.taskId || item.id}}"
              data-occurrence-date="{{item.occurrenceDate}}"
              data-task-mode="{{item.taskMode}}"
              catchtap="handleEdit">编辑</view>
      </view>
      <view wx:else class="swipe-action swipe-action-double">
        <view class="swipe-btn edit-swipe-btn"
              data-id="{{item.id}}"
              data-task-id="{{item.taskId || item.id}}"
              data-occurrence-date="{{item.occurrenceDate}}"
              data-task-mode="{{item.taskMode}}"
              catchtap="handleEdit">编辑</view>
        <view class="swipe-btn revert-swipe-btn"
              data-id="{{item.id}}"
              data-task-id="{{item.taskId || item.id}}"
              data-occurrence-date="{{item.occurrenceDate}}"
              catchtap="handleRevert">继续</view>
      </view>

      <view class="task-row {{item.status}} {{rowVariant}} {{item.isOverdue ? 'is-overdue' : ''}} {{item.isMakeup ? 'is-makeup' : ''}} {{dragId === item.id ? 'is-dragging' : ''}}"
            style="transform: translate3d({{swipeId === item.id ? swipeDx : (swipeOpenId === item.id ? -swipeOpenMax : 0)}}rpx, {{dragId === item.id ? dragDy + 'px' : (item.shiftY || 0) + 'px'}}, 0); z-index: {{dragId === item.id ? 10 : 'auto'}};"
            bindtap="handleRowTap"
            bindtouchstart="handleRowTouchStart"
            bindlongpress="handleRowLongPress"
            bindtouchmove="handleRowTouchMove"
            bindtouchend="handleRowTouchEnd"
            bindtouchcancel="handleRowTouchEnd"
            data-id="{{item.id}}"
            data-task-id="{{item.taskId || item.id}}"
            data-occurrence-date="{{item.occurrenceDate}}"
            data-status="{{item.status}}">
        <view class="status-stripe"></view>
        <view class="row-body">
          <view class="row-name-line">
            <text class="row-content">{{item.content}}</text>
            <text wx:if="{{item.subject}}" class="chip subject-chip">{{item.subject}}</text>
            <text wx:if="{{item.taskMode === 'recurring'}}" class="chip recurring-chip">{{item.recurrenceLabel}}</text>
          </view>
          <view class="row-chips">
            <text wx:if="{{item.organization}}" class="chip org-chip">{{item.organization}}</text>
            <text wx:if="{{item.isOverdue && item.occurrenceDate}}" class="chip overdue-chip">{{item.occurrenceDate}}</text>
            <text class="chip est-chip">预计 {{item.estimatedMinutes}} 分钟</text>
            <text wx:if="{{item.elapsedDisplay}}" class="chip elapsed-chip">{{item.status === 'done' ? '花费' : '已用'}} {{item.elapsedDisplay}}</text>
          </view>
        </view>
        <view wx:if="{{item.status !== 'done'}}" class="row-actions">
          <view wx:if="{{item.status === 'todo'}}" class="icon-btn start-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handleStart">▶</view>
          <view wx:if="{{item.status === 'doing'}}" class="icon-btn pause-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handlePause">❚❚</view>
          <view wx:if="{{item.status === 'paused'}}" class="icon-btn resume-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handleResume">↻</view>
          <view wx:if="{{item.status === 'doing'}}" class="icon-btn finish-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handleFinish">✓</view>
        </view>
        <view wx:else class="row-actions">
          <view class="icon-btn done-mark">✓</view>
        </view>
      </view>
    </view>
  </block>
</view>
