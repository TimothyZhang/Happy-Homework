<view class="task-list {{dragId ? 'is-dragging-mode' : ''}} {{compact ? 'compact' : ''}}">
  <block wx:for="{{list}}" wx:key="id">
    <view class="task-row-swipable {{swipeId === item.id ? 'is-swiping' : ''}} {{swipeOpenId === item.id ? 'is-open' : ''}} {{postponeId === item.id ? 'is-postpone-row' : ''}} {{postponeDragging && postponeId === item.id ? 'is-postponing' : ''}}"
          data-id="{{item.id}}">

      <!-- Swipe-revealed action zone. Undone: edit only (delete lives in edit page); Done: edit + resume. -->
      <view wx:if="{{item.status !== 'done'}}" class="swipe-action">
        <view class="swipe-btn edit-swipe-btn"
              data-id="{{item.id}}"
              data-task-id="{{item.taskId || item.id}}"
              data-occurrence-date="{{item.occurrenceDate}}"
              data-task-mode="{{item.taskMode}}"
              catchtap="handleEdit"><text class="swipe-ico">✎</text></view>
      </view>
      <view wx:else class="swipe-action swipe-action-double">
        <view class="swipe-btn edit-swipe-btn"
              data-id="{{item.id}}"
              data-task-id="{{item.taskId || item.id}}"
              data-occurrence-date="{{item.occurrenceDate}}"
              data-task-mode="{{item.taskMode}}"
              catchtap="handleEdit"><text class="swipe-ico">✎</text></view>
        <view class="swipe-btn revert-swipe-btn"
              data-id="{{item.id}}"
              data-task-id="{{item.taskId || item.id}}"
              data-occurrence-date="{{item.occurrenceDate}}"
              catchtap="handleRevert"><text class="swipe-ico">↺</text></view>
      </view>

      <!-- 顺延色块:垫在 row 底层,卡片滑动露出。右滑→下一天(文字靠左)、左滑→
           上一天(文字靠右)。红=未过半屏、绿=已过(松手即顺延)。 -->
      <view wx:if="{{postponeId === item.id}}" class="postpone-action {{postponeArmed ? 'is-armed' : ''}} {{postponeDx < 0 ? 'postpone-left' : 'postpone-right'}}" style="background: {{postponeColor}};">
        <text class="postpone-text">{{postponeDx < 0 ? t.tl_postpone_prev : t.tl_postpone_next}}</text>
      </view>

      <view class="task-row {{item.status}} {{rowVariant}} {{item.isOverdue ? 'is-overdue' : ''}} {{item.isMakeup ? 'is-makeup' : ''}} {{item.taskMode === 'recurring' ? 'is-recurring' : ''}} {{dragId === item.id ? 'is-dragging' : ''}}"
            style="transform: translate3d({{postponeId === item.id ? postponeDx : (swipeId === item.id ? swipeDx : (swipeOpenId === item.id ? -swipeOpenMax : 0))}}rpx, {{dragId === item.id ? dragDy + 'px' : (item.shiftY || 0) + 'px'}}, 0); z-index: {{dragId === item.id ? 10 : 'auto'}};"
            bindtap="handleRowTap"
            bindtouchstart="handleRowTouchStart"
            bindlongpress="handleRowLongPress"
            bindtouchmove="handleRowTouchMove"
            bindtouchend="handleRowTouchEnd"
            bindtouchcancel="handleRowTouchEnd"
            data-id="{{item.id}}"
            data-task-id="{{item.taskId || item.id}}"
            data-occurrence-date="{{item.occurrenceDate}}"
            data-status="{{item.status}}">
        <view class="status-stripe"></view>
        <view class="row-body">
          <view class="row-name-line">
            <text class="row-content">{{item.content}}</text>
            <text wx:if="{{item.subject}}" class="chip subject-chip">{{item.subject}}</text>
            <text wx:if="{{item.taskMode === 'recurring'}}" class="chip recurring-chip">{{item.recurrenceLabel}}</text>
          </view>
          <view class="row-chips">
            <text wx:if="{{item.organization}}" class="chip org-chip">{{item.organization}}</text>
            <text wx:if="{{item.isMakeup && item.occurrenceDate}}" class="chip overdue-chip">{{item.makeupLabel}}</text>
            <text wx:elif="{{item.isOverdue && item.status !== 'done' && item.occurrenceDate}}" class="chip overdue-chip">{{item.occurrenceDate}}</text>
            <text class="chip est-chip est-chip-tap" catchtap="openEstPopup"
                  data-task-id="{{item.taskId || item.id}}"
                  data-occurrence-date="{{item.occurrenceDate}}"
                  data-min="{{item.estimatedMinutes}}"
                  hover-class="est-chip-hover">{{item.estLabel}}</text>
            <text wx:if="{{item.elapsedDisplay}}" class="chip elapsed-chip elapsed-chip-tap"
                  catchtap="openTimelog"
                  data-task-id="{{item.taskId || item.id}}"
                  data-occurrence-date="{{item.occurrenceDate}}"
                  hover-class="est-chip-hover">{{item.elapsedLabel}}</text>
          </view>
        </view>
        <view wx:if="{{item.status !== 'done'}}" class="row-actions">
          <view wx:if="{{item.status === 'todo'}}" class="icon-btn start-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handleStart">▶</view>
          <view wx:if="{{item.status === 'doing'}}" class="icon-btn pause-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handlePause">❚❚</view>
          <view wx:if="{{item.status === 'paused'}}" class="icon-btn resume-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handleResume">↻</view>
          <view wx:if="{{item.status === 'doing'}}" class="icon-btn finish-btn" data-id="{{item.id}}" data-task-id="{{item.taskId || item.id}}" data-occurrence-date="{{item.occurrenceDate}}" catchtap="handleFinish">✓</view>
        </view>
        <view wx:else class="row-actions">
          <view class="icon-btn done-mark">✓</view>
        </view>
      </view>
    </view>
  </block>
</view>

<!-- Est duration popup: presets 5–60 + custom input -->
<view wx:if="{{showEstPopup}}" class="est-mask" catchtap="closeEstPopup" catchtouchmove="noop">
  <view class="est-sheet" catchtap="noop" catchtouchmove="noop">
    <view class="est-title">{{t.tl_est_title}}</view>
    <scroll-view scroll-y class="est-grid-scroll">
      <view class="est-grid">
        <view wx:for="{{estPresets}}" wx:key="*this"
              class="est-opt {{estCurrent === item ? 'on' : ''}}"
              data-min="{{item}}" catchtap="pickEst" hover-class="est-opt-hover">{{item}}<text class="est-unit">{{t.tl_est_unit}}</text></view>
      </view>
    </scroll-view>
    <view class="est-custom">
      <input class="est-input" type="number" placeholder="{{t.tl_est_placeholder}}" value="{{estInput}}"
             bindinput="onEstInput" bindconfirm="confirmEst" confirm-type="done" />
      <view class="est-confirm" catchtap="confirmEst" hover-class="est-confirm-hover">{{t.tl_est_confirm}}</view>
    </view>
  </view>
</view>

<!-- 时间记录(timelog):点 elapsed-chip「实际用时」弹出。进度条:绿=作业、红=休息;下面列出开始/暂停/继续/完成的时刻 -->
<view wx:if="{{showTimelog}}" class="tlog-mask" catchtap="closeTimelog" catchtouchmove="noop">
  <view class="tlog-panel" catchtap="noop" catchtouchmove="noop">
    <view class="tlog-title">{{t.tfocus_tl_title}}</view>
    <block wx:if="{{timelogHasBar}}">
      <view class="tlog-bar">
        <view wx:for="{{timelogSegs}}" wx:key="index" class="tlog-seg tlog-{{item.type}}" style="flex-grow: {{item.ms}}"></view>
      </view>
      <view class="tlog-legend">
        <view class="tlog-leg"><view class="tlog-dot tlog-work"></view><text>{{timelogWorkLabel}}</text></view>
        <view class="tlog-leg"><view class="tlog-dot tlog-break"></view><text>{{timelogBreakLabel}}</text></view>
      </view>
    </block>
    <scroll-view wx:if="{{timelogRows.length}}" scroll-y class="tlog-list" style="max-height: 40vh;">
      <view wx:for="{{timelogRows}}" wx:key="index" class="tlog-row tlog-row-{{item.t}}">
        <view class="tlog-rdot"></view>
        <text class="tlog-label">{{item.label}}</text>
        <text class="tlog-time">{{item.time}}</text>
      </view>
    </scroll-view>
    <view wx:else class="tlog-empty">{{t.tfocus_tl_empty}}</view>
    <view class="tlog-close" catchtap="closeTimelog">{{t.tfocus_tl_close}}</view>
  </view>
</view>
