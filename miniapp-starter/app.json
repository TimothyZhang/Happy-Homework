{
  "pages": [
    "pages/home/index",
    "pages/tasks/index",
    "pages/calendar/index",
    "pages/notebook-detail/index",
    "pages/ocr-import/index",
    "pages/ocr-result/index",
    "pages/pet/index",
    "pages/profile/index",
    "pages/stats/index"
  ],
  "subpackages": [
    {
      "root": "pkg-notebook",
      "pages": [
        "notebook-edit/index"
      ]
    }
