  "preloadRule": {
    "pages/tasks/index": {
      "network": "all",
      "packages": ["pkg-notebook"]
    },
    "pages/home/index": {
      "network": "all",
      "packages": ["pkg-notebook"]
    },
    "pages/calendar/index": {
      "network": "all",
      "packages": ["pkg-notebook"]
    },
    "pages/notebook-detail/index": {
      "network": "all",
      "packages": ["pkg-notebook"]
    }
  },
  "window": {
    "navigationBarTitleText": "作业小管家",
    "navigationBarBackgroundColor": "#eef4ff",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f7fb",
    "backgroundTextStyle": "light"
  },
  "networkTimeout": {
    "request": 60000,
    "connectSocket": 60000,
    "uploadFile": 60000,
    "downloadFile": 60000
  },
  "tabBar": {
    "custom": true,
    "color": "#7b8794",
    "selectedColor": "#245bdb",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/tasks/index",
        "text": "作业本"
      },
      {
        "pagePath": "pages/calendar/index",
        "text": "日历"
      },
      {
        "pagePath": "pages/pet/index",
        "text": "宠物"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json"
