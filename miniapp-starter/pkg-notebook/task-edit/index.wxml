<view class="page">
  <!-- 仅新增模式显示 tab(编辑/编辑此次模式不显示,因为已锚定具体 task) -->
  <view wx:if="{{!isEdit && !isInstanceDetach}}" class="tab-bar">
    <view class="tab-btn active">{{t.tedit_tab_manual}}</view>
    <view class="tab-btn" bindtap="handleSwitchToOcr">{{t.tedit_tab_ocr}}</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">{{t.tedit_label_content}}</text>
      <textarea class="input textarea"
                placeholder="{{t.tedit_ph_content}}"
                value="{{formContent}}"
                bindinput="handleContentInput"
                auto-height />
    </view>

    <view class="field">
      <text class="field-label">{{t.tedit_label_subject}}</text>
      <picker mode="selector"
              range="{{subjectOptions}}"
              value="{{formSubjectIndex}}"
              bindchange="handleSubjectChange">
        <view class="input picker-value">{{formSubject}}</view>
      </picker>
      <text wx:if="{{showInferHint}}" class="infer-hint">{{tedit_infer_hint_rendered}}</text>
    </view>

    <view class="field">
      <text class="field-label">{{t.tedit_label_org}}</text>
      <picker mode="selector"
              range="{{organizationOptions}}"
              value="{{formOrganizationIndex}}"
              bindchange="handleOrganizationChange">
        <view class="input picker-value">{{formOrganization}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">{{t.tedit_label_minutes}}</text>
      <input class="input"
             type="number"
             placeholder="{{t.tedit_ph_minutes}}"
             value="{{formMinutes}}"
             bindinput="handleMinutesInput" />
      <view wx:if="{{formEstHint}}" class="est-hint" bindtap="handleAcceptEstimate">{{formEstHint}}</view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">{{t.tedit_label_type}}</text>
      <view class="mode-group {{isInstanceDetach ? 'locked' : ''}}">
        <view wx:for="{{modeOptions}}" wx:key="key"
              class="mode-btn {{formMode === item.key ? 'active' : ''}} {{isInstanceDetach && formMode !== item.key ? 'disabled' : ''}}"
              data-key="{{item.key}}"
              bindtap="handleModeChange">{{item.label}}</view>
      </view>
      <text wx:if="{{isInstanceDetach}}" class="lock-hint">{{t.tedit_lock_hint}}</text>
    </view>

    <view class="field">
      <text class="field-label">{{formMode === 'recurring' ? t.tedit_label_start_date : t.tedit_label_date}}</text>
      <picker mode="date" value="{{formStartDate}}" bindchange="handleStartDateChange">
        <view class="input picker-value">{{formStartDate || t.tedit_ph_date}}</view>
      </picker>
    </view>

    <view wx:if="{{formMode === 'recurring'}}" class="field">
      <text class="field-label">{{t.tedit_label_end_date}}</text>
      <view class="due-row">
        <picker mode="date"
                value="{{formEndDate || formStartDate}}"
                start="{{formStartDate}}"
                bindchange="handleEndDateChange">
          <view class="input picker-value">{{formEndDate || t.tedit_ongoing}}</view>
        </picker>
        <view wx:if="{{formEndDate}}" class="due-clear" bindtap="handleClearEndDate">{{t.tedit_clear}}</view>
      </view>
    </view>

    <view wx:if="{{formMode === 'recurring'}}" class="field">
      <text class="field-label">{{t.tedit_label_recur_freq}}</text>
      <picker mode="selector"
              range="{{recurrenceTypeOptions}}"
              range-key="label"
              value="{{formRecurrenceTypeIndex}}"
              bindchange="handleRecurrenceTypeChange">
        <view class="input picker-value">{{recurrenceTypeOptions[formRecurrenceTypeIndex].label}}</view>
      </picker>
    </view>

    <view wx:if="{{formMode === 'recurring' && formRecurrenceType === 'weekly'}}" class="field">
      <text class="field-label">{{t.tedit_label_weekdays}}</text>
      <view class="weekday-group">
        <view wx:for="{{weekdayOptions}}" wx:key="day"
              class="weekday-btn {{formWeekdays.indexOf(item.day) >= 0 ? 'active' : ''}}"
              data-day="{{item.day}}"
              bindtap="handleToggleWeekday">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="primary-btn" bindtap="handleSave">{{isEdit ? t.tedit_btn_save_edit : t.tedit_btn_save_new}}</button>
    <button wx:if="{{isEdit}}" class="ghost-btn delete-btn" bindtap="handleDelete">{{t.tedit_btn_delete}}</button>
  </view>
</view>
