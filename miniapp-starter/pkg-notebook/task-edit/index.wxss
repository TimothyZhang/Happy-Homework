.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.tab-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 6rpx;
  background: #eef4ff;
  border-radius: 18rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #5f6b7a;
  font-weight: 500;
}

.tab-btn.active {
  background: #ffffff;
  color: #245bdb;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 219, 0.12);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
  margin-bottom: 16rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 22rpx;
}

.field-label {
  font-size: 26rpx;
  color: #6b7785;
}

.input,
.picker-value {
  padding: 22rpx;
  border-radius: 18rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  line-height: 1.4;
  color: #1f2329;
  min-height: 64rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 120rpx;
}

.infer-hint {
  align-self: flex-start;
  font-size: 22rpx;
  color: #245bdb;
  background: #eef4ff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

.est-hint {
  align-self: flex-start;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
  font-size: 22rpx;
  line-height: 1.5;
}

.due-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.due-row picker {
  flex: 1;
  min-width: 0;
}

.due-clear {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #e54545;
  font-size: 24rpx;
}

.mode-group,
.weekday-group {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.mode-btn,
.weekday-btn {
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  background: #f3f6fa;
  color: #5f6b7a;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}

.mode-btn.active,
.weekday-btn.active {
  background: #245bdb;
  color: #ffffff;
  font-weight: 600;
}

.mode-btn.disabled {
  opacity: 0.4;
}

.lock-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7785;
}

.weekday-btn {
  flex: 1;
  min-width: 60rpx;
}

.actions {
  margin-top: 28rpx;
}

.primary-btn {
  width: 100%;
  white-space: nowrap;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 219, 0.25);
}

.ghost-btn.delete-btn {
  width: 100%;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #e54545;
  font-size: 28rpx;
  border: none;
}

/* 时间记录:查看按钮(ghost)+ 浅色弹窗 */
.tl-view-btn {
  width: 100%; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 999rpx; margin-bottom: 14rpx;
  font-size: 28rpx; font-weight: 600; color: #245bdb; background: #eef4ff;
}
.tl-mask {
  position: fixed; inset: 0; z-index: 50;
  background: rgba(31, 35, 41, 0.45);
  display: flex; align-items: center; justify-content: center; padding: 60rpx;
}
.tl-panel {
  width: 100%; max-width: 600rpx;
  background: #ffffff; border-radius: 28rpx; padding: 30rpx 28rpx 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(31, 35, 41, 0.2);
}
.tl-title { font-size: 30rpx; font-weight: 800; color: #1f2329; text-align: center; margin-bottom: 16rpx; }
.tl-list { width: 100%; }
.tl-row { display: flex; align-items: center; padding: 14rpx 6rpx; border-top: 2rpx solid #f0f2f5; }
.tl-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; background: #b0b8c4; }
.tl-start .tl-dot { background: #07c160; }
.tl-pause .tl-dot { background: #f5a623; }
.tl-resume .tl-dot { background: #245bdb; }
.tl-done .tl-dot { background: #07c160; }
.tl-label { flex: 1; font-size: 26rpx; color: #44505e; }
.tl-time { font-size: 26rpx; color: #1f2329; font-weight: 700; }
.tl-empty { padding: 50rpx 0; text-align: center; color: #8a94a4; font-size: 26rpx; }
.tl-close {
  margin-top: 22rpx; height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 999rpx; font-size: 28rpx; font-weight: 700; color: #ffffff;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
}
