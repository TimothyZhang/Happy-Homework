<view class="page">
  <!-- 引用本:只读,顶部给同步按钮 + 原作者 + 被引用次数 -->
  <view wx:if="{{isRef}}" class="ref-banner">
    <view class="ref-l">
      <view class="ref-creator">
        <image wx:if="{{creatorAvatar}}" class="ref-avatar" src="{{creatorAvatar}}" mode="aspectFill" />
        <view wx:else class="ref-avatar ref-avatar-ph">👤</view>
        <text class="ref-creator-name">{{creatorName || '匿名'}}</text>
        <text class="ref-refcount">· 被引用 {{refCount}} 次</text>
      </view>
      <text class="ref-sub">🔗 引用自公开库 · 只读,点更新拉作者最新内容</text>
    </view>
    <view class="ref-update" bindtap="updateRef" hover-class="ref-update-hover">🔄 更新</view>
  </view>

  <!-- 录入:中文 + 英文(可短语) -->
  <view wx:if="{{!isRef}}" class="add-card">
    <view class="add-row">
      <input class="add-input cn" placeholder="中文(如:苹果)" maxlength="{{textMax}}" value="{{cnInput}}" bindinput="onCn" confirm-type="next" />
      <input class="add-input en" placeholder="英文(可短语)" maxlength="{{textMax}}" value="{{enInput}}" bindinput="onEn" confirm-type="done" bindconfirm="addWord" />
      <view class="add-btn" bindtap="addWord" hover-class="add-btn-hover">添加</view>
    </view>
  </view>

  <view wx:if="{{!isRef}}" class="tools">
    <view class="tool-btn" bindtap="ocrImport" hover-class="tool-hover">📷 拍照导入</view>
    <button class="tool-btn share" open-type="share" hover-class="tool-hover">🔗 分享给同学</button>
  </view>
  <view class="tools tools-2">
    <view wx:if="{{!isRef}}" class="tool-btn" bindtap="renameBook" hover-class="tool-hover">✏️ 改名</view>
    <view wx:if="{{isRef}}" class="tool-btn" bindtap="copyBook" hover-class="tool-hover">📋 复制为可编辑</view>
    <view class="tool-btn del" bindtap="deleteBook" hover-class="del-hover">🗑 删除单词本</view>
  </view>

  <view wx:if="{{!isRef}}" class="public-row">
    <view class="public-l">
      <text class="public-label">🌐 公开到单词库</text>
      <text class="public-sub">{{isPublic ? ('别人能搜到 · 已被引用 ' + refCount + ' 次') : '打开后别人可搜索并添加(只读,改不到你的)'}}</text>
    </view>
    <switch checked="{{isPublic}}" color="#245bdb" disabled="{{publicBusy}}" bindchange="togglePublic" />
  </view>

  <view class="count-line">共 {{words.length}} 个</view>

  <view wx:if="{{words.length === 0}}" class="empty">还没有单词,上面加一个吧~</view>

  <view wx:for="{{words}}" wx:key="id" class="word">
    <view class="word-main">
      <text class="word-cn">{{item.cn}}</text>
      <text class="word-en">{{item.en}}</text>
    </view>
    <view class="badge badge-{{item.state}}">
      <text wx:if="{{item.state === 'mastered'}}">✓ 掌握</text>
      <text wx:elif="{{item.state === 'learning'}}">{{item.everWrong ? '需加强' : '复习中'}}</text>
      <text wx:else>未学</text>
    </view>
    <view wx:if="{{!isRef}}" class="word-edit" catchtap="editWord" data-id="{{item.id}}" hover-class="edit-hover">改</view>
    <view wx:if="{{!isRef}}" class="word-del" catchtap="removeWord" data-id="{{item.id}}" hover-class="del-hover">删</view>
  </view>

  <!-- 修改单词 -->
  <view wx:if="{{editing}}" class="edit-mask" bindtap="cancelEdit" catchtouchmove="noop">
    <view class="edit-sheet" catchtap="noop" catchtouchmove="noop">
      <view class="edit-title">修改单词</view>
      <input class="edit-input" placeholder="中文" maxlength="{{textMax}}" value="{{editCn}}" bindinput="onEditCn" />
      <input class="edit-input" placeholder="英文(可短语)" maxlength="{{textMax}}" value="{{editEn}}" bindinput="onEditEn" />
      <view class="edit-actions">
        <view class="edit-cancel" catchtap="cancelEdit" hover-class="add-btn-hover">取消</view>
        <view class="edit-save" catchtap="saveEdit" hover-class="add-btn-hover">保存</view>
      </view>
    </view>
  </view>

  <!-- OCR 识别结果预览 -->
  <view wx:if="{{showOcr}}" class="ocr-mask" bindtap="cancelOcr" catchtouchmove="noop">
    <view class="ocr-sheet" catchtap="noop" catchtouchmove="noop">
      <view class="ocr-title">识别到 {{ocrPairs.length}} 个,确认导入?</view>
      <view class="ocr-sub">点 ✕ 去掉不要的</view>
      <scroll-view scroll-y class="ocr-list">
        <view wx:for="{{ocrPairs}}" wx:key="index" class="ocr-pair">
          <text class="ocr-cn">{{item.cn}}</text>
          <text class="ocr-en">{{item.en}}</text>
          <view class="ocr-pair-del" catchtap="removeOcrPair" data-i="{{index}}" hover-class="del-hover">✕</view>
        </view>
      </scroll-view>
      <view class="ocr-actions">
        <view class="ocr-cancel" catchtap="cancelOcr" hover-class="add-btn-hover">取消</view>
        <view class="ocr-import {{ocrPairs.length === 0 ? 'off' : ''}}" catchtap="importOcr" hover-class="add-btn-hover">导入这 {{ocrPairs.length}} 个</view>
      </view>
    </view>
  </view>
</view>
