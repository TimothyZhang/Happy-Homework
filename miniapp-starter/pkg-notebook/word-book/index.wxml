<view class="page">
  <!-- 引用本:只读,顶部给同步按钮 + 原作者 + 被引用次数 -->
  <view wx:if="{{isRef}}" class="ref-banner">
    <view class="ref-l">
      <view class="ref-creator">
        <image wx:if="{{creatorAvatar}}" class="ref-avatar" src="{{creatorAvatar}}" mode="aspectFill" />
        <view wx:else class="ref-avatar ref-avatar-ph">👤</view>
        <text class="ref-creator-name">{{creatorName || t.wbook_anon}}</text>
        <text class="ref-refcount">· {{refCountLabel}}</text>
      </view>
      <text class="ref-sub">{{t.wbook_ref_sub}}</text>
    </view>
    <view class="ref-update" bindtap="updateRef" hover-class="ref-update-hover">{{t.wbook_ref_update}}</view>
  </view>

  <!-- 录入:中文 + 英文(可短语) -->
  <view wx:if="{{!isRef}}" class="add-card">
    <view class="add-row">
      <input class="add-input cn" placeholder="{{t.wbook_cn_placeholder}}" maxlength="{{textMax}}" value="{{cnInput}}" bindinput="onCn" confirm-type="next" />
      <input class="add-input en" placeholder="{{t.wbook_en_placeholder}}" maxlength="{{textMax}}" value="{{enInput}}" bindinput="onEn" confirm-type="done" bindconfirm="addWord" />
      <view class="add-btn" bindtap="addWord" hover-class="add-btn-hover">{{t.wbook_add_btn}}</view>
    </view>
  </view>

  <view wx:if="{{!isRef}}" class="tools">
    <view class="tool-btn" bindtap="ocrImport" hover-class="tool-hover">{{t.wbook_ocr_btn}}</view>
    <button class="tool-btn share" open-type="share" hover-class="tool-hover">{{t.wbook_share_btn}}</button>
  </view>
  <view class="tools tools-2">
    <view wx:if="{{!isRef}}" class="tool-btn" bindtap="renameBook" hover-class="tool-hover">{{t.wbook_rename_btn}}</view>
    <view wx:if="{{isRef}}" class="tool-btn" bindtap="copyBook" hover-class="tool-hover">{{t.wbook_copy_btn}}</view>
    <view class="tool-btn del" bindtap="deleteBook" hover-class="del-hover">{{t.wbook_delete_btn}}</view>
  </view>

  <view wx:if="{{!isRef}}" class="public-row">
    <view class="public-l">
      <text class="public-label">{{t.wbook_public_label}}</text>
      <text class="public-sub">{{isPublic ? publicOnLabel : t.wbook_public_off}}</text>
    </view>
    <switch checked="{{isPublic}}" color="#245bdb" disabled="{{publicBusy}}" bindchange="togglePublic" />
  </view>

  <view class="count-line">{{countLabel}}</view>

  <view wx:if="{{words.length === 0}}" class="empty">{{t.wbook_empty}}</view>

  <view wx:for="{{words}}" wx:key="id" class="word">
    <view class="word-main">
      <text class="word-cn">{{item.cn}}</text>
      <text class="word-en">{{item.en}}</text>
    </view>
    <view class="badge badge-{{item.state}}">
      <text wx:if="{{item.state === 'mastered'}}">{{t.wbook_state_mastered}}</text>
      <text wx:elif="{{item.state === 'learning'}}">{{item.everWrong ? t.wbook_state_needs_work : t.wbook_state_learning}}</text>
      <text wx:else>{{t.wbook_state_new}}</text>
    </view>
    <view wx:if="{{!isRef}}" class="word-edit" catchtap="editWord" data-id="{{item.id}}" hover-class="edit-hover">{{t.wbook_word_edit}}</view>
    <view wx:if="{{!isRef}}" class="word-del" catchtap="removeWord" data-id="{{item.id}}" hover-class="del-hover">{{t.wbook_word_del}}</view>
  </view>

  <!-- 修改单词 -->
  <view wx:if="{{editing}}" class="edit-mask" bindtap="cancelEdit" catchtouchmove="noop">
    <view class="edit-sheet" catchtap="noop" catchtouchmove="noop">
      <view class="edit-title">{{t.wbook_edit_title}}</view>
      <input class="edit-input" placeholder="{{t.wbook_edit_cn_placeholder}}" maxlength="{{textMax}}" value="{{editCn}}" bindinput="onEditCn" />
      <input class="edit-input" placeholder="{{t.wbook_edit_en_placeholder}}" maxlength="{{textMax}}" value="{{editEn}}" bindinput="onEditEn" />
      <view class="edit-actions">
        <view class="edit-cancel" catchtap="cancelEdit" hover-class="add-btn-hover">{{t.wbook_edit_cancel}}</view>
        <view class="edit-save" catchtap="saveEdit" hover-class="add-btn-hover">{{t.wbook_edit_save}}</view>
      </view>
    </view>
  </view>

  <!-- OCR 识别结果预览 -->
  <view wx:if="{{showOcr}}" class="ocr-mask" bindtap="cancelOcr" catchtouchmove="noop">
    <view class="ocr-sheet" catchtap="noop" catchtouchmove="noop">
      <view class="ocr-title">{{ocrTitle}}</view>
      <view class="ocr-sub">{{t.wbook_ocr_sub}}</view>
      <scroll-view scroll-y class="ocr-list">
        <view wx:for="{{ocrPairs}}" wx:key="index" class="ocr-pair">
          <text class="ocr-cn">{{item.cn}}</text>
          <text class="ocr-en">{{item.en}}</text>
          <view class="ocr-pair-del" catchtap="removeOcrPair" data-i="{{index}}" hover-class="del-hover">✕</view>
        </view>
      </scroll-view>
      <view class="ocr-actions">
        <view class="ocr-cancel" catchtap="cancelOcr" hover-class="add-btn-hover">{{t.wbook_ocr_cancel}}</view>
        <view class="ocr-import {{ocrPairs.length === 0 ? 'off' : ''}}" catchtap="importOcr" hover-class="add-btn-hover">{{ocrImportLabel}}</view>
      </view>
    </view>
  </view>
</view>
