.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.add-card {
  background: #ffffff; border-radius: 24rpx; padding: 18rpx;
  box-shadow: 0 12rpx 36rpx rgba(31, 35, 41, 0.06);
}
.add-row { display: flex; align-items: center; }
.add-input {
  flex: 1; min-width: 0; height: 80rpx; padding: 0 20rpx;
  background: #f4f6fa; border-radius: 16rpx; font-size: 28rpx; color: #1f2329;
}
.add-input.en { margin-left: 12rpx; }
.add-btn {
  margin-left: 12rpx; flex-shrink: 0;
  height: 80rpx; padding: 0 26rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  background: #245bdb; color: #ffffff; font-size: 28rpx; font-weight: 700;
}
.add-btn-hover { background: #1e4fc0; }

.ocr-btn {
  margin-top: 14rpx; height: 88rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: #ffffff; color: #245bdb; font-size: 28rpx; font-weight: 700;
  box-shadow: inset 0 0 0 2rpx #cdd9f5;
}
.ocr-btn-hover { background: #f2f6ff; }

.count-line { margin: 24rpx 8rpx 12rpx; font-size: 24rpx; color: #8a94a0; }

/* OCR 识别结果预览 */
.ocr-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200;
  background: rgba(0, 0, 0, 0.4);
  display: flex; align-items: flex-end;
}
.ocr-sheet {
  width: 100%; box-sizing: border-box;
  background: #ffffff; border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  max-height: 80vh; display: flex; flex-direction: column;
}
.ocr-title { font-size: 32rpx; font-weight: 800; color: #1f2329; text-align: center; }
.ocr-sub { margin-top: 6rpx; font-size: 23rpx; color: #9aa3ad; text-align: center; }
.ocr-list { margin: 18rpx 0; max-height: 52vh; }
.ocr-pair {
  display: flex; align-items: center;
  padding: 18rpx 16rpx; border-radius: 16rpx; background: #f7f9fc; margin-bottom: 10rpx;
}
.ocr-cn { width: 200rpx; flex-shrink: 0; font-size: 28rpx; font-weight: 700; color: #1f2329; }
.ocr-en { flex: 1; min-width: 0; font-size: 27rpx; color: #6b7785; }
.ocr-pair-del {
  width: 52rpx; height: 52rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: #fdecec; color: #e15c5c; font-size: 26rpx;
}
.ocr-actions { display: flex; margin-top: 8rpx; }
.ocr-cancel {
  flex: 1; height: 92rpx; border-radius: 18rpx; margin-right: 12rpx;
  display: flex; align-items: center; justify-content: center;
  background: #f1f3f6; color: #5a6470; font-size: 30rpx; font-weight: 700;
}
.ocr-import {
  flex: 2; height: 92rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: #245bdb; color: #ffffff; font-size: 30rpx; font-weight: 700;
}
.ocr-import.off { background: #b9c4dd; }
.empty { margin-top: 80rpx; text-align: center; font-size: 28rpx; color: #aab3bd; }

.word {
  display: flex; align-items: center;
  background: #ffffff; border-radius: 20rpx; padding: 20rpx;
  margin-bottom: 12rpx; box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}
.word-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.word-cn { font-size: 30rpx; font-weight: 700; color: #1f2329; }
.word-en { margin-top: 4rpx; font-size: 26rpx; color: #6b7785; }
.badge {
  flex-shrink: 0; margin: 0 12rpx; padding: 6rpx 16rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 600;
}
.badge-mastered { background: #e3f6ea; color: #07a050; }
.badge-learning { background: #eaf2ff; color: #245bdb; }
.badge-new { background: #f1f3f6; color: #8a94a0; }
.word-del {
  flex-shrink: 0; width: 56rpx; height: 56rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  background: #fdecec; color: #e15c5c; font-size: 26rpx; font-weight: 700;
}
.del-hover { background: #f9d9d9; }
