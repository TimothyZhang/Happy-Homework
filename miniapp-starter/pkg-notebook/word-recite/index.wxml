<view class="page" style="padding-top: {{statusBarH}}px;">
  <view class="topbar">
    <view class="exit-btn" bindtap="exit" hover-class="exit-hover">{{t.wrec_back}}</view>
    <text wx:if="{{!done && !blocked}}" class="progress">{{index + 1}} / {{total}}</text>
    <view wx:if="{{!done && !blocked}}" class="skip-btn" bindtap="skip" hover-class="exit-hover">{{t.wrec_skip}}</view>
    <view wx:else class="topbar-spacer"></view>
  </view>

  <!-- 今天背完 3 次 / 没有要背的词 -->
  <view wx:if="{{blocked}}" class="centered">
    <image class="pet" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
    <view class="blocked-text">{{blockedReason}}</view>
    <view class="done-btn ghost" bindtap="exit" hover-class="done-btn-hover">{{goFindPetLabel}}</view>
  </view>

  <block wx:elif="{{!done}}">
    <!-- recite:宠物说中文;dictation:听语音拼写 -->
    <view class="stage">
      <image class="pet {{feedback}}" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
      <!-- 答对瞬间从宠物旁边往上飘的奖励 -->
      <view wx:if="{{rewardFly}}" class="reward-fly">
        <view class="rf-chip rf-xp">{{t.wrec_xp_fly}}</view>
        <view class="rf-chip rf-kn">{{t.wrec_kn_fly}}</view>
      </view>

      <block wx:if="{{mode === 'dictation'}}">
        <view class="dict-play" bindtap="replay" hover-class="dict-play-hover">🔊</view>
        <text class="hint">{{t.wrec_dictation_hint}}</text>
        <!-- 听写不显示中文(显示了就等于给答案);只听发音拼写 -->
        <!-- 没语音兜底才亮英文;有语音时新词只提示"仔细听",不剧透原文 -->
        <view wx:if="{{!ttsOn}}" class="newword">{{t.wrec_tts_off}}<text class="newword-en">{{word.en}}</text></view>
        <view wx:elif="{{word.isNew}}" class="newword">{{t.wrec_dictation_newword}}</view>
      </block>

      <block wx:else>
        <view class="say-bubble">{{word.cn}}</view>
        <text wx:if="{{!word.isNew}}" class="hint">{{t.wrec_recite_hint}}</text>
        <view wx:else class="newword">{{t.wrec_recite_newword}}</view>
      </block>
    </view>

    <view class="answer">
      <view class="ans-line">
        <text class="ans {{feedback}}" space="nbsp">{{input}}</text>
        <view wx:if="{{!feedback}}" class="caret"></view>
      </view>
      <text wx:if="{{!input && !feedback}}" class="ans-ph">{{t.wrec_input_placeholder}}</text>
      <view wx:if="{{feedback === 'wrong'}}" class="correct">{{t.wrec_correct_answer}}{{word.en}}</view>
      <view wx:if="{{feedback === 'wrong'}}" class="next-btn" bindtap="goNext" hover-class="next-btn-hover">{{t.wrec_next}}</view>
      <view wx:if="{{feedback === 'right'}}" class="bravo">{{t.wrec_bravo}}</view>
    </view>

    <!-- 听写:重听按钮放在键盘右上角,拼写时大拇指顺手就能点 -->
    <view wx:if="{{mode === 'dictation'}}" class="kb-replay-row">
      <view class="kb-replay" bindtap="replay" hover-class="kb-replay-hover">{{t.wrec_replay}}</view>
    </view>

    <!-- 自制键盘(不用系统输入法),布局对齐 iPhone 默认英文键盘 -->
    <view class="keyboard {{shiftActive ? 'caps' : ''}}">
      <block wx:if="{{kbMode === 'abc'}}">
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsAbc[0]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsAbc[1]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key kb-fnk kb-shift {{shiftActive ? 'on' : ''}}" bindtap="kbShift" hover-class="kb-fnk-hover">⇧</view>
          <view class="kb-key" wx:for="{{rowsAbc[2]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
          <view class="kb-key kb-fnk kb-del" bindtap="kbDelete" hover-class="kb-fnk-hover">⌫</view>
        </view>
      </block>
      <block wx:else>
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsNum[0]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsNum[1]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key kb-sym" wx:for="{{rowsNum[2]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
          <view class="kb-key kb-fnk kb-del" bindtap="kbDelete" hover-class="kb-fnk-hover">⌫</view>
        </view>
      </block>
      <view class="kb-row kb-row-bottom">
        <view class="kb-key kb-fnk kb-mode" bindtap="kbToggleMode" hover-class="kb-fnk-hover">{{kbMode === 'abc' ? '123' : 'ABC'}}</view>
        <view class="kb-key kb-space" bindtap="kbSpace" hover-class="kb-key-hover" hover-stay-time="40">{{t.wrec_space}}</view>
        <view class="kb-key kb-submit" bindtap="kbSubmit" hover-class="kb-submit-hover" hover-stay-time="40">{{t.wrec_submit}}</view>
      </view>
    </view>
  </block>

  <!-- 背完结算 -->
  <view wx:else class="centered done">
    <image class="pet bravo-pet" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
    <view class="done-title">{{t.wrec_done_title}}</view>
    <view class="reward-tally">
      <view class="rt-item rt-xp">
        <text class="rt-num">+{{xpGained}}</text>
        <text class="rt-label">{{t.wrec_xp_label}}</text>
      </view>
      <view class="rt-item rt-kn">
        <text class="rt-num">+{{knowledgeGained}}</text>
        <text class="rt-label">{{t.wrec_kn_label}}</text>
      </view>
    </view>
    <view class="done-sub">{{doneSub}}</view>
    <view class="done-btns">
      <view wx:if="{{canMore}}" class="done-btn" bindtap="restart" hover-class="done-btn-hover">{{t.wrec_restart}}</view>
      <view class="done-btn ghost" bindtap="exit" hover-class="done-btn-hover">{{goFindPetLabel}}</view>
    </view>
    <view wx:if="{{!canMore}}" class="done-note">{{t.wrec_done_note}}</view>
  </view>
</view>
