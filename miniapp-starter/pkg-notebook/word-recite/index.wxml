<view class="page" style="padding-top: {{statusBarH}}px;">
  <view class="topbar">
    <view class="exit-btn" bindtap="exit" hover-class="exit-hover">‹ 返回</view>
    <text wx:if="{{!done && !blocked}}" class="progress">{{index + 1}} / {{total}}</text>
    <view wx:if="{{!done && !blocked}}" class="skip-btn" bindtap="skip" hover-class="exit-hover">跳过 ›</view>
    <view wx:else class="topbar-spacer"></view>
  </view>

  <!-- 今天背完 3 次 / 没有要背的词 -->
  <view wx:if="{{blocked}}" class="centered">
    <image class="pet" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
    <view class="blocked-text">{{blockedReason}}</view>
    <view class="done-btn ghost" bindtap="exit" hover-class="done-btn-hover">回去找 {{petName}}</view>
  </view>

  <block wx:elif="{{!done}}">
    <!-- 宠物在上方"说"中文;新词亮出英文跟着拼 -->
    <view class="stage">
      <image class="pet {{feedback}}" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
      <view class="say-bubble">{{word.cn}}</view>
      <text wx:if="{{!word.isNew}}" class="hint">用英语怎么说?</text>
      <view wx:else class="newword">📖 新词 · 跟着拼:<text class="newword-en">{{word.en}}</text></view>
    </view>

    <view class="answer">
      <text wx:if="{{input}}" class="ans {{feedback}}">{{input}}</text>
      <text wx:else class="ans-ph">下面拼出英文…</text>
      <view wx:if="{{feedback === 'wrong'}}" class="correct">正确答案:{{word.en}}</view>
      <view wx:if="{{feedback === 'right'}}" class="bravo">答对啦!📚 +1</view>
    </view>

    <!-- 自制键盘(不用系统输入法),布局对齐 iPhone 默认英文键盘 -->
    <view class="keyboard {{shiftActive ? 'caps' : ''}}">
      <block wx:if="{{kbMode === 'abc'}}">
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsAbc[0]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsAbc[1]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key kb-fnk kb-shift {{shiftActive ? 'on' : ''}}" bindtap="kbShift" hover-class="kb-fnk-hover">⇧</view>
          <view class="kb-key" wx:for="{{rowsAbc[2]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
          <view class="kb-key kb-fnk kb-del" bindtap="kbDelete" hover-class="kb-fnk-hover">⌫</view>
        </view>
      </block>
      <block wx:else>
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsNum[0]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key" wx:for="{{rowsNum[1]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
        </view>
        <view class="kb-row">
          <view class="kb-key kb-sym" wx:for="{{rowsNum[2]}}" wx:for-item="k" wx:key="*this"
                data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="40">{{k}}</view>
          <view class="kb-key kb-fnk kb-del" bindtap="kbDelete" hover-class="kb-fnk-hover">⌫</view>
        </view>
      </block>
      <view class="kb-row kb-row-bottom">
        <view class="kb-key kb-fnk kb-mode" bindtap="kbToggleMode" hover-class="kb-fnk-hover">{{kbMode === 'abc' ? '123' : 'ABC'}}</view>
        <view class="kb-key kb-space" bindtap="kbSpace" hover-class="kb-key-hover" hover-stay-time="40">空格</view>
        <view class="kb-key kb-submit" bindtap="kbSubmit" hover-class="kb-submit-hover" hover-stay-time="40">确定</view>
      </view>
    </view>
  </block>

  <!-- 背完结算 -->
  <view wx:else class="centered done">
    <image class="pet bravo-pet" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
    <view class="done-title">背完啦!📚 +{{knowledgeGained}} 知识</view>
    <view class="done-sub">一次答对 {{correctCount}} / {{total}} 个 · {{petName}} 现在共 {{knowledge}} 知识</view>
    <view class="done-btns">
      <view wx:if="{{canMore}}" class="done-btn" bindtap="restart" hover-class="done-btn-hover">再来一组</view>
      <view class="done-btn ghost" bindtap="exit" hover-class="done-btn-hover">回去找 {{petName}}</view>
    </view>
    <view wx:if="{{!canMore}}" class="done-note">今天 3 次都背完啦,明天再来~</view>
  </view>
</view>
