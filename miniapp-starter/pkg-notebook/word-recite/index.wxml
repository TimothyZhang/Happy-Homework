<view class="page" style="padding-top: {{statusBarH}}px;">
  <view class="topbar">
    <view class="exit-btn" bindtap="exit" hover-class="exit-hover">‹ 返回</view>
    <text wx:if="{{!done}}" class="progress">{{index + 1}} / {{total}}</text>
    <view wx:if="{{!done}}" class="skip-btn" bindtap="skip" hover-class="exit-hover">跳过 ›</view>
    <view wx:else class="topbar-spacer"></view>
  </view>

  <block wx:if="{{!done}}">
    <!-- 宠物在上方,"说"中文 -->
    <view class="stage">
      <image class="pet {{feedback}}" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
      <view class="say-bubble">{{word.cn}}</view>
      <text class="hint">用英语怎么说?</text>
    </view>

    <!-- 答案显示区 -->
    <view class="answer">
      <text wx:if="{{input}}" class="ans {{feedback}}">{{input}}</text>
      <text wx:else class="ans-ph">下面拼出英文…</text>
      <view wx:if="{{feedback === 'wrong'}}" class="correct">正确答案:{{word.en}}</view>
      <view wx:if="{{feedback === 'right'}}" class="bravo">答对啦!🎉</view>
    </view>

    <!-- 自制大键盘(不用系统输入法) -->
    <view class="keyboard">
      <view class="kb-row" wx:for="{{kbRows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
        <view class="kb-key" wx:for="{{row}}" wx:for-item="k" wx:key="*this"
              data-k="{{k}}" bindtap="kbInput" hover-class="kb-key-hover" hover-stay-time="60">{{k}}</view>
      </view>
      <view class="kb-row kb-fn">
        <view class="kb-key kb-del" bindtap="kbDelete" hover-class="kb-key-hover" hover-stay-time="60">⌫ 删除</view>
        <view class="kb-key kb-space" bindtap="kbSpace" hover-class="kb-key-hover" hover-stay-time="60">空格</view>
        <view class="kb-key kb-submit" bindtap="kbSubmit" hover-class="kb-submit-hover" hover-stay-time="60">确定</view>
      </view>
    </view>
  </block>

  <!-- 全部背完 -->
  <view wx:else class="done">
    <image class="pet bravo-pet" src="/assets/pets/{{species}}.svg" mode="aspectFit" />
    <view class="done-title">全部背完啦!🎉</view>
    <view class="done-sub">答对 {{correctCount}} / {{total}} 个,{{petName}} 给你点赞~</view>
    <view class="done-btns">
      <view class="done-btn" bindtap="restart" hover-class="done-btn-hover">再来一组</view>
      <view class="done-btn ghost" bindtap="exit" hover-class="done-btn-hover">回去找 {{petName}}</view>
    </view>
  </view>
</view>
