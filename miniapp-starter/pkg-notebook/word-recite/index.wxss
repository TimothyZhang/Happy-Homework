.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fdf3e3 0%, #f8e3c8 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: 0;   /* 键盘自带底部安全区,直接贴到屏幕底 */
}

/* 顶栏:返回 + 进度 */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  height: 84rpx; padding: 0 24rpx;
}
.exit-btn {
  font-size: 28rpx; color: #8a6a45; font-weight: 700;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 2rpx 8rpx rgba(150, 110, 60, 0.14);
}
.skip-btn {
  font-size: 28rpx; color: #8a6a45; font-weight: 700;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 2rpx 8rpx rgba(150, 110, 60, 0.14);
}
.exit-hover { opacity: 0.5; }
.topbar-spacer { width: 110rpx; }
.progress { font-size: 30rpx; color: #b08a5f; font-weight: 800; }

/* 宠物 + 说的中文 */
.stage { display: flex; flex-direction: column; align-items: center; padding: 4rpx 0 2rpx; }
.pet { width: 210rpx; height: 210rpx; }
.pet.right { animation: rec-pop 0.7s ease-out; }
.pet.wrong { animation: rec-shake 0.42s ease-in-out 2; }
.bravo-pet { width: 240rpx; height: 240rpx; animation: rec-pop 0.8s ease-out; }
.say-bubble {
  position: relative;
  margin-top: 6rpx;
  font-size: 68rpx; font-weight: 800; color: #5a3d1e; letter-spacing: 4rpx;
  background: #ffffff; border-radius: 28rpx; padding: 12rpx 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(150, 110, 60, 0.18);
}
.say-bubble::after {
  content: ''; position: absolute; left: 50%; top: -16rpx; margin-left: -10rpx;
  border-left: 10rpx solid transparent; border-right: 10rpx solid transparent;
  border-bottom: 16rpx solid #ffffff;
}
.hint { margin-top: 18rpx; font-size: 28rpx; color: #a07a4f; }

/* 听写模式 */
.dict-play {
  margin-top: 6rpx; width: 144rpx; height: 144rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #245bdb; color: #ffffff; font-size: 68rpx;
  box-shadow: 0 10rpx 26rpx rgba(36, 91, 219, 0.32);
}
.dict-play-hover { background: #1e4fc0; }
.dict-cn { margin-top: 16rpx; font-size: 34rpx; font-weight: 700; color: #8a6a45; }
.replay-btn {
  margin-top: 16rpx; padding: 12rpx 38rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9); color: #245bdb; font-size: 28rpx; font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(150, 110, 60, 0.14);
}

/* 答案显示 */
.answer {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 150rpx;
}
.ans { font-size: 76rpx; letter-spacing: 8rpx; font-weight: 800; color: #1f2329; }
.ans.right { color: #07a050; }
.ans.wrong { color: #e15c5c; }
.ans-ph { font-size: 30rpx; color: #c7ad8c; }
.correct { margin-top: 16rpx; font-size: 38rpx; color: #e15c5c; font-weight: 800; }
.bravo { margin-top: 16rpx; font-size: 38rpx; color: #07a050; font-weight: 800; }

/* 自制键盘 —— 布局对齐 iPhone:字母键等宽,第二行缩进,shift / delete 在第三行
   两端,底排 123 / 空格 / 确定。底色浅灰(同 iOS),字母键白、功能键深灰。 */
.keyboard {
  background: #d7dae1;
  padding: 16rpx 6rpx calc(12rpx + env(safe-area-inset-bottom));
}
.kb-row { display: flex; justify-content: center; align-items: center; margin-bottom: 14rpx; }
.kb-row:last-child { margin-bottom: 0; }
.kb-key {
  width: 62rpx; height: 92rpx; margin: 0 5rpx;
  display: flex; align-items: center; justify-content: center;
  background: #ffffff; border-radius: 10rpx;
  font-size: 40rpx; font-weight: 400; color: #1f2329;
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.28);
}
.keyboard.caps .kb-key { text-transform: uppercase; }
.kb-key-hover { background: #b9c0cc; }
.kb-sym { width: 62rpx; }
/* 功能键(深灰):shift / delete / 123 */
.kb-fnk { width: 96rpx; background: #a9afbb; color: #1f2329; font-size: 36rpx; font-weight: 500; }
.kb-fnk-hover { background: #8f97a5; }
.kb-shift.on { background: #ffffff; color: #245bdb; }
.kb-mode { font-size: 28rpx; }
.kb-row-bottom { margin-top: 2rpx; }
.kb-space {
  flex: 1; width: auto; margin: 0 8rpx;
  font-size: 28rpx; color: #6a6a6e; letter-spacing: 6rpx; font-weight: 500;
}
.kb-submit {
  width: 168rpx; background: #245bdb; color: #ffffff;
  font-size: 32rpx; font-weight: 700; box-shadow: 0 2rpx 0 #1546b5;
}
.kb-submit-hover { background: #1e4fc0; }

/* 完成页 */
.done { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.done-title { margin-top: 22rpx; font-size: 46rpx; font-weight: 800; color: #5a3d1e; }
.done-sub { margin-top: 12rpx; font-size: 28rpx; color: #a07a4f; }
.done-btns { display: flex; margin-top: 46rpx; }
.done-btn {
  margin: 0 14rpx; padding: 22rpx 44rpx; border-radius: 999rpx;
  background: #245bdb; color: #ffffff; font-size: 30rpx; font-weight: 800;
}
.done-btn.ghost { background: #ffffff; color: #5a3d1e; box-shadow: inset 0 0 0 2rpx #e6d6bd; }
.done-btn-hover { opacity: 0.85; }

/* 居中容器(blocked / done 复用) */
.centered { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 48rpx; }
.blocked-text { margin: 24rpx 0 40rpx; font-size: 32rpx; color: #5a3d1e; font-weight: 600; text-align: center; line-height: 1.6; }
.done-note { margin-top: 26rpx; font-size: 26rpx; color: #a07a4f; }
/* 新词提示:亮出英文跟着拼 */
.newword { margin-top: 18rpx; font-size: 28rpx; color: #b06a3a; font-weight: 600; }
.newword-en { font-size: 36rpx; color: #245bdb; font-weight: 800; letter-spacing: 2rpx; }

@keyframes rec-pop {
  0%   { transform: scale(1)    translateY(0); }
  25%  { transform: scale(1.14) translateY(-16rpx); }
  50%  { transform: scale(0.97) translateY(0); }
  100% { transform: scale(1)    translateY(0); }
}
@keyframes rec-shake {
  0%, 100% { transform: translateX(0); }
  25%      { transform: translateX(-10rpx); }
  75%      { transform: translateX(10rpx); }
}
