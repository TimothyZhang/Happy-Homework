.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fdf3e3 0%, #f8e3c8 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

/* 顶栏:返回 + 进度 */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  height: 84rpx; padding: 0 24rpx;
}
.exit-btn { font-size: 32rpx; color: #8a6a45; font-weight: 700; padding: 8rpx 6rpx; }
.skip-btn { font-size: 30rpx; color: #8a6a45; font-weight: 700; padding: 8rpx 6rpx; }
.exit-hover { opacity: 0.5; }
.topbar-spacer { width: 110rpx; }
.progress { font-size: 30rpx; color: #b08a5f; font-weight: 800; }

/* 宠物 + 说的中文 */
.stage { display: flex; flex-direction: column; align-items: center; padding: 4rpx 0 2rpx; }
.pet { width: 210rpx; height: 210rpx; }
.pet.right { animation: rec-pop 0.7s ease-out; }
.pet.wrong { animation: rec-shake 0.42s ease-in-out 2; }
.bravo-pet { width: 240rpx; height: 240rpx; animation: rec-pop 0.8s ease-out; }
.say-bubble {
  position: relative;
  margin-top: 6rpx;
  font-size: 68rpx; font-weight: 800; color: #5a3d1e; letter-spacing: 4rpx;
  background: #ffffff; border-radius: 28rpx; padding: 12rpx 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(150, 110, 60, 0.18);
}
.say-bubble::after {
  content: ''; position: absolute; left: 50%; top: -16rpx; margin-left: -10rpx;
  border-left: 10rpx solid transparent; border-right: 10rpx solid transparent;
  border-bottom: 16rpx solid #ffffff;
}
.hint { margin-top: 18rpx; font-size: 28rpx; color: #a07a4f; }

/* 答案显示 */
.answer {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 150rpx;
}
.ans { font-size: 76rpx; letter-spacing: 8rpx; font-weight: 800; color: #1f2329; }
.ans.right { color: #07a050; }
.ans.wrong { color: #e15c5c; }
.ans-ph { font-size: 30rpx; color: #c7ad8c; }
.correct { margin-top: 16rpx; font-size: 38rpx; color: #e15c5c; font-weight: 800; }
.bravo { margin-top: 16rpx; font-size: 38rpx; color: #07a050; font-weight: 800; }

/* 自制大键盘 */
.keyboard { padding: 8rpx 8rpx 0; }
.kb-row { display: flex; justify-content: center; margin-bottom: 14rpx; }
.kb-key {
  flex: 1; margin: 0 6rpx; height: 104rpx;
  display: flex; align-items: center; justify-content: center;
  background: #ffffff; border-radius: 16rpx;
  font-size: 44rpx; font-weight: 700; color: #2a2a2e; text-transform: uppercase;
  box-shadow: 0 6rpx 0 rgba(150, 110, 60, 0.20);
}
.kb-key-hover {
  background: #f0e3cf; transform: translateY(3rpx);
  box-shadow: 0 3rpx 0 rgba(150, 110, 60, 0.20);
}
.kb-fn { margin-top: 4rpx; }
.kb-fn .kb-key { font-size: 30rpx; font-weight: 700; }
.kb-del { flex: 1.5; color: #b06a3a; }
.kb-space { flex: 3.4; color: #6a6a6e; letter-spacing: 6rpx; }
.kb-submit {
  flex: 2.2; background: #245bdb; color: #ffffff; font-size: 34rpx;
  box-shadow: 0 6rpx 0 #1546b5;
}
.kb-submit-hover {
  background: #1e4fc0; transform: translateY(3rpx); box-shadow: 0 3rpx 0 #1546b5;
}

/* 完成页 */
.done { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.done-title { margin-top: 22rpx; font-size: 46rpx; font-weight: 800; color: #5a3d1e; }
.done-sub { margin-top: 12rpx; font-size: 28rpx; color: #a07a4f; }
.done-btns { display: flex; margin-top: 46rpx; }
.done-btn {
  margin: 0 14rpx; padding: 22rpx 44rpx; border-radius: 999rpx;
  background: #245bdb; color: #ffffff; font-size: 30rpx; font-weight: 800;
}
.done-btn.ghost { background: #ffffff; color: #5a3d1e; box-shadow: inset 0 0 0 2rpx #e6d6bd; }
.done-btn-hover { opacity: 0.85; }

@keyframes rec-pop {
  0%   { transform: scale(1)    translateY(0); }
  25%  { transform: scale(1.14) translateY(-16rpx); }
  50%  { transform: scale(0.97) translateY(0); }
  100% { transform: scale(1)    translateY(0); }
}
@keyframes rec-shake {
  0%, 100% { transform: translateX(0); }
  25%      { transform: translateX(-10rpx); }
  75%      { transform: translateX(10rpx); }
}
