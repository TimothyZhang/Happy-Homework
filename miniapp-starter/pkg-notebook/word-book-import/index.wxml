<view class="page">
  <block wx:if="{{ok}}">
    <view class="hero">
      <text class="hero-emoji">📚</text>
      <view class="hero-title">{{t.wbimport_hero_title}}</view>
      <view class="hero-name">{{heroCount}}</view>
    </view>

    <scroll-view scroll-y class="preview">
      <view wx:for="{{pairs}}" wx:key="index" class="pv-row">
        <text class="pv-cn">{{item.cn}}</text>
        <text class="pv-en">{{item.en}}</text>
      </view>
      <view wx:if="{{count > pairs.length}}" class="pv-more">{{moreText}}</view>
    </scroll-view>

    <view class="actions">
      <view class="btn primary {{imported ? 'off' : ''}}" bindtap="doImport" hover-class="btn-hover">{{t.wbimport_import_btn}}</view>
      <view class="btn ghost" bindtap="goPet" hover-class="btn-hover">{{t.wbimport_pet_btn}}</view>
    </view>
  </block>

  <view wx:else class="bad">
    <text class="hero-emoji">😶</text>
    <view class="hero-title">{{t.wbimport_bad_title}}</view>
    <view class="bad-sub">{{t.wbimport_bad_sub}}</view>
    <view class="btn ghost" bindtap="goPet" hover-class="btn-hover">{{t.wbimport_bad_pet_btn}}</view>
  </view>
</view>
