<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="{{t.wdisc_search_placeholder}}" value="{{q}}"
           bindinput="onQ" confirm-type="search" bindconfirm="doSearch" />
    <view class="search-btn" bindtap="doSearch" hover-class="search-btn-hover">{{t.wdisc_search_btn}}</view>
  </view>

  <view wx:if="{{loading}}" class="tip">{{t.wdisc_loading}}</view>
  <view wx:elif="{{searched && books.length === 0}}" class="tip">{{t.wdisc_empty}}</view>
  <view wx:else class="hint">{{t.wdisc_hint}}</view>

  <view wx:for="{{books}}" wx:key="id" class="pb">
    <view class="pb-main">
      <view class="pb-name"><text wx:if="{{item.featured}}" class="pb-star-mark">⭐</text>{{item.name}}<text wx:if="{{item.mine}}" class="pb-mine">{{t.wdisc_mine}}</text></view>
      <view class="pb-creator">
        <image wx:if="{{item.creatorAvatar}}" class="pb-avatar" src="{{item.creatorAvatar}}" mode="aspectFill" />
        <view wx:else class="pb-avatar pb-avatar-ph">👤</view>
        <text class="pb-creator-name">{{item.creatorName || t.wdisc_anon}}</text>
        <text class="pb-meta">{{item.metaLabel}}</text>
      </view>
      <view wx:if="{{item.preview}}" class="pb-preview">{{item.preview}}…</view>
    </view>
    <view class="pb-acts">
      <view wx:if="{{isAdmin}}" class="pb-feature {{item.featured ? 'on' : ''}}" catchtap="toggleFeatured" data-id="{{item.id}}">{{item.featured ? '★' : '☆'}}</view>
      <view class="pb-ref" catchtap="referenceBook" data-id="{{item.id}}" hover-class="pb-ref-hover">{{t.wdisc_add}}</view>
    </view>
  </view>
</view>
