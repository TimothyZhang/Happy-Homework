.focus-page {
  position: fixed;
  inset: 0;
  /* 暗色低亮度:省电(OLED 黑省电)+ 降低夜间打扰 */
  background: linear-gradient(180deg, #12151c 0%, #080a0e 100%);
  padding: calc(env(safe-area-inset-top) + 32rpx) 48rpx
           calc(env(safe-area-inset-bottom) + 48rpx);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
}

/* 左上角返回 — 避开右上角小程序胶囊(关闭/收起)位置 */
.back-btn {
  align-self: flex-start;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #aeb6c2;
  font-size: 44rpx;
  line-height: 80rpx;
  text-align: center;
  box-shadow: none;
}

.info-block {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: center;
}
.chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.08);
  color: #aeb6c2;
}
/* 暗色:subject 用淡蓝字区分,其余灰底浅灰字 */
.subject-chip { background: rgba(127, 168, 255, 0.16); color: #8fb2ff; font-weight: 600; }

.content {
  display: block;
  margin-top: 6rpx;
  font-size: 52rpx;
  line-height: 1.3;
  color: #d6dae2;
  font-weight: 700;
  text-align: center;
  word-break: break-word;
}

.date {
  font-size: 26rpx;
  color: #6b7785;
}

/* 大数字时间 — 焦点页的视觉主体 */
.clock-block {
  margin-top: auto;
  margin-bottom: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.clock-label {
  font-size: 28rpx;
  color: #6b7785;
  letter-spacing: 4rpx;
}

.clock-num {
  font-size: 160rpx;
  font-weight: 800;
  line-height: 1.05;
  /* 低亮度:大数字不刺眼,柔和冷灰蓝 */
  color: #7d8aa6;
  letter-spacing: 4rpx;
  font-variant-numeric: tabular-nums;
  font-family: "Menlo", "Monaco", "Helvetica Neue", sans-serif;
}

/* 按钮在 page 横向 48rpx padding 内,跟 tasks / pet / home 一致的全屏宽 pill 形。
   之前实验过"贯穿屏幕 + border-radius 0"的方案,但跟其他页全屏宽 pill 不一致,
   回退到这个版本(Tim 指示:做成圆角的,全屏宽,保持和其他页面一致)。 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 35, 41, 0.16);
  box-sizing: border-box;
  padding: 0;
}

.action-btn::after { border: none; }

.action-icon {
  font-size: 36rpx;
  line-height: 1;
}

.action-label {
  font-size: 40rpx;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 暗色低亮度:按钮降饱和、降亮度,夜里不刺眼 */
.pause-action {
  background: #9a6a16;
}
.finish-action {
  background: #0a7a3e;
}
