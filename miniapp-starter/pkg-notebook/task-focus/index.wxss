.focus-page {
  position: fixed;
  inset: 0;
  background: linear-gradient(180deg, #eaf2ff 0%, #d6e4ff 100%);
  padding: calc(env(safe-area-inset-top) + 32rpx) 48rpx
           calc(env(safe-area-inset-bottom) + 48rpx);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
}

/* 左上角返回 — 避开右上角小程序胶囊(关闭/收起)位置 */
.back-btn {
  align-self: flex-start;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  color: #5f6b7a;
  font-size: 44rpx;
  line-height: 80rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.06);
}

.info-block {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: center;
}
.chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
  background: #f0f2f5;
  color: #44505e;
}
/* 跟 task-list 一致:除 subject 外都走灰底深灰字,不要再染色 */
.subject-chip { background: #ffffff; color: #245bdb; font-weight: 600; }

.content {
  display: block;
  margin-top: 6rpx;
  font-size: 52rpx;
  line-height: 1.3;
  color: #1f2329;
  font-weight: 700;
  text-align: center;
  word-break: break-word;
}

.date {
  font-size: 26rpx;
  color: #6b7785;
}

/* 大数字时间 — 焦点页的视觉主体 */
.clock-block {
  margin-top: auto;
  margin-bottom: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.clock-label {
  font-size: 28rpx;
  color: #6b7785;
  letter-spacing: 4rpx;
}

.clock-num {
  font-size: 160rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #245bdb;
  letter-spacing: 4rpx;
  font-variant-numeric: tabular-nums;
  font-family: "Menlo", "Monaco", "Helvetica Neue", sans-serif;
}

/* negative margin 抵消 page 横向 48rpx padding + 下方 48rpx,让按钮真的贯穿
   屏幕宽并贴到屏幕底(保留 safe-area-inset-bottom 由 page padding 兜底)。
   按钮去掉 border-radius 也是为了视觉上"全屏宽":之前 999rpx 胶囊让两端是
   半圆,看起来像浮在屏幕中央,不像贯穿。 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin: 0 -48rpx -48rpx;
}

.action-btn {
  width: 100%;
  height: 140rpx;
  border-radius: 0;
  border: none;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: none;
  box-sizing: border-box;
  padding: 0;
}

.action-btn::after { border: none; }

.action-icon {
  font-size: 36rpx;
  line-height: 1;
}

.action-label {
  font-size: 40rpx;
  line-height: 1;
}

.pause-action {
  background: #f5a623;
}
.finish-action {
  background: #07c160;
}
