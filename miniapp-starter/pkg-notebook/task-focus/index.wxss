.focus-page {
  position: fixed;
  inset: 0;
  /* 暗色低亮度:省电(OLED 黑省电)+ 降低夜间打扰 */
  background: linear-gradient(180deg, #12151c 0%, #080a0e 100%);
  padding: calc(env(safe-area-inset-top) + 32rpx) 48rpx
           calc(env(safe-area-inset-bottom) + 48rpx);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
}

/* 左上角返回 — 避开右上角小程序胶囊(关闭/收起)位置 */
.back-btn {
  align-self: flex-start;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #aeb6c2;
  font-size: 44rpx;
  line-height: 80rpx;
  text-align: center;
  box-shadow: none;
}

.info-block {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: center;
}
.chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.08);
  color: #aeb6c2;
}
/* 暗色:subject 用淡蓝字区分,其余灰底浅灰字 */
.subject-chip { background: rgba(127, 168, 255, 0.16); color: #8fb2ff; font-weight: 600; }

.content {
  display: block;
  margin-top: 6rpx;
  font-size: 52rpx;
  line-height: 1.3;
  color: #d6dae2;
  font-weight: 700;
  text-align: center;
  word-break: break-word;
}

.date {
  font-size: 26rpx;
  color: #6b7785;
}

/* 大数字时间 — 焦点页的视觉主体 */
.clock-block {
  margin-top: auto;
  margin-bottom: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.clock-label {
  font-size: 28rpx;
  color: #6b7785;
  letter-spacing: 4rpx;
}

.clock-num {
  font-size: 160rpx;
  font-weight: 800;
  line-height: 1.05;
  /* 低亮度:大数字不刺眼,柔和冷灰蓝 */
  color: #7d8aa6;
  letter-spacing: 4rpx;
  font-variant-numeric: tabular-nums;
  font-family: "Menlo", "Monaco", "Helvetica Neue", sans-serif;
}

/* 暂停时:作业时间(上面大数字)定格,这里额外显示暂停时长(小一号) */
.pause-block {
  margin-top: 20rpx;
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
}
.pause-label { font-size: 24rpx; color: #8a94a3; letter-spacing: 3rpx; }
.pause-num {
  font-size: 60rpx; font-weight: 700; line-height: 1.05;
  color: #c2924a; letter-spacing: 3rpx;
  font-variant-numeric: tabular-nums;
  font-family: "Menlo", "Monaco", "Helvetica Neue", sans-serif;
}

/* 按钮在 page 横向 48rpx padding 内,跟 tasks / pet / home 一致的全屏宽 pill 形。
   之前实验过"贯穿屏幕 + border-radius 0"的方案,但跟其他页全屏宽 pill 不一致,
   回退到这个版本(Tim 指示:做成圆角的,全屏宽,保持和其他页面一致)。 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 35, 41, 0.16);
  box-sizing: border-box;
  padding: 0;
}

.action-btn::after { border: none; }

.action-icon {
  font-size: 36rpx;
  line-height: 1;
}

.action-label {
  font-size: 40rpx;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 暗色低亮度:按钮背景也压成深色,夜里不刺眼(留点色相区分暂停/完成) */
.pause-action {
  background: #56380d;
}
.finish-action {
  background: #0a4126;
}
.resume-action {
  background: #16406e;
}

/* 暂停时「建议休息 N 分钟」小提示 */
.pause-hint { font-size: 22rpx; color: #8a94a3; margin-top: 4rpx; }

/* 番茄倒计时进度条 */
.pomo-bar-wrap {
  align-self: center; width: 72%; max-width: 520rpx;
  margin-bottom: 26rpx;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
}
.pomo-bar {
  width: 100%; height: 14rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.10); overflow: hidden;
}
.pomo-bar-fill {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #e0884a 0%, #c2924a 100%);
  transition: width 0.9s linear;
}
.pomo-bar-text { font-size: 22rpx; color: #9aa3b2; font-weight: 600; letter-spacing: 1rpx; }

/* 番茄钟设置图标:右上角(位置/尺寸由内联 pomoBtnStyle 给出,贴胶囊左侧) */
.pomo-icon-btn {
  z-index: 30; border-radius: 50%; text-align: center;
  background: rgba(255, 255, 255, 0.08);
  font-size: 30rpx;
}

/* 番茄钟设置面板 */
.pomo-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(0, 0, 0, 0.55);
  display: flex; align-items: center; justify-content: center;
  padding: 60rpx;
}
.pomo-panel {
  width: 100%; max-width: 600rpx;
  background: #1b1f27; border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx; padding: 30rpx 28rpx 24rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.5);
}
.pomo-panel-title {
  font-size: 30rpx; font-weight: 800; color: #d6dae2;
  text-align: center; margin-bottom: 18rpx;
}
.pomo-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 6rpx; border-top: 2rpx solid rgba(255, 255, 255, 0.06);
}
.pomo-row-label { font-size: 26rpx; color: #aeb6c2; }
.pomo-row-val {
  font-size: 26rpx; font-weight: 700; color: #8fb2ff;
  padding: 6rpx 20rpx; border-radius: 999rpx;
  background: rgba(127, 168, 255, 0.12);
}
.pomo-panel-hint {
  margin-top: 16rpx; font-size: 21rpx; line-height: 1.5;
  color: #7a838f; text-align: center;
}
.pomo-panel-close {
  margin-top: 22rpx; height: 76rpx; line-height: 76rpx; text-align: center;
  border-radius: 999rpx; font-size: 28rpx; font-weight: 700; color: #ffffff;
  background: #16406e;
}

/* 计时旁的「!」图标:点开时间记录 */
.clock-label-row { display: flex; align-items: center; gap: 12rpx; }
.clock-info-btn {
  width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center;
  border-radius: 50%; font-size: 24rpx; font-weight: 800;
  color: #aeb6c2; background: rgba(255, 255, 255, 0.10);
}

/* 时间记录弹窗(暗色) */
.tl-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(0, 0, 0, 0.55);
  display: flex; align-items: center; justify-content: center; padding: 60rpx;
}
.tl-panel {
  width: 100%; max-width: 600rpx;
  background: #1b1f27; border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx; padding: 30rpx 28rpx 24rpx;
}
.tl-title { font-size: 30rpx; font-weight: 800; color: #d6dae2; text-align: center; margin-bottom: 16rpx; }
.tl-list { width: 100%; }
.tl-row { display: flex; align-items: center; padding: 14rpx 6rpx; border-top: 2rpx solid rgba(255, 255, 255, 0.06); }
.tl-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; background: #8a94a3; }
.tl-start .tl-dot { background: #3ea06a; }
.tl-pause .tl-dot { background: #c2924a; }
.tl-resume .tl-dot { background: #5b8cff; }
.tl-done .tl-dot { background: #2e9e5b; }
.tl-label { flex: 1; font-size: 26rpx; color: #aeb6c2; }
.tl-time { font-size: 26rpx; color: #d6dae2; font-weight: 700; }
.tl-empty { padding: 50rpx 0; text-align: center; color: #7a838f; font-size: 26rpx; }
.tl-close {
  margin-top: 22rpx; height: 76rpx; line-height: 76rpx; text-align: center;
  border-radius: 999rpx; font-size: 28rpx; font-weight: 700; color: #ffffff; background: #16406e;
}
