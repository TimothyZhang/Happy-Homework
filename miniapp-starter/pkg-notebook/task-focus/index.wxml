<view class="focus-page {{isLandscape ? 'landscape' : ''}}">
  <view class="back-btn" bindtap="handleClose">←</view>
  <!-- 番茄钟设置:右上角一个图标(贴着胶囊左侧) -->
  <view class="pomo-icon-btn" style="{{pomoBtnStyle}}" bindtap="openPomoSettings">🍅</view>

  <!-- 横屏时 focus-body 改成左右两栏:左=内容/计时/进度条,右=按钮(保证按钮可见) -->
  <view class="focus-body">
    <view class="focus-stage">
      <view class="info-block">
        <text class="content">{{content}}</text>
      </view>

      <view class="clock-block">
        <view class="clock-label-row">
          <text class="clock-label">{{t.tfocus_clock_label}}</text>
          <text class="clock-info-btn" catchtap="showTimeline">!</text>
        </view>
        <text class="clock-num">{{elapsedDisplay}}</text>
        <!-- 暂停后:作业时间(上面)定格,额外显示暂停时长 + 建议休息多久 -->
        <view wx:if="{{isPaused}}" class="pause-block">
          <text class="pause-label">{{t.tfocus_paused_label}}</text>
          <text class="pause-num">{{pausedDisplay}}</text>
          <text class="pause-hint">{{breakHint}}</text>
        </view>
      </view>

      <!-- 番茄倒计时进度条:本次专注进度 + 距休息剩余时间(暂停时收起)。
           到点后停在 0,进度条缓慢闪烁、每分钟提醒,可点「停止」关掉 -->
      <view wx:if="{{!isPaused}}" class="pomo-bar-wrap">
        <view class="pomo-bar {{pomoAlerting ? 'pomo-blink' : ''}}"><view class="pomo-bar-fill" style="width: {{pomoPercent}}%"></view></view>
        <view class="pomo-bar-row">
          <text wx:if="{{pomoAlerting}}" class="pomo-bar-text pomo-done">{{t.tfocus_pomo_done}}</text>
          <text wx:else class="pomo-bar-text">{{t.tfocus_pomo_left_pre}} {{pomoLeftDisplay}}</text>
          <text wx:if="{{pomoAlerting}}" class="pomo-stop-btn" catchtap="handleDismissPomo">{{t.tfocus_pomo_stop}}</text>
        </view>
      </view>
    </view>

    <view class="actions">
      <button wx:if="{{!isPaused}}" class="action-btn pause-action" bindtap="handlePause">
        <text class="action-icon">❚❚</text>
        <text class="action-label">{{t.tfocus_pause}}</text>
      </button>
      <button wx:else class="action-btn resume-action" bindtap="handleResume">
        <text class="action-icon">▶</text>
        <text class="action-label">{{t.tfocus_resume}}</text>
      </button>
      <button class="action-btn finish-action" bindtap="handleFinish">
        <text class="action-icon">✓</text>
        <text class="action-label">{{t.tfocus_finish}}</text>
      </button>
    </view>
  </view>

  <!-- 番茄钟设置面板:工作时长 / 短休息 / 长休息 / 努力阈值 / 统计时段 都可调 -->
  <view wx:if="{{showPomoSettings}}" class="pomo-mask" bindtap="closePomoSettings" catchtouchmove="noop">
    <view class="pomo-panel" catchtap="" catchtouchmove="noop">
      <view class="pomo-panel-title">{{t.tfocus_set_title}}</view>
      <view wx:for="{{pomoRows}}" wx:key="key" class="pomo-row">
        <text class="pomo-row-label">{{item.label}}</text>
        <picker mode="selector" range="{{item.optionLabels}}" value="{{item.index}}" data-key="{{item.key}}" bindchange="handlePomoChange">
          <view class="pomo-row-val">{{item.valueLabel}} ›</view>
        </picker>
      </view>
      <view class="pomo-panel-hint">{{t.tfocus_set_hint}}</view>
      <view class="pomo-panel-close" bindtap="closePomoSettings">{{t.tfocus_set_close}}</view>
    </view>
  </view>

  <!-- 时间记录:开始/暂停/继续/完成 的时刻 -->
  <view wx:if="{{showTimeline}}" class="tl-mask" bindtap="closeTimeline" catchtouchmove="noop">
    <view class="tl-panel" catchtap="" catchtouchmove="noop">
      <view class="tl-title">{{t.tfocus_tl_title}}</view>
      <scroll-view wx:if="{{timelineRows.length}}" scroll-y class="tl-list" style="max-height: 46vh;">
        <view wx:for="{{timelineRows}}" wx:key="index" class="tl-row tl-{{item.t}}">
          <view class="tl-dot"></view>
          <text class="tl-label">{{item.label}}</text>
          <text class="tl-time">{{item.time}}</text>
        </view>
      </scroll-view>
      <view wx:else class="tl-empty">{{t.tfocus_tl_empty}}</view>
      <view class="tl-close" bindtap="closeTimeline">{{t.tfocus_tl_close}}</view>
    </view>
  </view>

  <!-- 完成后:是否直接做下一项(自定义弹窗,跟专注页暗色风格一致,不用 native showModal) -->
  <view wx:if="{{showNextPrompt}}" class="next-mask" catchtouchmove="noop">
    <view class="next-panel">
      <view class="next-title">{{t.tfocus_next_title}}</view>
      <view class="next-q">{{t.tfocus_next_q}}</view>
      <view class="next-name">{{nextTask.content}}</view>
      <view class="next-btns">
        <view class="next-btn next-cancel" catchtap="dismissNext">{{t.tfocus_next_cancel}}</view>
        <view class="next-btn next-confirm" catchtap="confirmNext">{{t.tfocus_next_confirm}}</view>
      </view>
    </view>
  </view>
</view>
