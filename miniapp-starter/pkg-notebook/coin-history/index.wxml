<view class="page">
  <view class="balance-card">
    <text class="balance-label">{{t.coin_balance_label}}</text>
    <text class="balance-num">{{coins}}</text>
  </view>

  <view wx:if="{{logs.length === 0}}" class="card empty-card">
    <text class="empty-emoji">🪙</text>
    <text class="empty-text">{{t.coin_empty_text}}</text>
    <text class="empty-hint">{{t.coin_empty_hint}}</text>
  </view>

  <view wx:else class="card list-card">
    <view wx:for="{{logs}}" wx:key="key" class="log-row">
      <view class="log-emoji">{{item.emoji}}</view>
      <view class="log-body">
        <text class="log-title">{{item.title}}</text>
        <text wx:if="{{item.sub}}" class="log-sub">{{item.sub}}</text>
        <text class="log-time">{{item.timeText}}</text>
      </view>
      <view class="log-right">
        <text class="log-delta {{item.deltaClass}}">{{item.deltaText}}</text>
        <text wx:if="{{item.balanceAfter !== null}}" class="log-balance">{{item.balanceText}}</text>
      </view>
    </view>
  </view>
</view>
