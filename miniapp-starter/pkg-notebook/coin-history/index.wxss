.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.balance-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 40rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #245bdb 0%, #4a86ff 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(36, 91, 219, 0.24);
  margin-bottom: 16rpx;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.balance-num {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
  margin-bottom: 16rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 80rpx 28rpx;
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 600;
}

.empty-hint {
  font-size: 22rpx;
  color: #6b7785;
  text-align: center;
  line-height: 1.5;
}

.list-card {
  padding: 8rpx 0;
}

.log-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.log-row:last-child {
  border-bottom: none;
}

.log-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.log-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.log-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.3;
}

.log-sub {
  font-size: 22rpx;
  color: #5f6b7a;
  line-height: 1.4;
}

.log-time {
  font-size: 20rpx;
  color: #9aa4b2;
  margin-top: 2rpx;
}

.log-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.log-delta {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.log-delta.positive { color: #07c160; }
.log-delta.negative { color: #e54545; }
.log-delta.zero { color: #6b7785; }

.log-balance {
  font-size: 20rpx;
  color: #9aa4b2;
}
