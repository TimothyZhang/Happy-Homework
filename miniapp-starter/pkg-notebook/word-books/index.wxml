<view class="page">
  <!-- 每次背诵数量 -->
  <view class="card">
    <view class="row">
      <view class="row-main">
        <text class="row-title">每次背诵数量</text>
        <text class="row-sub">默认 20,至少 {{sizeMin}} 个(含 ≥3 新词)</text>
      </view>
      <view class="stepper">
        <view class="step-btn {{sessionSize <= sizeMin ? 'off' : ''}}" bindtap="decSize" hover-class="step-hover">−</view>
        <text class="step-val">{{sessionSize}}</text>
        <view class="step-btn {{sessionSize >= sizeMax ? 'off' : ''}}" bindtap="incSize" hover-class="step-hover">+</view>
      </view>
    </view>
  </view>

  <!-- 单词本列表 -->
  <view class="section-hd">
    <text class="section-title">我的单词本</text>
    <text class="section-sub">勾选 ★ 设为近期目标(可多选)· 已选 {{targetCount}}</text>
  </view>

  <view class="lib-stat">全部单词 <text class="lib-stat-n">{{totalWords}}</text> 个(去重),已掌握 <text class="lib-stat-n ok">{{masteredWords}}</text> 个</view>

  <view wx:for="{{books}}" wx:key="id" class="book" bindtap="openBook" data-id="{{item.id}}" hover-class="book-hover">
    <view class="star {{item.isTarget ? 'on' : ''}}" catchtap="toggleTarget" data-id="{{item.id}}">★</view>
    <view class="book-main">
      <text class="book-name">{{item.name}}</text>
      <text class="book-meta">{{item.count}} 词 · 已掌握 {{item.mastered}}{{item.builtin ? ' · 内置' : ''}}</text>
    </view>
    <text class="book-chev">›</text>
  </view>

  <view class="new-book" bindtap="newBook" hover-class="new-hover">＋ 新建单词本</view>
  <view class="hint-line">提示:点单词本进去可以加 / 删单词、拍照导入、分享给同学,也支持短语。</view>
</view>
