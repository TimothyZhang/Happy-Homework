<view class="page">
  <!-- words per session -->
  <view class="card">
    <view class="row">
      <view class="row-main">
        <text class="row-title">{{t.wbooks_sessionSize_title}}</text>
        <text class="row-sub">{{sessionSizeSub}}</text>
      </view>
      <view class="stepper">
        <view class="step-btn {{sessionSize <= sizeMin ? 'off' : ''}}" bindtap="decSize" hover-class="step-hover">−</view>
        <text class="step-val">{{sessionSize}}</text>
        <view class="step-btn {{sessionSize >= sizeMax ? 'off' : ''}}" bindtap="incSize" hover-class="step-hover">+</view>
      </view>
    </view>
  </view>

  <!-- word book list -->
  <view class="section-hd">
    <text class="section-title">{{t.wbooks_section_title}}</text>
    <text class="section-sub">{{sectionSub}}</text>
  </view>

  <view class="lib-stat">{{statLabel}}</view>

  <view wx:for="{{books}}" wx:key="id" class="book" bindtap="openBook" data-id="{{item.id}}" hover-class="book-hover">
    <view class="star {{item.isTarget ? 'on' : ''}}" catchtap="toggleTarget" data-id="{{item.id}}">★</view>
    <view class="book-main">
      <view class="book-name-row">
        <text class="book-name">{{item.name}}</text>
        <text wx:if="{{item.isRef}}" class="book-ref-tag">{{t.wbooks_ref_tag}}</text>
      </view>
      <view wx:if="{{item.isRef}}" class="book-creator">
        <image wx:if="{{item.creatorAvatar}}" class="book-creator-avatar" src="{{item.creatorAvatar}}" mode="aspectFill" />
        <view wx:else class="book-creator-avatar book-creator-ph">👤</view>
        <text class="book-creator-name">{{item.creatorName || t.wbooks_anon}}</text>
      </view>
      <text class="book-meta">{{item.metaLabel}}</text>
    </view>
    <text class="book-chev">›</text>
  </view>

  <view class="new-book {{customCount >= customMax ? 'full' : ''}}" bindtap="newBook" hover-class="new-hover">{{newLabel}}</view>
  <view class="new-book discover" bindtap="goDiscover" hover-class="discover-hover">{{t.wbooks_discover}}</view>
  <view class="hint-line">{{t.wbooks_hint}}</view>
</view>
