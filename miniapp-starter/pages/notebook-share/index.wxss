.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.header-card { margin-bottom: 12rpx; }

.hint-pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
  font-size: 22rpx;
  margin-bottom: 18rpx;
}

.nb-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}

.nb-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7785;
}

.nb-count {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #245bdb;
  font-weight: 600;
}

.empty-state { padding: 40rpx 24rpx; text-align: center; }
.empty-emoji { display: block; font-size: 72rpx; }
.empty-text { display: block; margin-top: 16rpx; font-size: 26rpx; color: #6b7785; }

.subject-header {
  margin: 28rpx 6rpx 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #245bdb;
  letter-spacing: 1rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 35, 41, 0.06);
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #245bdb;
  flex-shrink: 0;
}

.row-body { flex: 1; min-width: 0; }

.row-content {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
  font-weight: 500;
}

.row-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  white-space: nowrap;
  background: #f7f8fa;
  color: #6b7785;
}

.subject-chip {
  background: #eef4ff;
  color: #245bdb;
  font-weight: 600;
}

/* Buttons go truly edge-to-edge — negative margin cancels the .page padding
   so the row spans the full screen width. */
.bottom-actions {
  margin: 32rpx -24rpx 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.full-btn {
  width: 100%;
  margin: 0;
  height: 84rpx;
  /* WeChat <button> 默认 line-height 在不同基础库表现不一致 — flex 显式居中
     才能让单行文字稳定垂直居中。 */
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-sizing: border-box;
}

.save-btn {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 219, 0.25);
}

.save-btn[disabled] {
  opacity: 0.7;
  color: #ffffff;
}

/* 弱化次要操作（分享 / 取消 / 错误页返回）— 浅灰背景 + 深色文字。
   让 「💾 保存」 在主操作组里独占视觉重点。 */
.share-btn,
.ghost-btn {
  background: #f0f0f0;
  color: #1f2329;
}

.error-card { text-align: center; padding: 48rpx 28rpx; }
.error-emoji { display: block; font-size: 72rpx; margin-bottom: 16rpx; }
.error-text { display: block; font-size: 28rpx; color: #6b7785; margin-bottom: 24rpx; }
