<view class="page">
  <view wx:if="{{error}}" class="card error-card">
    <text class="error-emoji">😢</text>
    <text class="error-text">{{error}}</text>
    <button class="full-btn ghost-btn" bindtap="handleCancel">返回</button>
  </view>

  <block wx:elif="{{payload}}">
    <view class="card header-card">
      <view class="sharer-row">
        <image wx:if="{{sharerAvatar}}"
               class="sharer-avatar"
               src="{{sharerAvatar}}"
               mode="aspectFill" />
        <view wx:else class="sharer-avatar sharer-avatar-fallback">📥</view>
        <view class="sharer-text">
          <text wx:if="{{sharerNickname}}" class="sharer-name">{{sharerNickname}}</text>
          <text class="sharer-hint">{{sharerLabel}}</text>
        </view>
      </view>
      <text class="nb-name">{{headerTitle}}</text>
      <text class="nb-count">共 {{payload.t.length}} 项 · 勾选 {{selectedCount}} 项导入</text>
      <view class="toolbar-row">
        <text class="seg-btn active" bindtap="handleToggleAll">全选 / 全不选</text>
      </view>
    </view>

    <view wx:if="{{payload.t.length === 0}}" class="card">
      <view class="empty-state">
        <text class="empty-emoji">📝</text>
        <text class="empty-text">分享里没有作业,导入后可以自己再添加</text>
      </view>
    </view>

    <block wx:for="{{arrangedTasks}}" wx:key="_idx">
      <view wx:if="{{item.firstOfSubject}}" class="subject-header">{{item.subject}}</view>
      <view class="task-row {{item.selected ? '' : 'task-unchecked'}}"
            data-idx="{{index}}"
            bindtap="handleToggleTask">
        <view class="check-dot {{item.selected ? 'checked' : ''}}"></view>
        <view class="row-body">
          <text class="row-content">{{item.content}}</text>
          <view class="row-chips">
            <text class="chip org-chip">{{item.organization}}</text>
            <text class="chip range-chip">{{item.scheduleLabel}}</text>
            <text wx:if="{{item.estimatedMinutes > 0}}" class="chip est-chip">预计 {{item.estimatedMinutes}} 分钟</text>
          </view>
        </view>
      </view>
    </block>

    <view class="bottom-actions">
      <button class="full-btn save-btn" bindtap="handleImport" disabled="{{importing || selectedCount === 0}}">
        {{importing ? '保存中…' : '💾 导入 ' + selectedCount + ' 项'}}
      </button>
    </view>
  </block>
</view>
