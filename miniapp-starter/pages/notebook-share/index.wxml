<view class="page">
  <view wx:if="{{error}}" class="card error-card">
    <text class="error-emoji">😢</text>
    <text class="error-text">{{error}}</text>
    <button class="full-btn ghost-btn" bindtap="handleCancel">{{t.nbshare_btn_back}}</button>
  </view>

  <block wx:elif="{{payload}}">
    <scroll-view scroll-y="{{true}}" show-scrollbar="{{false}}" class="scroll-area">
      <view class="card header-card">
        <view class="sharer-row">
          <image wx:if="{{sharerAvatar}}"
                 class="sharer-avatar"
                 src="{{sharerAvatar}}"
                 mode="aspectFill" />
          <view wx:else class="sharer-avatar sharer-avatar-fallback">📥</view>
          <view class="sharer-text">
            <text class="sharer-name">{{headerTitle}}</text>
            <text class="sharer-hint">{{sharerHint}}</text>
          </view>
        </view>

        <view class="chip-row">
          <text class="chip org-chip">{{orgLabel}}</text>
          <text class="chip date-chip">{{dateRangeLabel}}</text>
        </view>
      </view>

      <view wx:if="{{payload.t.length === 0}}" class="card empty-card">
        <text class="empty-emoji">📝</text>
        <text class="empty-text">{{t.nbshare_empty}}</text>
      </view>

      <block wx:for="{{subjectGroups}}" wx:key="subject" wx:for-item="group">
        <view class="subject-header">{{group.subject}} ({{group.tasks.length}})</view>
        <view wx:for="{{group.tasks}}"
              wx:key="id"
              wx:for-item="t"
              class="task-row">
          <view class="row-body">
            <text class="row-content">{{t.content}}</text>
            <view class="row-chips">
              <text wx:if="{{t.dueDateLabel}}" class="chip range-chip">{{t.dueDateLabel}}</text>
              <text wx:if="{{t.estimatedMinutes > 0}}" class="chip est-chip">{{t.estimatedMinutesLabel}}</text>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>

    <view class="bottom-actions">
      <button class="full-btn save-btn"
              bindtap="handleImport"
              disabled="{{importing || imported || payload.t.length === 0}}">
        {{saveBtnLabel}}
      </button>
    </view>
  </block>
</view>
