/* 作业组织标签管理页。样式从 pages/profile 的 org-* 迁过来。 */

.org-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7785;
  background: #eef0f3;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.org-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a94a4;
  line-height: 1.5;
}
.org-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.org-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #f7f9fc;
  border-radius: 14rpx;
  gap: 16rpx;
}
.org-name {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
  word-break: break-all;
}
.org-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.org-btn {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1;
}
.org-btn.ghost {
  background: #eef4ff;
  color: #245bdb;
}
.org-btn.danger {
  background: #fff1f0;
  color: #e54545;
}

.org-add {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}
.org-input {
  flex: 1;
  min-width: 0;
}
.org-add-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  margin: 0;
  border: none;
}
.org-add-btn::after { border: none; }

.org-reset {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a94a4;
  padding: 12rpx 0;
}
