/* The page is locked to the viewport (page-meta disable-scroll="true") so the
   only scrollable surface is the inner <scroll-view>. That lets the long-press
   drag in <task-list> toggle scroll-y off mid-gesture — page-meta alone wasn't
   stopping the screen from drifting once the touch had already begun. */
.page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.scroll-area {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
  /* Custom tabbar overlay (~100rpx) + safe-area inset. */
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

/* Section grouping — visually transparent so task rows align with the
   scroll-area edge (avoids double-card nesting that left ~28rpx extra
   whitespace on each side vs. other tabs). */
.section-card { margin-top: 24rpx; }
.section-card .section-header { margin-bottom: 16rpx; }

/* === date segment ===
   "今天" stays visually prominent (twice as wide, larger font) but the brand
   fill is reserved for whichever segment is actually selected — otherwise the
   user can't tell which one they tapped. */
.seg-bar {
  display: flex;
  align-items: stretch;
  background: #f3f6fa;
  padding: 6rpx;
  border-radius: 18rpx;
  gap: 6rpx;
}

.seg-btn {
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 14rpx;
  line-height: 1.2;
  font-weight: 500;
  color: #6b7785;
}

.today-seg {
  flex: 2;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.small-seg {
  flex: 1;
  font-size: 24rpx;
}

.seg-btn.active {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 219, 0.22);
}

.cal-embed {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef0f3;
}

/* === pet talk === */
.pet-talk {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.pet-bubble {
  flex: 1;
  position: relative;
  background: #f7f8fa;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  padding: 22rpx 26rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
}

.pet-bubble::after {
  content: '';
  position: absolute;
  right: -14rpx;
  bottom: 22rpx;
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 0;
  border-left: 18rpx solid #f7f8fa;
}

.pet-bubble-text {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.55;
}

.pet-mascot {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7e0 0%, #ffe1a8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(255, 182, 72, 0.28);
}

.pet-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.section-count {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
}

.done-section .section-title { color: #067647; }
.section-count.done-count {
  background: #e8f7ee;
  color: #067647;
}

.empty-tip {
  margin-top: 28rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  text-align: center;
}

.empty-emoji { display: block; font-size: 72rpx; }
.empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7785;
}

/* overdue section */
.overdue-card .section-title { color: #b42318; }

.overdue-count {
  font-size: 22rpx;
  color: #b42318;
  font-weight: 700;
  background: #fde2e2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

