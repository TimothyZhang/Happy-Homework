.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.hero,
.panel {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 35, 41, 0.08);
}

.panel {
  margin-top: 24rpx;
}

.eyebrow {
  display: block;
  font-size: 24rpx;
  color: #4e5969;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #1f2329;
}

.subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4e5969;
}

.primary-btn {
  margin-top: 32rpx;
  background: #07c160;
  color: #ffffff;
  border: none;
}

.panel-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0f3;
}

.todo-item:first-of-type {
  border-top: none;
}

.todo-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #e8f7ee;
  color: #07c160;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.todo-text {
  font-size: 28rpx;
  color: #1f2329;
}
