.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.section-card { margin-top: 24rpx; }

/* === day switcher === */
.day-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f3f6fa;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
}

.day-btn {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #245bdb;
  font-weight: 700;
}

.day-label {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.hero-actions-mini {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  justify-content: flex-end;
}

.link-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
  font-size: 22rpx;
  font-weight: 600;
}

/* === hero stats === */
.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.hero-stat {
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
}

.hero-stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2329;
  line-height: 1.1;
}

.hero-stat-value.highlight { color: #245bdb; }

.hero-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7785;
}

.hero-empty {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
  color: #6b7785;
  font-size: 26rpx;
}

.all-done-banner {
  margin-top: 22rpx;
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #fde8b9 100%);
  text-align: center;
}

.banner-emoji { display: block; font-size: 72rpx; line-height: 1; }
.banner-title {
  display: block;
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #c2410c;
  letter-spacing: 1rpx;
}
.banner-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #7c5200;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.empty-tip {
  margin-top: 28rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  text-align: center;
}

.empty-emoji { display: block; font-size: 72rpx; }
.empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7785;
}

/* overdue section */
.overdue-card .section-title { color: #b42318; }

.overdue-count {
  font-size: 22rpx;
  color: #b42318;
  font-weight: 700;
  background: #fde2e2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* === all-done overlay === */
.congrats-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.45);
  animation: fadeIn 0.3s ease-out;
}

.congrats-card {
  position: relative;
  z-index: 2;
  width: 600rpx;
  padding: 56rpx 40rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #fffaf0 0%, #fde8b9 100%);
  text-align: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.25);
  animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.congrats-emoji {
  display: block;
  font-size: 120rpx;
  line-height: 1;
  animation: bounce 1s infinite alternate;
}

.congrats-title {
  display: block;
  margin-top: 24rpx;
  font-size: 52rpx;
  font-weight: 800;
  color: #c2410c;
  letter-spacing: 2rpx;
}

.congrats-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  color: #7c5200;
}

.congrats-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 32rpx;
  padding: 18rpx 0;
  border-top: 1rpx dashed rgba(124, 82, 0, 0.25);
  font-size: 26rpx;
  color: #7c5200;
}

.congrats-btn {
  margin-top: 32rpx;
  padding: 0 60rpx;
  border-radius: 999rpx;
  background: #c2410c;
  color: #ffffff;
  font-size: 30rpx;
  border: none;
}

.confetti {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  font-size: 48rpx;
  animation: floatUp 3.5s ease-in-out infinite;
}

.confetti-piece.c1 { left: 10%; top: 20%; animation-delay: 0s; }
.confetti-piece.c2 { left: 30%; top: 80%; animation-delay: 0.4s; }
.confetti-piece.c3 { left: 60%; top: 30%; animation-delay: 0.8s; }
.confetti-piece.c4 { left: 80%; top: 70%; animation-delay: 1.2s; }
.confetti-piece.c5 { left: 50%; top: 15%; animation-delay: 1.6s; }
.confetti-piece.c6 { left: 20%; top: 60%; animation-delay: 2.0s; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes popIn {
  0% { opacity: 0; transform: scale(0.6); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes bounce {
  from { transform: translateY(0) rotate(-6deg); }
  to { transform: translateY(-12rpx) rotate(6deg); }
}
@keyframes floatUp {
  0% { transform: translateY(40rpx) rotate(0deg); opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { transform: translateY(-200rpx) rotate(360deg); opacity: 0; }
}
