/* The page is locked to the viewport (page-meta disable-scroll="true") so the
   only scrollable surface is the inner <scroll-view>. That lets the long-press
   drag in <task-list> toggle scroll-y off mid-gesture — page-meta alone wasn't
   stopping the screen from drifting once the touch had already begun. */
.page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /* Gradient ends in #ffffff so the bit of background that shows between
     short content (e.g. only 3 tasks today) and the white custom tab bar
     blends seamlessly — otherwise the gradient's natural end (#eef4ff)
     reads as a visible "gap" above the tab bar. Bias the white stop high
     so the bottom half of the page is essentially white, eliminating the
     bluish band that previously hung above the tab bar. Tasks tab doesn't
     show this because the notebook list usually fills the viewport. */
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 30%, #ffffff 55%);
  /* Override app.wxss 的 `.page { padding: 24rpx }` —— 那条会让 .page 的
     左/右/顶 各留 24rpx 空白,scroll-view 整体被推进去,屏幕最左 / 最右
     的 24rpx 落在 .page padding 区,touch 不进 scroll-view 不能滚。视觉
     上的留白搬到 .scroll-area 自己的 padding 里 —— 那块在 scroll-view 内,
     原生 scroll 收得到。Reserve space at the bottom for the fixed custom
     tab bar (~100rpx + safe area). */
  padding: 0;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.scroll-area {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  /* 24rpx 视觉留白由 scroll-view 自己撑出来,这样屏幕边缘 0-24rpx 那条
     窄带也是 scroll-view 的命中区(padding 在 hit-test 里属于元素自身)。
     calendar 页一直这么做,首页之前漏抄。 */
  padding: 24rpx;
  padding-bottom: 0;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.section-card { margin-top: 24rpx; }

/* === date segment === 4 个 seg 等宽,显示 "5/16 Sat" 格式。
   今天用浅蓝底色标记(永久),active 选中后变深蓝白字。 */
.seg-bar {
  display: flex;
  align-items: stretch;
  background: #f3f6fa;
  padding: 6rpx;
  border-radius: 18rpx;
  gap: 6rpx;
}

.seg-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  line-height: 1.2;
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7785;
}

/* 今天 segment 永久浅蓝标记,即使未选中也能一眼认出。 */
.today-seg {
  background: #eaf2ff;
  color: #245bdb;
  font-weight: 700;
}

.seg-btn.active {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 219, 0.22);
}

.cal-embed {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef0f3;
}

/* === pet talk === */
.pet-talk {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.pet-bubble {
  flex: 1;
  position: relative;
  background: #f7f8fa;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  padding: 22rpx 26rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
}

.pet-bubble::after {
  content: '';
  position: absolute;
  right: -14rpx;
  bottom: 22rpx;
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 0;
  border-left: 18rpx solid #f7f8fa;
}

.pet-bubble-text {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.55;
  transition: opacity 220ms ease;
}
.pet-bubble-text.is-fading {
  opacity: 0;
}

.pet-mascot {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7e0 0%, #ffe1a8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(255, 182, 72, 0.28);
  overflow: hidden;
}

.pet-emoji {
  font-size: 64rpx;
  line-height: 1;
}

/* SVG mascot — kept slightly inset so it sits inside the round badge. */
.pet-art {
  width: 92rpx;
  height: 92rpx;
  display: block;
}

/* Mood overlays — mirror pet page so a sad/sick/dirty pet looks the same in
   both views. See pages/pet/index.wxss .anim-* for the canonical values. */
.pet-mascot.anim-sad   .pet-art { filter: grayscale(0.3); }
.pet-mascot.anim-dirty .pet-art { filter: brightness(0.9); }
.pet-mascot.anim-sick  .pet-art { filter: hue-rotate(-30deg) brightness(0.92); }

/* === early-bird bonus chip + rules popup === */
.bonus-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.bonus-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f6fa;
  color: #6b7785;
  font-size: 24rpx;
  font-weight: 600;
}

.bonus-chip--active {
  background: linear-gradient(135deg, #fff1d6 0%, #ffd99c 100%);
  color: #8a4d00;
  box-shadow: 0 4rpx 10rpx rgba(255, 182, 72, 0.22);
}

.bonus-chip__icon { font-size: 26rpx; line-height: 1; }
.bonus-chip__label { line-height: 1.2; }
.bonus-chip-placeholder { flex: 1; }

.bonus-help {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eef4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bonus-help__q {
  font-size: 26rpx;
  font-weight: 700;
  color: #245bdb;
  line-height: 1;
}

.rules-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
}
.rules-sheet {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 36rpx 28rpx;
  box-shadow: 0 24rpx 64rpx rgba(15, 23, 42, 0.24);
  box-sizing: border-box;
}
.rules-scroll {
  /* 直接给 scroll-view max-height,不靠 flex(WeChat scroll-view 在 flex
     里要么撑到内容高、要么塌成 0,两种都坏)。85vh 减去 title (~70rpx) +
     close (~104rpx) + padding (~64rpx) ≈ 240rpx 的预留 */
  max-height: calc(85vh - 240rpx);
}
.rules-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 18rpx;
  text-align: center;
}
.rules-subtitle {
  font-size: 26rpx;
  color: #6b7785;
  margin: 4rpx 0 10rpx;
}
.rules-section { display: flex; flex-direction: column; gap: 4rpx; }
.rules-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.rules-row:last-child { border-bottom: 0; }
.rules-row__name { font-size: 26rpx; color: #1f2329; }
.rules-row__amt { font-size: 26rpx; font-weight: 700; color: #8a4d00; }
.rules-divider {
  height: 1rpx;
  background: #eef0f3;
  margin: 18rpx 0 14rpx;
}
.rules-hint {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  font-size: 24rpx;
  color: #6b7785;
  line-height: 1.55;
}
.rules-close {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.section-count {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
}

.section-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.add-task-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #245bdb;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 219, 0.25);
}

.done-section .section-title { color: #067647; }
.section-count.done-count {
  background: #e8f7ee;
  color: #067647;
}

.empty-tip {
  margin-top: 28rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  text-align: center;
}

.empty-emoji { display: block; font-size: 72rpx; }
.empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7785;
}

/* === bottom share action (navigates to /pages/share/index) === //
   24rpx 负边距吃掉 .scroll-area 自带的 padding,让按钮真正 edge-to-edge。 */
.home-share-action {
  margin: 36rpx -24rpx 24rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 -4rpx 18rpx rgba(36, 91, 219, 0.18);
}
.home-share-icon { font-size: 32rpx; line-height: 1; }
.home-share-label { line-height: 1; }

/* overdue section */
.overdue-card .section-title { color: #b42318; }

.overdue-count {
  font-size: 22rpx;
  color: #b42318;
  font-weight: 700;
  background: #fde2e2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

