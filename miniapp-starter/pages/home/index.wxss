.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.section-card { margin-top: 24rpx; }

/* === segmented switcher: today / tomorrow / calendar === */
.seg-bar {
  display: flex;
  background: #f3f6fa;
  padding: 6rpx;
  border-radius: 18rpx;
  gap: 4rpx;
}

.seg-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  background: transparent;
  transition: background 0.18s ease;
}

.seg-btn.active {
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 219, 0.12);
}

.seg-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #6b7785;
  line-height: 1.2;
}

.seg-btn.active .seg-label { color: #245bdb; }

.seg-date {
  font-size: 20rpx;
  color: #8a96a3;
  margin-top: 4rpx;
  line-height: 1;
}

.seg-btn.active .seg-date { color: #245bdb; }

.hero-cal { margin-top: 18rpx; }

/* === pet talk === */
.pet-talk {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.pet-bubble {
  flex: 1;
  position: relative;
  background: #f7f8fa;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  padding: 22rpx 26rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
}

.pet-bubble::after {
  content: '';
  position: absolute;
  right: -14rpx;
  bottom: 22rpx;
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 0;
  border-left: 18rpx solid #f7f8fa;
}

.pet-bubble-text {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.55;
}

.pet-mascot {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7e0 0%, #ffe1a8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(255, 182, 72, 0.28);
}

.pet-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.section-count {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
}

.done-section .section-title { color: #067647; }
.section-count.done-count {
  background: #e8f7ee;
  color: #067647;
}

.empty-tip {
  margin-top: 28rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  text-align: center;
}

.empty-emoji { display: block; font-size: 72rpx; }
.empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7785;
}

/* overdue section */
.overdue-card .section-title { color: #b42318; }

.overdue-count {
  font-size: 22rpx;
  color: #b42318;
  font-weight: 700;
  background: #fde2e2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
