.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.section-card {
  margin-top: 24rpx;
}

.hero-top,
.section-header,
.task-row,
.task-meta,
.task-actions,
.shop-item,
.reward-rule,
.hero-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-top {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-stat {
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
}

.hero-stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2329;
  line-height: 1.1;
}

.hero-stat-value.highlight {
  color: #245bdb;
}

.hero-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7785;
}

.hero-empty {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
  color: #6b7785;
  font-size: 26rpx;
}

.all-done-banner {
  margin-top: 28rpx;
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #fde8b9 100%);
  text-align: center;
}

.banner-emoji {
  display: block;
  font-size: 72rpx;
  line-height: 1;
}

.banner-title {
  display: block;
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #c2410c;
  letter-spacing: 1rpx;
}

.banner-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #7c5200;
}

.add-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.ocr-task-btn {
  flex: 1;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  color: #7b8794;
}

.title {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2329;
}

.pet-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #fff6d8 0%, #ffe29a 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pet-emoji {
  font-size: 46rpx;
}

.pet-level {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a5b00;
}

.progress-strip {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.55);
}

.progress-label {
  display: block;
  font-size: 24rpx;
  color: #5e6b79;
}

.progress-value {
  display: block;
  margin: 10rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.summary-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
}

.summary-item.highlight {
  background: linear-gradient(180deg, #eaf5ff 0%, #d7ebff 100%);
}

.summary-value {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7785;
}

.hero-actions {
  gap: 16rpx;
  margin-top: 28rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
}

.primary-btn {
  background: #07c160;
  color: #ffffff;
}

.ghost-btn {
  background: #eef4ff;
  color: #245bdb;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.section-desc,
.coin-balance,
.reward-note,
.task-actual,
.shop-effect {
  font-size: 24rpx;
  color: #6b7785;
}

.timeline {
  position: relative;
  margin-top: 24rpx;
}

.task-item {
  display: flex;
  position: relative;
  padding-bottom: 28rpx;
}

.task-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #cad3dd;
  margin-top: 20rpx;
  position: relative;
}

.task-item:not(:last-child) .timeline-dot::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 8rpx;
  width: 2rpx;
  height: calc(100% + 14rpx);
  background: #e5e9ef;
}

.task-item.doing .timeline-dot {
  background: #ffb648;
}

.task-item.done .timeline-dot {
  background: #07c160;
}

.task-main {
  flex: 1;
  margin-left: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.task-subject {
  font-size: 28rpx;
  font-weight: 700;
}

.task-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-todo {
  background: #edf0f3;
  color: #5f6b7a;
}

.status-doing {
  background: #fff1d6;
  color: #b26a00;
}

.status-done {
  background: #e8f7ee;
  color: #067647;
}

.task-content {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1f2329;
}

.task-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6b7785;
}

.task-actions {
  margin-top: 18rpx;
  justify-content: flex-start;
  gap: 16rpx;
}

.mini-btn {
  margin: 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  border: none;
}

.start-btn {
  background: #245bdb;
  color: #ffffff;
}

.pause-btn {
  background: #ffb648;
  color: #ffffff;
}

.resume-btn {
  background: #245bdb;
  color: #ffffff;
}

.finish-btn {
  background: #07c160;
  color: #ffffff;
}

.plain-btn {
  background: #edf0f3;
  color: #44505e;
}

.task-elapsed {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245bdb;
  font-size: 22rpx;
}

.task-item.paused .timeline-dot {
  background: #ffb648;
  opacity: 0.5;
}

.status-paused {
  background: #fff1d6;
  color: #b26a00;
  opacity: 0.85;
}

.full-width {
  flex: 1;
}

/* === bottom inline add-task button === */
.add-task-btn {
  flex: 1;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 219, 0.25);
}

.empty-tip {
  margin-top: 32rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  text-align: center;
}

.empty-emoji {
  display: block;
  font-size: 72rpx;
}

.empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7785;
}

/* === all-done congrats overlay === */
.congrats-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.45);
  animation: fadeIn 0.3s ease-out;
}

.congrats-card {
  position: relative;
  z-index: 2;
  width: 600rpx;
  padding: 56rpx 40rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #fffaf0 0%, #fde8b9 100%);
  text-align: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.25);
  animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.congrats-emoji {
  display: block;
  font-size: 120rpx;
  line-height: 1;
  animation: bounce 1s infinite alternate;
}

.congrats-title {
  display: block;
  margin-top: 24rpx;
  font-size: 52rpx;
  font-weight: 800;
  color: #c2410c;
  letter-spacing: 2rpx;
}

.congrats-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  color: #7c5200;
}

.congrats-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 32rpx;
  padding: 18rpx 0;
  border-top: 1rpx dashed rgba(124, 82, 0, 0.25);
  font-size: 26rpx;
  color: #7c5200;
}

.congrats-btn {
  margin-top: 32rpx;
  padding: 0 60rpx;
  border-radius: 999rpx;
  background: #c2410c;
  color: #ffffff;
  font-size: 30rpx;
  border: none;
}

.confetti {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  font-size: 48rpx;
  animation: floatUp 3.5s ease-in-out infinite;
}

.confetti-piece.c1 { left: 10%; top: 20%; animation-delay: 0s; }
.confetti-piece.c2 { left: 30%; top: 80%; animation-delay: 0.4s; }
.confetti-piece.c3 { left: 60%; top: 30%; animation-delay: 0.8s; }
.confetti-piece.c4 { left: 80%; top: 70%; animation-delay: 1.2s; }
.confetti-piece.c5 { left: 50%; top: 15%; animation-delay: 1.6s; }
.confetti-piece.c6 { left: 20%; top: 60%; animation-delay: 2.0s; }

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  0% { opacity: 0; transform: scale(0.6); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes bounce {
  from { transform: translateY(0) rotate(-6deg); }
  to { transform: translateY(-12rpx) rotate(6deg); }
}

@keyframes floatUp {
  0% { transform: translateY(40rpx) rotate(0deg); opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { transform: translateY(-200rpx) rotate(360deg); opacity: 0; }
}

.reward-flash-card {
  background: linear-gradient(180deg, #eefbf3 0%, #dbf7e7 100%);
}

.reward-card {
  background: linear-gradient(180deg, #fffdf6 0%, #fff7df 100%);
}

.reward-rules {
  margin-top: 22rpx;
}

.reward-rule {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(138, 91, 0, 0.08);
}

.reward-rule:first-child {
  border-top: none;
}

.rule-title {
  font-size: 28rpx;
  color: #4c3b19;
}

.rule-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #b26a00;
}

.pet-panel {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.pet-visual {
  width: 220rpx;
  min-height: 220rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fef3c7 0%, #fde68a 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
}

.pet-avatar {
  font-size: 88rpx;
}

.pet-name {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #7c5200;
}

.pet-growth {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a5b00;
  text-align: center;
}

.pet-stats {
  flex: 1;
}

.pet-stat + .pet-stat {
  margin-top: 22rpx;
}

.pet-stat-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #44505e;
}

.shop-list {
  margin-top: 24rpx;
}

.shop-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #edf0f3;
}

.shop-item:first-child {
  border-top: none;
}

.shop-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.buy-btn {
  background: #1f2329;
  color: #ffffff;
}

.social-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.tag {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #245bdb;
  background: #eef4ff;
}

.tag.disabled {
  color: #8c959f;
  background: #f1f3f5;
}
