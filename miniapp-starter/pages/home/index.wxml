<view class="page">
  <view class="hero card">
    <view class="seg-bar">
      <view class="seg-btn {{mode === 'today' ? 'active' : ''}}" bindtap="handleSelectToday">
        <text class="seg-label">今天</text>
        <text class="seg-date">{{todayShort}}</text>
      </view>
      <view class="seg-btn {{mode === 'tomorrow' ? 'active' : ''}}" bindtap="handleSelectTomorrow">
        <text class="seg-label">明天</text>
        <text class="seg-date">{{tomorrowShort}}</text>
      </view>
      <view class="seg-btn {{mode === 'calendar' ? 'active' : ''}}" bindtap="handleSelectCalendar">
        <text class="seg-label">日历</text>
        <text wx:if="{{calendarShort}}" class="seg-date">{{calendarShort}}</text>
      </view>
    </view>

    <view wx:if="{{mode === 'calendar'}}" class="hero-cal">
      <month-calendar id="month-cal"
                      selected-date="{{activeDate}}"
                      bind:pick="handleCalPick" />
    </view>

    <view class="pet-talk">
      <view class="pet-bubble">
        <text class="pet-bubble-text">{{petMessage}}</text>
      </view>
      <view class="pet-mascot">
        <text class="pet-emoji">{{pet.emoji}}</text>
      </view>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-header">
      <text class="section-title">未完成</text>
      <text wx:if="{{undoneItems.length > 0}}" class="section-count">{{undoneItems.length}}</text>
    </view>

    <view wx:if="{{undoneItems.length === 0}}" class="empty-tip">
      <text class="empty-emoji">{{doneItems.length > 0 ? '🎉' : '📝'}}</text>
      <text class="empty-text">{{doneItems.length > 0 ? '没有未完成的作业，全部搞定！' : (isToday ? '今日没有待办，去「作业本」页新建' : '这一天没有作业')}}</text>
    </view>

    <task-list wx:if="{{undoneItems.length > 0}}"
               items="{{undoneItems}}"
               active-date="{{activeDate}}"
               bind:changed="handleTasksChanged" />
  </view>

  <view wx:if="{{doneItems.length > 0}}" class="card section-card done-section">
    <view class="section-header">
      <text class="section-title">已完成</text>
      <text class="section-count done-count">{{doneItems.length}}</text>
    </view>
    <task-list items="{{doneItems}}"
               active-date="{{activeDate}}"
               enable-drag="{{false}}"
               bind:changed="handleTasksChanged" />
  </view>

  <reward-toast kind="task"
                visible="{{taskRewardVisible}}"
                coins="{{taskRewardCoins}}"
                pet-emoji="{{pet.emoji}}"
                bind:skip="handleSkipTaskReward" />

  <reward-toast kind="allDone"
                visible="{{allDoneVisible}}"
                coins="{{allDoneCoins}}"
                subtitle="{{allDoneSubtitle}}"
                pet-emoji="{{pet.emoji}}"
                bind:skip="handleSkipAllDone" />
</view>
