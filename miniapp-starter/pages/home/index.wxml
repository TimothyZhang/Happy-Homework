<view class="page">
  <view class="hero card">
    <view class="day-switcher">
      <view class="day-btn" bindtap="handlePrevDay">◀</view>
      <view class="day-label">{{activeDateLabel}}</view>
      <view class="day-btn" bindtap="handleNextDay">▶</view>
    </view>
    <view wx:if="{{!isToday}}" class="hero-actions-mini">
      <view class="link-pill" bindtap="handleJumpToday">回到今日</view>
    </view>

    <view class="pet-talk">
      <view class="pet-bubble">
        <text class="pet-bubble-text">{{petMessage}}</text>
      </view>
      <view class="pet-mascot">
        <text class="pet-emoji">{{pet.emoji}}</text>
      </view>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-header">
      <text class="section-title">未完成</text>
      <text wx:if="{{undoneItems.length > 0}}" class="section-count">{{undoneItems.length}}</text>
    </view>

    <view wx:if="{{undoneItems.length === 0}}" class="empty-tip">
      <text class="empty-emoji">{{doneItems.length > 0 ? '🎉' : '📝'}}</text>
      <text class="empty-text">{{doneItems.length > 0 ? '没有未完成的作业，全部搞定！' : (isToday ? '今日没有待办，去「作业本」页新建' : '这一天没有作业')}}</text>
    </view>

    <task-list wx:if="{{undoneItems.length > 0}}"
               items="{{undoneItems}}"
               active-date="{{activeDate}}"
               bind:changed="handleTasksChanged" />
  </view>

  <view wx:if="{{doneItems.length > 0}}" class="card section-card done-section">
    <view class="section-header">
      <text class="section-title">已完成</text>
      <text class="section-count done-count">{{doneItems.length}}</text>
    </view>
    <task-list items="{{doneItems}}"
               active-date="{{activeDate}}"
               enable-drag="{{false}}"
               bind:changed="handleTasksChanged" />
  </view>

  <view wx:if="{{showCongrats}}" class="congrats-overlay" bindtap="handleDismissCongrats">
    <view class="congrats-card" catchtap="">
      <text class="congrats-emoji">🎉</text>
      <text class="congrats-title">Congratulations!</text>
      <text class="congrats-subtitle">今日作业全部完成</text>
      <view class="congrats-stats">
        <text>用时合计 {{totalElapsedDisplay || '—'}}</text>
        <text>+{{(lastReward && lastReward.reward) || 0}} 金币</text>
      </view>
      <button class="congrats-btn" bindtap="handleDismissCongrats">太棒了</button>
    </view>
    <view class="confetti">
      <text class="confetti-piece c1">✨</text>
      <text class="confetti-piece c2">🎊</text>
      <text class="confetti-piece c3">⭐</text>
      <text class="confetti-piece c4">🎉</text>
      <text class="confetti-piece c5">✨</text>
      <text class="confetti-piece c6">🌟</text>
    </view>
  </view>
</view>
