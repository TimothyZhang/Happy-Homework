<view class="page">
  <view class="hero card">
    <view class="hero-top">
      <text class="eyebrow">作业小管家</text>
      <text class="title">今日作业</text>
    </view>

    <block wx:if="{{overview.totalCount > 0 && overview.pendingCount === 0}}">
      <view class="all-done-banner">
        <text class="banner-emoji">🎉</text>
        <text class="banner-title">Congratulations!</text>
        <text class="banner-sub">今日 {{overview.totalCount}} 项作业全部完成</text>
      </view>
    </block>

    <block wx:elif="{{overview.totalCount > 0}}">
      <view class="hero-stats">
        <view class="hero-stat">
          <text class="hero-stat-value">{{overview.totalCount}}</text>
          <text class="hero-stat-label">今日作业</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value highlight">{{overview.pendingCount}}</text>
          <text class="hero-stat-label">待完成</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{remainingMinutesDisplay}}</text>
          <text class="hero-stat-label">预计还需</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="hero-empty">
        <text>还没有今日作业，点下方「新增作业」开始吧</text>
      </view>
    </block>
  </view>

  <view class="card section-card">
    <view class="section-header">
      <text class="section-title">作业列表</text>
      <text class="section-desc">未完成的在前，已完成的在后</text>
    </view>

    <view wx:if="{{sortedTasks.length === 0}}" class="empty-tip">
      <text class="empty-emoji">📝</text>
      <text class="empty-text">还没有今日作业，点下方按钮新增一条吧</text>
    </view>

    <view class="timeline">
      <view wx:for="{{sortedTasks}}" wx:key="id" class="task-item {{item.status}}">
        <view class="timeline-dot"></view>
        <view class="task-main">
          <view class="task-row">
            <text class="task-subject">{{item.subject}}</text>
            <text class="task-status status-{{item.status}}">{{item.statusText}}</text>
          </view>
          <text class="task-content">{{item.content}}</text>
          <view class="task-meta">
            <text wx:if="{{item.planStart && item.planEnd}}">计划 {{item.planStart}} - {{item.planEnd}}</text>
            <text>预计 {{item.estimatedMinutes}} 分钟</text>
          </view>
          <view wx:if="{{item.actualStart || item.actualEnd}}" class="task-actual">
            <text>实际 {{item.actualStart || '--:--'}} - {{item.actualEnd || '--:--'}}</text>
            <text wx:if="{{item.elapsedDisplay}}" class="task-elapsed">{{item.status === 'done' ? '花费' : '已用'}} {{item.elapsedDisplay}}</text>
          </view>
          <view class="task-actions">
            <view wx:if="{{item.status === 'todo'}}" class="icon-btn start-btn" data-id="{{item.id}}" bindtap="handleStartTask" aria-label="开始">▶</view>
            <view wx:if="{{item.status === 'doing'}}" class="icon-btn pause-btn" data-id="{{item.id}}" bindtap="handlePauseTask" aria-label="暂停">❚❚</view>
            <view wx:if="{{item.status === 'paused'}}" class="icon-btn resume-btn" data-id="{{item.id}}" bindtap="handleResumeTask" aria-label="继续">▶</view>
            <view wx:if="{{item.status === 'doing' || item.status === 'paused'}}" class="icon-btn finish-btn" data-id="{{item.id}}" bindtap="handleFinishTask" aria-label="完成">✓</view>
          </view>
        </view>
      </view>
    </view>

    <view class="add-row">
      <button class="add-task-btn" bindtap="handleAddHomework">+ 新增作业</button>
      <button class="edit-task-btn" bindtap="handleManageTasks">✏️ 编辑</button>
      <button class="ocr-task-btn" bindtap="handlePhotoImport">📷 拍照识别</button>
    </view>
  </view>

  <view wx:if="{{showCongrats}}" class="congrats-overlay" bindtap="handleDismissCongrats">
    <view class="congrats-card" catchtap="">
      <text class="congrats-emoji">🎉</text>
      <text class="congrats-title">Congratulations!</text>
      <text class="congrats-subtitle">今日作业全部完成</text>
      <view class="congrats-stats">
        <text>用时合计 {{totalElapsedDisplay || '—'}}</text>
        <text>+{{(lastReward && lastReward.reward) || 0}} 金币</text>
      </view>
      <button class="congrats-btn" bindtap="handleDismissCongrats">太棒了</button>
    </view>
    <view class="confetti">
      <text class="confetti-piece c1">✨</text>
      <text class="confetti-piece c2">🎊</text>
      <text class="confetti-piece c3">⭐</text>
      <text class="confetti-piece c4">🎉</text>
      <text class="confetti-piece c5">✨</text>
      <text class="confetti-piece c6">🌟</text>
    </view>
  </view>
</view>
