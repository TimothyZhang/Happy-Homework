<view class="page">
  <view class="hero card">
    <view class="hero-top">
      <view>
        <text class="eyebrow">作业小管家 Beta</text>
        <text class="title">今晚作业安排好了</text>
      </view>
      <view class="pet-badge">
        <text class="pet-emoji">🐮</text>
        <text class="pet-level">Lv.{{pet.level}}</text>
      </view>
    </view>

    <view class="progress-strip">
      <view>
        <text class="progress-label">今日完成进度</text>
        <text class="progress-value">{{overview.doneCount}} / {{overview.totalCount}} 项，{{overview.progressPercent}}%</text>
      </view>
      <progress percent="{{overview.progressPercent}}" stroke-width="8" activeColor="#245bdb" backgroundColor="#dfe7f5" />
    </view>

    <view class="summary-grid">
      <view class="summary-item highlight">
        <text class="summary-value">{{overview.pendingCount}}</text>
        <text class="summary-label">待完成作业</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{overview.todayCoins}}</text>
        <text class="summary-label">今日金币</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{overview.completedMinutes}}</text>
        <text class="summary-label">已完成分钟</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{overview.streakDays}}</text>
        <text class="summary-label">连续打卡</text>
      </view>
    </view>

    <view class="hero-actions">
      <button class="ghost-btn full-width" bindtap="handlePhotoImport">📷 拍照识别登记本</button>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-header">
      <text class="section-title">今日作业</text>
      <text class="section-desc">未完成的在前，已完成的在后</text>
    </view>

    <view wx:if="{{sortedTasks.length === 0}}" class="empty-tip">
      <text class="empty-emoji">📝</text>
      <text class="empty-text">还没有今日作业，点下方按钮新增一条吧</text>
    </view>

    <view class="timeline">
      <view wx:for="{{sortedTasks}}" wx:key="id" class="task-item {{item.status}}">
        <view class="timeline-dot"></view>
        <view class="task-main">
          <view class="task-row">
            <text class="task-subject">{{item.subject}}</text>
            <text class="task-status status-{{item.status}}">{{item.statusText}}</text>
          </view>
          <text class="task-content">{{item.content}}</text>
          <view class="task-meta">
            <text>计划 {{item.planStart}} - {{item.planEnd}}</text>
            <text>预计 {{item.estimatedMinutes}} 分钟</text>
          </view>
          <view wx:if="{{item.actualStart || item.actualEnd}}" class="task-actual">
            <text>实际 {{item.actualStart || '--:--'}} - {{item.actualEnd || '--:--'}}</text>
            <text wx:if="{{item.elapsedDisplay}}" class="task-elapsed">{{item.status === 'done' ? '花费' : '已用'}} {{item.elapsedDisplay}}</text>
          </view>
          <view class="task-actions">
            <button wx:if="{{item.status === 'todo'}}" size="mini" class="mini-btn start-btn" data-id="{{item.id}}" bindtap="handleStartTask">开始</button>
            <button wx:if="{{item.status === 'doing'}}" size="mini" class="mini-btn pause-btn" data-id="{{item.id}}" bindtap="handlePauseTask">暂停</button>
            <button wx:if="{{item.status === 'paused'}}" size="mini" class="mini-btn resume-btn" data-id="{{item.id}}" bindtap="handleResumeTask">继续</button>
            <button wx:if="{{item.status === 'doing' || item.status === 'paused'}}" size="mini" class="mini-btn finish-btn" data-id="{{item.id}}" bindtap="handleFinishTask">完成</button>
            <button size="mini" class="mini-btn plain-btn" data-id="{{item.id}}" bindtap="handleEditTask">编辑</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{lastReward && lastReward.reward}}" class="card section-card reward-flash-card">
    <view class="section-header">
      <text class="section-title">刚刚获得奖励</text>
      <text class="coin-balance">+{{lastReward.reward}} 金币</text>
    </view>
    <text class="reward-note">{{lastReward.leveledUp ? '宠物刚升了一级，成长反馈已经触发。' : '继续完成下一项，金币和成长值会继续累积。'}}</text>
  </view>

  <view class="card section-card reward-card">
    <view class="section-header">
      <text class="section-title">奖励中心</text>
      <text class="coin-balance">金币 {{coins}}</text>
    </view>

    <view class="reward-rules">
      <view wx:for="{{rewardRules}}" wx:key="title" class="reward-rule">
        <text class="rule-title">{{item.title}}</text>
        <text class="rule-value">+{{item.coins}}</text>
      </view>
    </view>

    <view class="reward-note">今天全部作业完成后，再额外奖励 {{bonusCoins}} 金币。</view>
  </view>

  <view class="card section-card pet-card">
    <view class="section-header">
      <text class="section-title">电子宠物</text>
      <text class="section-desc">坚持写作业，宠物会一起长大</text>
    </view>

    <view class="pet-panel">
      <view class="pet-visual">
        <text class="pet-avatar">{{pet.emoji}}</text>
        <text class="pet-name">{{pet.name}}</text>
        <text class="pet-growth">成长值 {{pet.growth}} / {{pet.nextLevelGrowth}}</text>
      </view>
      <view class="pet-stats">
        <view class="pet-stat">
          <text class="pet-stat-label">开心值</text>
          <progress percent="{{pet.happiness}}" stroke-width="8" activeColor="#ffb648" backgroundColor="#f1f3f5" />
        </view>
        <view class="pet-stat">
          <text class="pet-stat-label">饱腹值</text>
          <progress percent="{{pet.fullness}}" stroke-width="8" activeColor="#07c160" backgroundColor="#f1f3f5" />
        </view>
      </view>
    </view>

    <view class="shop-list">
      <view wx:for="{{shopItems}}" wx:key="id" class="shop-item">
        <view>
          <text class="shop-name">{{item.emoji}} {{item.name}}</text>
          <text class="shop-effect">{{item.effect}}</text>
        </view>
        <button size="mini" class="mini-btn buy-btn" data-id="{{item.id}}" bindtap="handleBuyItem">{{item.price}} 金币</button>
      </view>
    </view>

    <button class="add-task-btn" bindtap="handleAddHomework">+ 新增作业</button>
  </view>

  <view wx:if="{{showCongrats}}" class="congrats-overlay" bindtap="handleDismissCongrats">
    <view class="congrats-card" catchtap="">
      <text class="congrats-emoji">🎉</text>
      <text class="congrats-title">Congratulations!</text>
      <text class="congrats-subtitle">今日作业全部完成</text>
      <view class="congrats-stats">
        <text>用时合计 {{totalElapsedDisplay || '—'}}</text>
        <text>+{{(lastReward && lastReward.reward) || 0}} 金币</text>
      </view>
      <button class="congrats-btn" bindtap="handleDismissCongrats">太棒了</button>
    </view>
    <view class="confetti">
      <text class="confetti-piece c1">✨</text>
      <text class="confetti-piece c2">🎊</text>
      <text class="confetti-piece c3">⭐</text>
      <text class="confetti-piece c4">🎉</text>
      <text class="confetti-piece c5">✨</text>
      <text class="confetti-piece c6">🌟</text>
    </view>
  </view>

  <view class="card section-card social-card">
    <view class="section-header">
      <text class="section-title">轻社交预留</text>
      <text class="section-desc">V2 建议先做鼓励，不做速度羞辱</text>
    </view>
    <view class="social-tags">
      <text class="tag">今日完成分享</text>
      <text class="tag">宠物成长展示</text>
      <text class="tag">连续打卡榜</text>
      <text class="tag disabled">谁写得快（暂不建议）</text>
    </view>
  </view>
</view>