<page-meta disable-scroll="true" />
<view class="page {{isLandscape ? 'is-landscape' : ''}}">
  <view wx:if="{{syncBanner.show}}"
        class="sync-banner {{syncBanner.status}}"
        hover-class="sync-banner-hover"
        bindtap="handleSyncBannerTap">
    <text class="sync-banner-text">{{syncBanner.busy ? t.home_sync_fixing : syncBanner.text}}</text>
  </view>
  <scroll-view scroll-y="{{!disableScroll && !swipeMenuOpen}}"
               class="scroll-area"
               show-scrollbar="{{false}}">
    <view class="home-cols {{isLandscape ? 'is-landscape' : ''}}">
    <view class="home-left">
    <view class="card hero">
      <view class="seg-bar">
        <view class="seg-btn today-seg {{activeSegment === 'today' ? 'active' : ''}}"
              data-seg="today"
              bindtap="handleSegmentTap">{{todayLabel}}</view>
        <view class="seg-btn small-seg {{activeSegment === 'tomorrow' ? 'active' : ''}}"
              data-seg="tomorrow"
              bindtap="handleSegmentTap">{{tomorrowLabel}}</view>
        <view class="seg-btn small-seg {{activeSegment === 'day-after' ? 'active' : ''}}"
              data-seg="day-after"
              bindtap="handleSegmentTap">{{dayAfterLabel}}</view>
        <view class="seg-btn small-seg {{activeSegment === 'calendar' ? 'active' : ''}}"
              data-seg="calendar"
              bindtap="handleSegmentTap">{{calendarLabel}}</view>
      </view>

      <view wx:if="{{calendarOpen}}" class="cal-embed">
        <month-calendar id="cal"
                        value="{{selectedDate}}"
                        bind:change="handleCalendarChange" />
      </view>

      <view class="pet-talk">
        <view class="pet-bubble">
          <text class="pet-bubble-text {{petMessageFading ? 'is-fading' : ''}}">{{petMessage}}</text>
        </view>
        <view class="pet-mascot anim-{{animState}}">
          <image wx:if="{{pet.species}}"
                 class="pet-art"
                 src="/assets/pets/{{pet.species}}.svg"
                 mode="aspectFit" />
          <text wx:else class="pet-emoji">{{pet.emoji || '🐾'}}</text>
        </view>
      </view>

      <view class="bonus-row">
        <view wx:if="{{bonusActive}}" class="bonus-chip bonus-chip--active">
          <text class="bonus-chip__icon">{{bonusIcon}}</text>
          <text class="bonus-chip__label">{{bonusLabel}}</text>
        </view>
        <view wx:elif="{{bonusLabel}}" class="bonus-chip">
          <text class="bonus-chip__label">{{bonusLabel}}</text>
        </view>
        <view wx:else class="bonus-chip-placeholder"></view>
        <view class="bonus-help" bindtap="openRewardRules">
          <text class="bonus-help__q">?</text>
        </view>
      </view>
    </view>
    </view>

    <view class="home-right">
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">{{undoneSectionTitle}}</text>
        <view class="add-task-btn" bindtap="handleAddTask">+</view>
      </view>

      <view wx:if="{{undoneItems.length === 0}}" class="empty-tip">
        <text class="empty-emoji">{{doneItems.length > 0 ? '🎉' : '📝'}}</text>
        <text class="empty-text">{{emptyTipText}}</text>
      </view>

      <task-list wx:if="{{undoneItems.length > 0}}"
                 items="{{undoneItems}}"
                 active-date="{{selectedDate}}"
                 compact="{{isLandscape}}"
                 enable-postpone="{{true}}"
                 bind:dragstart="handleDragStart"
                 bind:dragend="handleDragEnd"
                 bind:swipeopen="handleSwipeOpen"
                 bind:swipeclose="handleSwipeClose"
                 bind:swipestart="handleSwipeStart"
                 bind:swipeend="handleSwipeEnd"
                 bind:postpone="handlePostpone"
                 bind:changed="handleTasksChanged" />
    </view>

    <view wx:if="{{doneItems.length > 0}}" class="card section-card done-section">
      <view class="section-header">
        <text class="section-title">{{doneSectionTitle}}</text>
      </view>
      <task-list items="{{doneItems}}"
                 active-date="{{selectedDate}}"
                 compact="{{isLandscape}}"
                 enable-drag="{{false}}"
                 enable-postpone="{{false}}"
                 bind:swipeopen="handleSwipeOpen"
                 bind:swipeclose="handleSwipeClose"
                 bind:swipestart="handleSwipeStart"
                 bind:swipeend="handleSwipeEnd"
                 bind:changed="handleTasksChanged" />
    </view>

    <view class="home-share-action" bindtap="handleNavigateToShare">
      <text class="home-share-icon">💬</text>
      <text class="home-share-label">{{t.home_share_btn}}</text>
    </view>
    </view>
    </view>
  </scroll-view>

  <reward-toast kind="task"
                visible="{{taskRewardVisible}}"
                coins="{{taskRewardCoins}}"
                subtitle="{{taskRewardCaption}}"
                pet-emoji="{{pet.emoji}}"
                bind:skip="handleSkipTaskReward" />

  <reward-toast kind="allDone"
                visible="{{allDoneVisible}}"
                coins="{{allDoneCoins}}"
                subtitle="{{allDoneSubtitle}}"
                pet-emoji="{{pet.emoji}}"
                bind:skip="handleSkipAllDone" />

  <view wx:if="{{rewardRulesOpen}}" class="rules-mask" bindtap="closeRewardRules" catchtouchmove="noop">
    <view class="rules-sheet" catchtap="noop">
      <view class="rules-title">{{t.home_rules_title}}</view>
      <scroll-view scroll-y="{{true}}" show-scrollbar="{{false}}" class="rules-scroll">

      <view class="rules-subtitle">{{t.home_rules_sub1}}</view>
      <view class="rules-section">
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_makeup}}</text>
          <text class="rules-row__amt">+5</text>
        </view>
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_today_task}}</text>
          <text class="rules-row__amt">+10</text>
        </view>
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_future_task}}</text>
          <text class="rules-row__amt">+15</text>
        </view>
      </view>

      <view class="rules-hint">{{t.home_rules_cap_hint}}</view>

      <view class="rules-divider"></view>

      <view class="rules-subtitle">{{t.home_rules_sub2}}</view>
      <view class="rules-section">
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_perfect}}</text>
          <text class="rules-row__amt">{{t.home_rules_perfect_amt}}</text>
        </view>
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_streak}}</text>
          <text class="rules-row__amt">+100</text>
        </view>
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_share_saved}}</text>
          <text class="rules-row__amt">{{t.home_rules_share_saved_amt}}</text>
        </view>
      </view>

      <view class="rules-divider"></view>

      <view class="rules-subtitle">{{t.home_rules_sub3}}</view>
      <view class="rules-section">
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_early19}}</text>
          <text class="rules-row__amt">+50</text>
        </view>
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_early20}}</text>
          <text class="rules-row__amt">+30</text>
        </view>
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_early21}}</text>
          <text class="rules-row__amt">+20</text>
        </view>
        <view class="rules-row">
          <text class="rules-row__name">{{t.home_rules_early_late}}</text>
          <text class="rules-row__amt">+0</text>
        </view>
      </view>

      <view class="rules-hint">{{t.home_rules_example}}</view>
      </scroll-view>

      <view class="rules-close" bindtap="closeRewardRules">{{t.home_rules_got_it}}</view>
    </view>
  </view>

  <!-- 作业卡片左右滑改日期:一次性新手引导 -->
  <view wx:if="{{showSwipeGuide}}" class="sg-mask" bindtap="dismissSwipeGuide" catchtouchmove="noop">
    <view class="sg-panel" catchtap="noop">
      <view class="sg-title">{{t.home_sg_title}}</view>
      <view class="sg-stage">
        <text class="sg-day">{{t.home_sg_prev}}</text>
        <view class="sg-card">
          <view class="sg-line"></view>
          <view class="sg-line short"></view>
          <text class="sg-hand">👆</text>
        </view>
        <text class="sg-day">{{t.home_sg_next}}</text>
      </view>
      <view class="sg-legend">
        <text>{{t.home_sg_left}}</text>
        <text>{{t.home_sg_right}}</text>
      </view>
      <view class="sg-note">{{t.home_sg_note}}</view>
      <view class="sg-btn" catchtap="dismissSwipeGuide">{{t.home_sg_got_it}}</view>
    </view>
  </view>
</view>
