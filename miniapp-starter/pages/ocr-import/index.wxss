.upload-card,
.tips-card {
  margin-top: 24rpx;
}

.tab-bar {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  background: #eef4ff;
  border-radius: 18rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #5f6b7a;
  font-weight: 500;
}

.tab-btn.active {
  background: #ffffff;
  color: #245bdb;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 219, 0.12);
}

.preview-box,
.empty-box {
  margin-top: 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  background: #f8fafc;
  border: 2rpx dashed #d7deea;
}

.preview-image {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.preview-note,
.empty-desc {
  display: block;
  margin-top: 16rpx;
  color: #6b7785;
  font-size: 24rpx;
  word-break: break-all;
}

.empty-box {
  text-align: center;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-row button {
  flex: 1;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tip-dot {
  color: #245bdb;
  font-weight: 700;
}

.tip-text {
  flex: 1;
  color: #495463;
  line-height: 1.7;
  font-size: 26rpx;
}

.bottom-bar {
  margin-top: 24rpx;
}

/* WeChat <button> defaults to ~80% width with side margins; force full
   width so 「开始识别」 spans the card edge-to-edge like other primary CTAs. */
.bottom-bar .save-btn {
  width: 100%;
  margin: 0;
}

/* OCR 识别等待遮罩 + 进度 */
.ocr-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.45);
}

.ocr-overlay-card {
  width: 540rpx;
  padding: 48rpx 40rpx 40rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 48rpx rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ocr-spinner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 8rpx solid #e6edff;
  border-top-color: #245bdb;
  animation: ocr-spin 0.8s linear infinite;
}

@keyframes ocr-spin {
  to {
    transform: rotate(360deg);
  }
}

.ocr-progress-num {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.ocr-progress-bar {
  width: 100%;
  height: 14rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #eef2f8;
  overflow: hidden;
}

.ocr-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4f80ff, #245bdb);
  transition: width 0.4s ease;
}

.ocr-stage {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3a4b;
}

.ocr-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a96a3;
}
