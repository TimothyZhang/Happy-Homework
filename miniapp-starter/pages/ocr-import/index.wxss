.upload-card,
.tips-card {
  margin-top: 24rpx;
}

.preview-box,
.empty-box {
  margin-top: 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  background: #f8fafc;
  border: 2rpx dashed #d7deea;
}

.preview-image {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.preview-note,
.empty-desc {
  display: block;
  margin-top: 16rpx;
  color: #6b7785;
  font-size: 24rpx;
  word-break: break-all;
}

.empty-box {
  text-align: center;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-row button {
  flex: 1;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tip-dot {
  color: #245bdb;
  font-weight: 700;
}

.tip-text {
  flex: 1;
  color: #495463;
  line-height: 1.7;
  font-size: 26rpx;
}

.bottom-bar {
  margin-top: 24rpx;
}

/* WeChat <button> defaults to ~80% width with side margins; force full
   width so 「开始识别」 spans the card edge-to-edge like other primary CTAs. */
.bottom-bar .save-btn {
  width: 100%;
  margin: 0;
}
