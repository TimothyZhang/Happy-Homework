.hero-card {
  gap: 16rpx;
}

.eyebrow {
  font-size: 24rpx;
  color: #245bdb;
  font-weight: 600;
}

.title {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #182433;
}

.desc {
  display: block;
  margin-top: 12rpx;
  color: #5b6574;
  line-height: 1.7;
  font-size: 26rpx;
}

.upload-card,
.tips-card {
  margin-top: 24rpx;
}

.preview-box,
.empty-box {
  margin-top: 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  background: #f8fafc;
  border: 2rpx dashed #d7deea;
}

.preview-image {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.mock-preview {
  height: 360rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f7faff 0%, #eef4ff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mock-preview-icon {
  font-size: 72rpx;
}

.mock-preview-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #44505e;
}

.preview-note,
.empty-desc {
  display: block;
  margin-top: 16rpx;
  color: #6b7785;
  font-size: 24rpx;
  word-break: break-all;
}

.empty-box {
  text-align: center;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-row button {
  flex: 1;
}

.link-btn {
  margin-top: 20rpx;
  color: #245bdb;
  background: transparent;
  font-size: 26rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tip-dot {
  color: #245bdb;
  font-weight: 700;
}

.tip-text {
  flex: 1;
  color: #495463;
  line-height: 1.7;
  font-size: 26rpx;
}

.bottom-bar {
  margin-top: 24rpx;
}
