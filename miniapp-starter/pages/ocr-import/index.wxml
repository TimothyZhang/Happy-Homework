<view class="page">
  <view class="tab-bar">
    <view class="tab-btn" bindtap="handleSwitchToTaskEdit">新增作业</view>
    <view class="tab-btn active">拍照识别</view>
  </view>

  <view class="card upload-card">
    <view class="section-header">
      <text class="section-title">1. 选择登记本照片</text>
      <text class="subtle">建议只拍单页</text>
    </view>

    <view wx:if="{{imagePath}}" class="preview-box">
      <image class="preview-image" src="{{imagePath}}" mode="aspectFit" />
      <text class="preview-note">已选图片：{{imagePath}}</text>
    </view>
    <view wx:else class="empty-box">
      <text class="empty-icon">📝</text>
      <text class="empty-title">还没有选择图片</text>
      <text class="empty-desc">可以直接拍照，也可以从相册导入</text>
    </view>

    <view class="action-row">
      <button class="primary-btn" bindtap="handleTakePhoto">拍照</button>
      <button class="ghost-btn" bindtap="handleChooseFromAlbum">相册导入</button>
    </view>
  </view>

  <view class="card tips-card">
    <view class="section-header">
      <text class="section-title">2. 拍摄建议</text>
      <text class="subtle">提高识别成功率</text>
    </view>

    <view wx:for="{{tips}}" wx:key="*this" class="tip-item">
      <text class="tip-dot">•</text>
      <text class="tip-text">{{item}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="save-btn" loading="{{isRecognizing}}" bindtap="handleStartRecognize">开始识别</button>
  </view>

  <view wx:if="{{isRecognizing}}" class="ocr-overlay">
    <view class="ocr-overlay-card">
      <view class="ocr-spinner"></view>
      <view class="ocr-progress-num">{{ocrProgress}}%</view>
      <view class="ocr-progress-bar">
        <view class="ocr-progress-fill" style="width: {{ocrProgress}}%;"></view>
      </view>
      <view class="ocr-stage">{{ocrStage}}</view>
      <view wx:if="{{ocrHint}}" class="ocr-hint">{{ocrHint}}</view>
    </view>
  </view>
</view>
