<view class="page">
  <view class="tab-bar">
    <view class="tab-btn" bindtap="handleSwitchToTaskEdit">{{t.ocrimp_tab_new}}</view>
    <view class="tab-btn active">{{t.ocrimp_tab_photo}}</view>
  </view>

  <view class="card upload-card">
    <view class="section-header">
      <text class="section-title">{{t.ocrimp_sec_choose}}</text>
      <text class="subtle">{{t.ocrimp_sec_choose_sub}}</text>
    </view>

    <view wx:if="{{imagePath}}" class="preview-box">
      <image class="preview-image" src="{{imagePath}}" mode="aspectFit" />
      <text class="preview-note">{{previewNote}}</text>
    </view>
    <view wx:else class="empty-box">
      <text class="empty-icon">📝</text>
      <text class="empty-title">{{t.ocrimp_empty_title}}</text>
      <text class="empty-desc">{{t.ocrimp_empty_desc}}</text>
    </view>

    <view class="action-row">
      <button class="primary-btn" bindtap="handleTakePhoto">{{t.ocrimp_btn_photo}}</button>
      <button class="ghost-btn" bindtap="handleChooseFromAlbum">{{t.ocrimp_btn_album}}</button>
    </view>
  </view>

  <view class="card tips-card">
    <view class="section-header">
      <text class="section-title">{{t.ocrimp_sec_tips}}</text>
      <text class="subtle">{{t.ocrimp_sec_tips_sub}}</text>
    </view>

    <view wx:for="{{tips}}" wx:key="*this" class="tip-item">
      <text class="tip-dot">•</text>
      <text class="tip-text">{{item}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="save-btn" loading="{{isRecognizing}}" bindtap="handleStartRecognize">{{t.ocrimp_btn_start}}</button>
  </view>

  <view wx:if="{{isRecognizing}}" class="ocr-overlay">
    <view class="ocr-overlay-card">
      <view class="ocr-spinner"></view>
      <view class="ocr-progress-num">{{ocrProgress}}%</view>
      <view class="ocr-progress-bar">
        <view class="ocr-progress-fill" style="width: {{ocrProgress}}%;"></view>
      </view>
      <view class="ocr-stage">{{ocrStage}}</view>
      <view wx:if="{{ocrHint}}" class="ocr-hint">{{ocrHint}}</view>
    </view>
  </view>
</view>
