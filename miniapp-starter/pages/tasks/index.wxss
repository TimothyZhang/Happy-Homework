.header-card {
  position: relative;
  /* Card now hosts only the "+ 新建作业本" CTA — drop horizontal padding so
     the button can stretch wall-to-wall, and bump vertical padding so it
     still looks like a chunky banner. */
  padding: 32rpx 28rpx;
}

.add-nb-btn {
  width: 100%;
  margin: 0;
  padding: 24rpx 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 219, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}

.empty-state {
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-emoji {
  display: block;
  font-size: 72rpx;
}

.empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7785;
}

.link-btn {
  font-size: 26rpx;
  color: #245bdb;
}

/* === notebook card === */
.notebook-card {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.06);
}

/* Fully-done one-shot notebooks: desaturate so finished items recede.
   Recurring notebooks intentionally never get this class — they recur. */
.notebook-card.all-done {
  filter: grayscale(0.7);
  opacity: 0.55;
}

/* The 「今日」 chip below already conveys "active today"; no extra border. */

.nb-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.nb-body {
  flex: 1;
  min-width: 0;
}

.nb-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nb-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.nb-mode {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.mode-one-shot {
  background: #fef3c7;
  color: #92400e;
}

.mode-recurring {
  background: #ddeafd;
  color: #1546b5;
}

.nb-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: #f7f8fa;
  color: #5f6b7a;
  white-space: nowrap;
}

.subject-chip {
  background: #eef4ff;
  color: #245bdb;
  font-weight: 600;
}

.rec-chip {
  background: #f0e9ff;
  color: #6c3fdb;
}

.range-chip {
  background: #f3f6fa;
  color: #6b7785;
}

.today-chip {
  background: #e8f7ee;
  color: #067647;
  font-weight: 700;
}

.nb-progress {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  background: #edf0f3;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #245bdb 0%, #07c160 100%);
  border-radius: 999rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #6b7785;
  white-space: nowrap;
}

.nb-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.edit-btn { background: #eef4ff; }
.del-btn { background: #fff1f0; }

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}
