<page-meta page-style="{{dragId ? 'overflow: hidden;' : ''}}" />
<view class="page">
  <view class="card header-card">
    <view class="section-header">
      <text class="section-title">作业本</text>
      <text class="link-btn" bindtap="handleViewCalendar">📅 日历</text>
    </view>
    <view class="header-actions">
      <button class="primary-btn" bindtap="handleAddNotebook">+ 新建作业本</button>
      <button class="ghost-btn" open-type="share">📤 分享</button>
      <button class="ghost-btn" bindtap="handleCopyToClipboard">📋 复制</button>
    </view>
  </view>

  <view wx:if="{{notebooks.length === 0}}" class="card">
    <view class="empty-state">
      <text class="empty-emoji">📒</text>
      <text class="empty-text">还没有作业本，点上方「+ 新建作业本」开始吧</text>
    </view>
  </view>

  <view wx:for="{{notebooks}}" wx:key="id"
        class="notebook-card {{dragId === item.id ? 'is-dragging' : ''}} {{item.activeToday ? 'active-today' : ''}}"
        style="{{dragId === item.id ? 'transform: translateY(' + dragDy + 'px); z-index: 10;' : (item.shiftY ? 'transform: translateY(' + item.shiftY + 'px);' : '')}}"
        bindlongpress="handleLongPress"
        catchtouchmove="handleTouchMove"
        catchtouchend="handleTouchEnd"
        catchtouchcancel="handleTouchEnd"
        data-id="{{item.id}}"
        bindtap="handleOpenNotebook">
    <view class="nb-row">
      <view class="nb-body">
        <view class="nb-title-row">
          <text class="nb-name">{{item.name}}</text>
          <text class="nb-mode mode-{{item.mode}}">{{item.modeLabel}}</text>
        </view>
        <view class="nb-chips">
          <text wx:for="{{item.subjects}}" wx:for-item="subj" wx:key="*this" class="chip subject-chip">{{subj}}</text>
          <text wx:if="{{item.recurrenceLabel}}" class="chip rec-chip">{{item.recurrenceLabel}}</text>
          <text class="chip range-chip">{{item.rangeLabel}}</text>
          <text wx:if="{{item.activeToday}}" class="chip today-chip">今日</text>
        </view>
        <view class="nb-progress">
          <view class="progress-track">
            <view class="progress-fill" style="width: {{item.progressPercent}}%"></view>
          </view>
          <text class="progress-text">{{item.doneCount}} / {{item.taskCount}}</text>
        </view>
      </view>
      <view class="nb-actions" catchtap="">
        <view class="icon-btn edit-btn" data-id="{{item.id}}" catchtap="handleEditNotebook">✏️</view>
        <view class="icon-btn del-btn" data-id="{{item.id}}" catchtap="handleDeleteNotebook">🗑</view>
      </view>
    </view>
  </view>
</view>
