<view class="page">
  <view class="card header-card">
    <button class="primary-btn add-nb-btn" bindtap="handleAddTask">{{t.tasks_add_btn}}</button>
    <view class="toolbar-row">
      <view class="seg-group">
        <text>{{t.tasks_group_label}}</text>
        <text wx:for="{{GROUP_MODES}}" wx:key="key"
              class="seg-btn {{groupMode === item.key ? 'active' : ''}}"
              data-key="{{item.key}}"
              bindtap="handleGroupChange">{{item.label}}</text>
      </view>
      <view class="seg-group">
        <text>{{t.tasks_filter_label}}</text>
        <text wx:for="{{FILTER_MODES}}" wx:key="key"
              class="seg-btn {{filterMode === item.key ? 'active' : ''}}"
              data-key="{{item.key}}"
              bindtap="handleFilterChange">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{totalCount === 0}}" class="card">
    <view class="empty-state">
      <text class="empty-emoji">📝</text>
      <text class="empty-text">{{t.tasks_empty}}</text>
    </view>
  </view>

  <!-- 分组视图 -->
  <block wx:if="{{groupMode !== 'none'}}">
    <view wx:for="{{groups}}" wx:for-item="grp" wx:key="key" class="group-block">
      <view class="group-title">
        <text class="group-label">{{grp.label}}</text>
        <text class="group-count">{{grp.tasks.length}}</text>
      </view>
      <view wx:for="{{grp.tasks}}" wx:key="id" wx:for-item="task"
            class="task-card {{task.cleared ? 'all-done' : ''}} {{task.activeToday ? 'active-today' : ''}}"
            data-id="{{task.id}}"
            bindtap="handleEditTask">
        <view class="nb-row">
          <view class="nb-body">
            <view class="nb-title-row">
              <text class="nb-name">{{task.content}}</text>
              <text class="nb-mode mode-{{task.mode}}">{{task.modeLabel}}</text>
            </view>
            <view class="nb-chips">
              <text wx:if="{{task.subject}}" class="chip rec-chip">{{task.subject}}</text>
              <text class="chip range-chip">{{task.organization}}</text>
              <text class="chip range-chip">{{task.scheduleLabel}}</text>
              <text wx:if="{{task.activeToday}}" class="chip today-chip">{{t.tasks_chip_today}}</text>
              <text wx:if="{{task.doneToday}}" class="chip today-chip">{{t.tasks_chip_done}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 平铺视图 -->
  <block wx:if="{{groupMode === 'none'}}">
    <view wx:for="{{flatList}}" wx:key="id"
          class="task-card {{item.cleared ? 'all-done' : ''}} {{item.activeToday ? 'active-today' : ''}}"
          data-id="{{item.id}}"
          bindtap="handleEditTask">
      <view class="nb-row">
        <view class="nb-body">
          <view class="nb-title-row">
            <text class="nb-name">{{item.content}}</text>
            <text class="nb-mode mode-{{item.mode}}">{{item.modeLabel}}</text>
          </view>
          <view class="nb-chips">
            <text wx:if="{{item.subject}}" class="chip rec-chip">{{item.subject}}</text>
            <text class="chip range-chip">{{item.organization}}</text>
            <text class="chip range-chip">{{item.scheduleLabel}}</text>
            <text wx:if="{{item.activeToday}}" class="chip today-chip">{{t.tasks_chip_today}}</text>
            <text wx:if="{{item.doneToday}}" class="chip today-chip">{{t.tasks_chip_done}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
