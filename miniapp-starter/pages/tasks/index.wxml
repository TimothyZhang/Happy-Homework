<view class="page">
  <view class="card header-card">
    <view class="section-header">
      <text class="section-title">今日作业</text>
      <text class="tag">已完成 {{doneCount}} / {{tasks.length}}</text>
    </view>
    <view class="header-actions">
      <button class="primary-btn" bindtap="handleShowAdd">+ 新增作业</button>
      <button class="ghost-btn" open-type="share">📤 分享</button>
      <button class="ghost-btn" bindtap="handleCopyToClipboard">📋 复制</button>
    </view>
  </view>

  <view wx:if="{{groupedTasks.length === 0}}" class="card">
    <view class="empty-state">
      <text class="empty-emoji">📝</text>
      <text class="empty-text">还没有今日作业，点上方按钮新增一条吧</text>
    </view>
  </view>

  <view wx:for="{{groupedTasks}}" wx:for-item="group" wx:key="subject" class="card group-card">
    <view class="subject-header">
      <text class="subject-label">{{group.subject}}</text>
      <text class="subject-count">{{group.tasks.length}} 项</text>
    </view>
    <view wx:for="{{group.tasks}}" wx:for-item="item" wx:key="id"
          class="mgmt-task {{item.status}} {{dragId === item.id ? 'is-dragging' : ''}}"
          style="{{dragId === item.id ? 'transform: translateY(' + dragDy + 'px); z-index: 10;' : ''}}"
          bindlongpress="handleLongPress"
          bindtouchmove="handleTouchMove"
          bindtouchend="handleTouchEnd"
          bindtouchcancel="handleTouchEnd"
          data-id="{{item.id}}"
          data-subject="{{group.subject}}">
      <view class="mgmt-body">
        <text class="mgmt-content">{{item.content}}</text>
        <view class="mgmt-chips">
          <text class="chip est-chip">预计 {{item.estimatedMinutes}} 分钟</text>
          <text wx:if="{{item.status === 'done'}}" class="chip done-chip">已完成</text>
          <text wx:elif="{{item.status === 'doing'}}" class="chip doing-chip">进行中</text>
          <text wx:elif="{{item.status === 'paused'}}" class="chip paused-chip">已暂停</text>
        </view>
      </view>
      <view class="mgmt-actions">
        <view class="icon-btn edit-btn" data-id="{{item.id}}" catchtap="handleEditTask">✏️</view>
        <view class="icon-btn del-btn" data-id="{{item.id}}" catchtap="handleDeleteTask">🗑</view>
      </view>
    </view>
  </view>

  <view wx:if="{{formVisible || editingId}}" class="card form-card">
    <view class="section-header">
      <text class="section-title">{{editingId ? '编辑作业' : '新增作业'}}</text>
      <text class="link-btn" bindtap="handleHideForm">取消</text>
    </view>

    <view class="field">
      <text class="field-label">科目</text>
      <picker mode="selector" range="{{subjectOptions}}" bindchange="handleSubjectChange">
        <view class="picker">{{form.subject || '请选择科目'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">作业内容</text>
      <textarea class="input textarea" placeholder="例如：完成口算练习 2 页" value="{{form.content}}" bindinput="handleContentInput"></textarea>
    </view>

    <view class="field">
      <text class="field-label">预计耗时（分钟）</text>
      <input class="input" type="number" placeholder="例如：20" value="{{form.estimatedMinutes}}" bindinput="handleMinutesInput" />
    </view>

    <button class="save-btn" bindtap="handleSaveTask">{{editingId ? '保存修改' : '保存这项作业'}}</button>
  </view>
</view>
