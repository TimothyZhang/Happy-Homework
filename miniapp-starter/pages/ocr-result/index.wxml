<view class="page">
  <view class="card result-hero">
    <view class="section-header">
      <text class="section-title">识别结果</text>
      <text class="subtle">先自动拆分，再人工校对</text>
    </view>

    <view wx:if="{{sourceLabel}}" class="source-tag">识别通道：{{sourceLabel}}</view>
    <view wx:if="{{providerWarning}}" class="provider-warning">⚠️ {{providerWarning}}</view>

    <image wx:if="{{imagePath}}" class="result-image" src="{{imagePath}}" mode="aspectFit" />
    <text class="raw-title">OCR 原始文本</text>
    <text class="raw-text">{{rawText}}</text>
  </view>

  <view class="card drafts-card">
    <view class="section-header">
      <text class="section-title">作业草稿列表</text>
      <text class="tag">共 {{drafts.length}} 条</text>
    </view>

    <view class="drafts-meta">
      <view class="field field-inline">
        <text class="field-label">组织（全部）</text>
        <picker class="field-control" mode="selector" range="{{organizationOptions}}" value="{{organizationIndex}}" bindchange="handleOrganizationChange">
          <view class="picker draft-picker">{{organization}}</view>
        </picker>
      </view>
    </view>

    <view wx:for="{{drafts}}" wx:key="id" class="draft-card">
      <view class="draft-top">
        <text class="draft-index">作业 {{index + 1}}</text>
        <view class="draft-top-actions">
          <text class="confidence confidence-{{item.confidenceClass || 'low'}}">{{item.confidence}}置信度</text>
          <text class="delete-link" data-index="{{index}}" bindtap="handleDeleteDraft">删除</text>
        </view>
      </view>

      <view class="field field-inline">
        <text class="field-label">科目</text>
        <picker class="field-control" mode="selector" range="{{subjectOptions}}" value="{{item.subject ? subjectOptions.indexOf(item.subject) : 0}}" data-index="{{index}}" bindchange="handleSubjectChange">
          <view class="picker draft-picker">{{item.subject || '未识别，点此选择'}}</view>
        </picker>
      </view>

      <view class="field field-inline">
        <text class="field-label">日期</text>
        <picker class="field-control" mode="date" value="{{item.dueDate}}" data-index="{{index}}" bindchange="handleDueDateChange">
          <view class="picker draft-picker">{{item.dueDate}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">作业内容</text>
        <textarea class="input textarea draft-textarea" value="{{item.content}}" data-index="{{index}}" bindinput="handleContentInput" placeholder="补全或修正识别内容" auto-height></textarea>
      </view>

      <view wx:if="{{item.rawText}}" class="raw-fragment">
        <text class="fragment-label">原始片段</text>
        <text class="fragment-text">{{item.rawText}}</text>
      </view>
    </view>

    <button class="plain-add-btn" bindtap="handleAddDraft">+ 手动补一条作业</button>
  </view>

  <view class="bottom-bar">
    <button class="save-btn" bindtap="handleImportTasks">确认并导入今日作业</button>
  </view>
</view>
