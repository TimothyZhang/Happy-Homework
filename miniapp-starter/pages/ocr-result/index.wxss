.result-hero,
.drafts-card {
  margin-bottom: 24rpx;
}

.source-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #245bdb;
  background: #edf2ff;
  border-radius: 999rpx;
}

.provider-warning {
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 24rpx;
  color: #d48806;
  background: #fff7e6;
  border-radius: 16rpx;
}

.result-image {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  margin-top: 20rpx;
  background: #f8fafc;
}

.raw-title {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #44505e;
  font-weight: 600;
}

.raw-text {
  display: block;
  margin-top: 12rpx;
  white-space: pre-wrap;
  line-height: 1.8;
  color: #5d6776;
  font-size: 26rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 20rpx;
}

.draft-card {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.draft-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.draft-top-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.draft-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.confidence {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.confidence-high {
  background: #f6ffed;
  color: #389e0d;
}

.confidence-medium {
  background: #fff7e6;
  color: #d48806;
}

.confidence-low {
  background: #fff1f0;
  color: #cf1322;
}

.delete-link {
  font-size: 24rpx;
  color: #b85450;
  padding: 4rpx 8rpx;
}

.field {
  margin-top: 12rpx;
}

.field + .field {
  margin-top: 12rpx;
}

.field-inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-inline .field-label {
  flex: none;
}

.field-inline .field-control {
  flex: 1;
}

.draft-picker {
  margin-top: 0;
  min-height: 64rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.draft-textarea {
  min-height: 64rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.raw-fragment {
  margin-top: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.fragment-label {
  font-size: 22rpx;
  color: #7b8794;
}

.fragment-text {
  display: block;
  margin-top: 4rpx;
  color: #44505e;
  line-height: 1.5;
  font-size: 24rpx;
}

.plain-add-btn {
  margin-top: 20rpx;
  background: #edf2ff;
  color: #245bdb;
}
