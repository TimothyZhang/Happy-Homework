.page {
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
}

/* === Sync card === */

.sync-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.sync-pill.healthy { background: #e8f7ee; color: #067647; }
.sync-pill.readonly { background: #fff5e6; color: #b26a00; }
.sync-pill.error { background: #fff1f0; color: #e54545; }
.sync-pill.unknown { background: #edf0f3; color: #5f6b7a; }

.sync-meta {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sync-meta-line {
  font-size: 24rpx;
  color: #6b7785;
  line-height: 1.5;
  word-break: break-all;
}
.sync-meta-line.warn { color: #b26a00; }
.sync-meta-line.err { color: #e54545; }

.sync-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.sync-btn {
  flex: 1;
  height: 76rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  line-height: 1;
}
.sync-btn.primary {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(36, 91, 219, 0.22);
}
.sync-btn.ghost {
  background: #eef4ff;
  color: #245bdb;
}
.sync-btn[disabled] { opacity: 0.6; }
