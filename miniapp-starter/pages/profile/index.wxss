.page {
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
}

/* === Profile card === */

.profile-card {
  margin-bottom: 24rpx;
}

.profile-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #eef4ff;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(36, 91, 219, 0.12);
}
.avatar-wrap.is-loading { opacity: 0.7; }
.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #245bdb;
}
.avatar-placeholder-icon {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}
.avatar-placeholder-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7785;
}
.avatar-loading-mask {
  position: absolute;
  inset: 0;
  background: rgba(31, 35, 41, 0.42);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-fields {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.profile-fields .field-label {
  margin-bottom: 4rpx;
}
.nickname-input {
  margin-top: 4rpx;
}
.profile-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a4;
}

/* === Sync card === */

.sync-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.sync-pill.healthy { background: #e8f7ee; color: #067647; }
.sync-pill.readonly { background: #fff5e6; color: #b26a00; }
.sync-pill.error { background: #fff1f0; color: #e54545; }
.sync-pill.unknown { background: #edf0f3; color: #5f6b7a; }

.sync-meta {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sync-meta-line {
  font-size: 24rpx;
  color: #6b7785;
  line-height: 1.5;
  word-break: break-all;
}
.sync-meta-line.warn { color: #b26a00; }
.sync-meta-line.err { color: #e54545; }

.sync-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.sync-btn {
  flex: 1;
  height: 76rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  line-height: 1;
}
.sync-btn.primary {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(36, 91, 219, 0.22);
}
.sync-btn.ghost {
  background: #eef4ff;
  color: #245bdb;
}
.sync-btn[disabled] { opacity: 0.6; }

/* === Organization tags === */

.org-card {
  margin-top: 24rpx;
}
.org-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7785;
  background: #eef0f3;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.org-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a94a4;
  line-height: 1.5;
}
.org-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.org-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #f7f9fc;
  border-radius: 14rpx;
  gap: 16rpx;
}
.org-name {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
  word-break: break-all;
}
.org-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.org-btn {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1;
}
.org-btn.ghost {
  background: #eef4ff;
  color: #245bdb;
}
.org-btn.danger {
  background: #fff1f0;
  color: #e54545;
}

.org-add {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}
.org-input {
  flex: 1;
  min-width: 0;
}
.org-add-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  margin: 0;
  border: none;
}
.org-add-btn::after { border: none; }

.org-reset {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a94a4;
  padding: 12rpx 0;
}

/* === Admin entry === */

.admin-card {
  margin-top: 24rpx;
}
.admin-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.admin-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}
.admin-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.admin-hint {
  font-size: 24rpx;
  color: #6b7785;
}
.admin-arrow {
  font-size: 40rpx;
  color: #c1c8d2;
  line-height: 1;
}

/* === Openid debug card === */

.openid-card {
  margin-top: 24rpx;
}
.openid-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #fff5e6;
  color: #b26a00;
}
.openid-badge.admin {
  background: #e8f7ee;
  color: #067647;
}
.openid-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #f7f9fc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.openid-value {
  flex: 1;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #1f2329;
  word-break: break-all;
  line-height: 1.5;
}
.openid-value.selectable {
  user-select: text;
}
.openid-copy {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #245bdb;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}
.openid-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #6b7785;
  line-height: 1.6;
}

.build-info {
  margin: 36rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.build-info-line {
  font-size: 22rpx;
  color: #8a96a6;
  font-family: -apple-system, "SF Mono", Menlo, monospace;
}

.build-info-line.dim {
  color: #b4bdc9;
  font-size: 20rpx;
}

/* 我的单词本入口卡片 */
.wb-entry-card { display: flex; align-items: center; margin-bottom: 24rpx; }
.wb-entry-hover { background: #f5f8ff; }
.wb-entry-emoji { font-size: 48rpx; margin-right: 18rpx; }
.wb-entry-text { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.wb-entry-title { font-size: 30rpx; font-weight: 700; color: #1f2329; }
.wb-entry-sub { margin-top: 6rpx; font-size: 22rpx; color: #8a94a0; }
.wb-entry-chev { color: #c7cdd6; font-size: 36rpx; flex-shrink: 0; }
