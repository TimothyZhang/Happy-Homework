<view class="page">
  <view class="card profile-card">
    <view class="profile-card-head">
      <text class="edit-toggle {{editingProfile ? 'done' : ''}}" bindtap="toggleEditProfile">{{editingProfile ? t.prof_done : t.prof_edit}}</text>
    </view>

    <view class="profile-row">
      <view class="avatar-wrap {{uploadingAvatar ? 'is-loading' : ''}} {{editingProfile ? 'editable' : ''}}" bindtap="handleAvatarTap">
        <image wx:if="{{profile.avatar}}"
               class="avatar-img"
               src="{{profile.avatar}}"
               mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-placeholder-icon">+</text>
          <text class="avatar-placeholder-hint">{{t.prof_avatar}}</text>
        </view>
        <view wx:if="{{editingProfile && profile.avatar}}" class="avatar-edit-badge">{{t.prof_change}}</view>
        <view wx:if="{{uploadingAvatar}}" class="avatar-loading-mask">{{t.prof_uploading}}</view>
      </view>

      <view class="profile-fields">
        <input wx:if="{{editingProfile}}"
               class="input nickname-input"
               type="nickname"
               placeholder="{{t.prof_noNick}}"
               maxlength="12"
               value="{{profile.nickname}}"
               bindinput="handleNicknameInput"
               bindblur="handleNicknameBlur" />
        <text wx:else class="nickname-text">{{profile.nickname || t.prof_noNick}}</text>
      </view>
    </view>
  </view>

  <view class="card wb-entry-card" bindtap="goWordBooks" hover-class="wb-entry-hover">
    <text class="wb-entry-emoji">📚</text>
    <view class="wb-entry-text">
      <text class="wb-entry-title">{{t.prof_wbTitle}}</text>
      <text class="wb-entry-sub">{{t.prof_wbSub}}</text>
    </view>
    <text class="wb-entry-chev">›</text>
  </view>

  <view class="card wb-entry-card" bindtap="goSettings" hover-class="wb-entry-hover">
    <text class="wb-entry-emoji">⚙️</text>
    <view class="wb-entry-text">
      <text class="wb-entry-title">{{t.prof_settings}}</text>
      <text class="wb-entry-sub">{{t.prof_settingsSub}}</text>
    </view>
    <text class="wb-entry-chev">›</text>
  </view>

  <view wx:if="{{isAdmin}}" class="card admin-card" bindtap="handleOpenAdmin">
    <view class="admin-row">
      <view class="admin-text">
        <text class="admin-title">{{t.prof_admin}}</text>
        <text class="admin-hint">{{t.prof_adminSub}}</text>
      </view>
      <text class="admin-arrow">›</text>
    </view>
  </view>

  <view class="build-info">
    <text class="build-info-line">{{t.prof_version}} {{buildVersion}}</text>
    <text class="build-info-line dim">commit {{buildCommitId}}</text>
  </view>
</view>
