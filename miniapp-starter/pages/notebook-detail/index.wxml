<page-meta page-style="{{dragId ? 'overflow: hidden;' : ''}}" />
<view class="page">
  <view class="card header-card">
    <text class="nb-summary">{{notebookSummary}}</text>
  </view>

  <view wx:if="{{tasks.length === 0}}" class="card">
    <view class="empty-state">
      <text class="empty-emoji">📝</text>
      <text class="empty-text">作业本里还没有作业，点下方「+ 新增作业」添加吧</text>
    </view>
  </view>

  <block wx:for="{{tasks}}" wx:key="id">
    <view wx:if="{{item.firstOfSubject}}" class="subject-header">{{item.subject}}</view>
    <view class="task-row {{item.status}} {{dragId === item.id ? 'is-dragging' : ''}}"
          style="{{dragId === item.id ? 'transform: translateY(' + dragDy + 'px); z-index: 10;' : (item.shiftY ? 'transform: translateY(' + item.shiftY + 'px);' : '')}}"
          bindtouchstart="handleTouchStart"
          bindlongpress="handleLongPress"
          catchtouchmove="handleTouchMove"
          catchtouchend="handleTouchEnd"
          catchtouchcancel="handleTouchEnd"
          data-id="{{item.id}}">
      <view class="dot"></view>
      <view class="row-body">
        <text class="row-content">{{item.content}}</text>
        <view class="row-chips">
          <text class="chip est-chip">预计 {{item.estimatedMinutes}} 分钟</text>
          <text wx:if="{{item.elapsedDisplay}}" class="chip elapsed-chip">{{item.status === 'done' ? '花费' : '已用'}} {{item.elapsedDisplay}}</text>
        </view>
      </view>
      <view class="row-actions">
        <view wx:if="{{item.status === 'done'}}" class="icon-btn done-mark">✓</view>
        <view class="icon-btn edit-btn" data-id="{{item.id}}" catchtap="handleEditTask">✏️</view>
        <view class="icon-btn del-btn" data-id="{{item.id}}" catchtap="handleDeleteTask">🗑</view>
      </view>
    </view>
  </block>

  <view class="bottom-actions card">
    <button class="full-btn add-btn" bindtap="handleAddTask">+ 新增作业</button>
    <button class="full-btn edit-btn" bindtap="handleEditNotebook">✏️ 编辑作业本</button>
    <button class="full-btn share-btn" open-type="share">📤 分享作业本</button>
    <button class="full-btn copy-btn" bindtap="handleCopyNotebook">📋 复制内容</button>
    <button class="full-btn danger-btn" bindtap="handleDeleteNotebook">🗑 删除作业本</button>
  </view>
</view>
