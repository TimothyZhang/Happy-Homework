/* page-meta disable-scroll="true" + 内层 scroll-view 接管 —— 跟 home/calendar
   一样。page-meta 单独不够,长按拖拽 mid-gesture 时 page 还会跟随;靠 scroll-view
   的 scroll-y 切换才能真正锁住滚动(同样的坑 wxss 注释里在 home 已经记过)。 */
.page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.scroll-area {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.header-card { padding-bottom: 22rpx; }

.nb-summary {
  display: block;
  font-size: 24rpx;
  color: #6b7785;
}

/* Bottom-of-page action stack: ocr / edit / share / delete */
.bottom-actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bottom-actions .full-btn {
  width: 100%;
  margin: 0;
  height: 84rpx;
  /* WeChat <button> 默认有 padding/line-height，靠 line-height 对齐文字
     在不同基础库下不稳；用 flex 显式居中。 */
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-sizing: border-box;
}

.bottom-actions .add-btn {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 219, 0.25);
}

/* Non-destructive secondary actions: subdued gray so 「+ 新增作业」 above
   stays the only loud blue button. */
.bottom-actions .edit-btn,
.bottom-actions .share-btn {
  background: #f0f0f0;
  color: #1f2329;
  box-shadow: none;
}

/* Destructive action: red text on a soft red tint — matches the per-task
   delete chip (.icon-btn.del-btn) so 「删除」 reads consistently. */
.bottom-actions .danger-btn {
  background: #fff1f0;
  color: #e54545;
  box-shadow: none;
}

/* OCR is a power feature — keep it subdued but give it a soft-blue tint
   so it reads as "smart import" rather than ordinary destructive action. */
.bottom-actions .ocr-btn {
  background: #eef4ff;
  color: #245bdb;
  box-shadow: none;
}

.empty-state {
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-emoji { display: block; font-size: 72rpx; }
.empty-text { display: block; margin-top: 16rpx; font-size: 26rpx; color: #6b7785; }

.subject-header {
  margin: 28rpx 6rpx 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #245bdb;
  letter-spacing: 1rpx;
}

/* 规划模式视图切换 —— 跟 summary 同一张卡片里,分段控件风格 */
.view-switch {
  display: flex;
  margin-top: 16rpx;
  padding: 4rpx;
  background: #f0f3f8;
  border-radius: 999rpx;
}

.view-switch .seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #6b7785;
  border-radius: 999rpx;
  transition: background 0.15s ease, color 0.15s ease;
}

.view-switch .seg.active {
  background: #ffffff;
  color: #245bdb;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.08);
}

/* 规划模式:每天 folder 的 header。min-height 让它高度接近 task-row,
   这样拖拽算法用一份 itemH 估算就够稳。 */
.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 22rpx 22rpx;
  min-height: 100rpx;
  background: linear-gradient(135deg, #eef4ff 0%, #f7f9ff 100%);
  border-radius: 22rpx;
  transition: transform 0.16s ease;
  box-sizing: border-box;
}

.date-header .date-main {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.date-header .date-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1546b5;
  letter-spacing: 1rpx;
}

.date-header .date-sub {
  font-size: 22rpx;
  color: #245bdb;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(36, 91, 219, 0.12);
}

.date-header .date-empty {
  font-size: 22rpx;
  color: #8a96a6;
  flex-shrink: 0;
}

.date-header.is-empty {
  /* 空 folder 用更浅的背景提示"可拖入" */
  background: #fafbfd;
  border: 2rpx dashed #d0d6e0;
}

.subject-chip {
  background: #eef4ff;
  color: #245bdb;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 35, 41, 0.06);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.task-row.is-dragging {
  transition: none;
  transform: scale(1.02);
  box-shadow: 0 16rpx 40rpx rgba(31, 35, 41, 0.18);
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e54545;
  flex-shrink: 0;
}

.task-row.doing .dot { background: #245bdb; }
.task-row.paused .dot { background: #ff8c1a; }
.task-row.done .dot { background: #07c160; }

.row-body {
  flex: 1;
  min-width: 0;
}

.row-content {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
  font-weight: 500;
}

.row-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  white-space: nowrap;
  background: #f7f8fa;
  color: #6b7785;
}

.elapsed-chip {
  background: #eef4ff;
  color: #245bdb;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.icon-btn.done-mark { background: #e8f7ee; color: #067647; box-shadow: none; font-size: 32rpx; }
.icon-btn.edit-btn { background: #eef4ff; color: #245bdb; }
.icon-btn.del-btn { background: #fff1f0; color: #e54545; }
