.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.header-card { padding-bottom: 22rpx; }

.nb-summary {
  display: block;
  font-size: 24rpx;
  color: #6b7785;
}

/* Bottom-of-page action stack: edit / share / copy / delete */
.bottom-actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bottom-actions .full-btn {
  width: 100%;
  margin: 0;
  height: 84rpx;
  /* WeChat <button> 默认有 padding/line-height，靠 line-height 对齐文字
     在不同基础库下不稳；用 flex 显式居中。 */
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-sizing: border-box;
}

.bottom-actions .add-btn {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 219, 0.25);
}

/* All non-primary actions share a subdued light-gray look so the only
   visually loud button is 「+ 新增作业」 above. */
.bottom-actions .edit-btn,
.bottom-actions .share-btn,
.bottom-actions .copy-btn,
.bottom-actions .danger-btn {
  background: #f0f0f0;
  color: #1f2329;
  box-shadow: none;
}

/* OCR is a power feature — keep it subdued but give it a soft-blue tint
   so it reads as "smart import" rather than ordinary destructive action. */
.bottom-actions .ocr-btn {
  background: #eef4ff;
  color: #245bdb;
  box-shadow: none;
}

.empty-state {
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-emoji { display: block; font-size: 72rpx; }
.empty-text { display: block; margin-top: 16rpx; font-size: 26rpx; color: #6b7785; }

.subject-header {
  margin: 28rpx 6rpx 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #245bdb;
  letter-spacing: 1rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 35, 41, 0.06);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.task-row.is-dragging {
  transition: none;
  transform: scale(1.02);
  box-shadow: 0 16rpx 40rpx rgba(31, 35, 41, 0.18);
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e54545;
  flex-shrink: 0;
}

.task-row.doing .dot { background: #245bdb; }
.task-row.paused .dot { background: #ff8c1a; }
.task-row.done .dot { background: #07c160; }

.row-body {
  flex: 1;
  min-width: 0;
}

.row-content {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
  font-weight: 500;
}

.row-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.chip {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  white-space: nowrap;
  background: #f7f8fa;
  color: #6b7785;
}

.elapsed-chip {
  background: #eef4ff;
  color: #245bdb;
}

.row-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.icon-btn.done-mark { background: #e8f7ee; color: #067647; box-shadow: none; font-size: 32rpx; }
.icon-btn.edit-btn { background: #eef4ff; color: #245bdb; }
.icon-btn.del-btn { background: #fff1f0; color: #e54545; }
