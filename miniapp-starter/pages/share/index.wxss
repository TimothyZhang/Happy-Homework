/* 锁定页面到视口,内部 scroll-view 独立滚动;底部 fixed 分享按钮始终可见。 */
.page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 30%, #ffffff 60%);
}

.scroll-area {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 24rpx 32rpx;
  /* 给底部 fixed 分享条让位 — 96rpx 按钮 + 24rpx 间距 + safe-area */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

.card + .card { margin-top: 20rpx; }
.subject-header + .task-row { margin-top: 12rpx; }
.card + .subject-header { margin-top: 28rpx; }
.task-row + .subject-header { margin-top: 28rpx; }

/* === filter card === */
.filter-card { padding: 12rpx 28rpx; }

.filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.filter-row:last-of-type { border-bottom: 0; }

.filter-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  width: 96rpx;
  flex-shrink: 0;
}

.filter-control {
  flex: 1;
  min-width: 0;
}

.date-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-input {
  flex: 1;
  min-width: 0;
  padding: 12rpx 18rpx;
  background: #f3f6fa;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #1f2329;
  text-align: center;
}

.date-sep {
  font-size: 22rpx;
  color: #6b7785;
  flex-shrink: 0;
}

.org-input {
  padding: 12rpx 18rpx;
  background: #f3f6fa;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #1f2329;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.org-caret {
  font-size: 22rpx;
  color: #6b7785;
  margin-left: 12rpx;
}

.filter-hint {
  padding: 12rpx 0 4rpx;
  font-size: 22rpx;
  color: #6b7785;
}

/* === preview header card === */
.preview-card { padding: 24rpx 28rpx; }

.sharer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sharer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef4ff;
  flex-shrink: 0;
  overflow: hidden;
}

.sharer-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}

.sharer-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.sharer-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.25;
}

.sharer-hint {
  font-size: 24rpx;
  color: #245bdb;
  font-weight: 600;
  line-height: 1.25;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.55;
  background: #f7f8fa;
  color: #5f6b7a;
}
.org-chip { background: #f0e9ff; color: #6c3fdb; font-weight: 600; }
.date-chip { background: #eef4ff; color: #245bdb; font-weight: 600; }
.range-chip { background: #f3f6fa; color: #6b7785; }
.est-chip { background: #f7f8fa; color: #6b7785; }

/* === subject groups === */
.subject-header {
  margin: 28rpx 6rpx 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #245bdb;
  letter-spacing: 1rpx;
}

.task-row {
  margin-top: 12rpx;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 35, 41, 0.06);
}

.row-body { display: flex; flex-direction: column; gap: 10rpx; }

.row-content {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
  font-weight: 500;
}

.row-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* === empty state === */
.empty-card { padding: 48rpx 32rpx; text-align: center; }
.empty-emoji { display: block; font-size: 72rpx; }
.empty-text { display: block; margin-top: 16rpx; font-size: 26rpx; color: #6b7785; }

/* === bottom share button === */
.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -10rpx 24rpx rgba(31, 35, 41, 0.06);
  display: flex;
  flex-direction: column;
}

.full-btn {
  width: 100%;
  margin: 0;
  height: 96rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-sizing: border-box;
}

.share-btn {
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 219, 0.25);
}

.share-btn[disabled] {
  background: #d1d5db;
  color: #ffffff;
  opacity: 0.85;
  box-shadow: none;
}
