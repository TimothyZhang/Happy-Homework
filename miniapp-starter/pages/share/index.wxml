<view class="page">
  <scroll-view scroll-y="{{true}}" show-scrollbar="{{false}}" class="scroll-area">
    <!-- 顶部预览卡 = 落地页结构。组织 / 日期 chip 本身就是 picker 触发器,
         调整筛选不再需要单独的"筛选模块" UI。微信分享卡片自动截图抓到的
         就是这一坨,看起来和落地页一致。 -->
    <view class="card preview-card">
      <view class="sharer-row">
        <image wx:if="{{sharerAvatar}}"
               class="sharer-avatar"
               src="{{sharerAvatar}}"
               mode="aspectFill" />
        <view wx:else class="sharer-avatar sharer-avatar-fallback">📤</view>
        <view class="sharer-text">
          <input class="sharer-name title-input"
                 placeholder="{{titlePlaceholder}}"
                 placeholder-class="title-input-placeholder"
                 value="{{customTitle}}"
                 maxlength="20"
                 bindinput="onTitleInput"
                 confirm-type="done" />
          <text class="sharer-hint">{{sharerHint}}</text>
        </view>
      </view>

      <view class="chip-row">
        <picker mode="selector"
                range="{{orgOptions}}"
                value="{{orgIndex}}"
                bindchange="handleOrgChange">
          <view class="chip org-chip chip-picker">
            <text>{{orgLabel}}</text>
            <text class="chip-caret">▾</text>
          </view>
        </picker>
        <picker mode="date" value="{{startDate}}" bindchange="handleStartDateChange">
          <view class="chip date-chip chip-picker">
            <text>{{startDateLabel}}</text>
            <text class="chip-caret">▾</text>
          </view>
        </picker>
        <picker mode="date" value="{{endDate}}" bindchange="handleEndDateChange">
          <view class="chip date-chip chip-picker">
            <text>{{endDateLabel}}</text>
            <text class="chip-caret">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <view wx:if="{{totalCount === 0}}" class="card empty-card">
      <text class="empty-emoji">📝</text>
      <text class="empty-text">{{filterEmptyHint}}</text>
    </view>

    <block wx:for="{{subjectGroups}}" wx:key="subject" wx:for-item="group">
      <view class="subject-header">{{group.subject}} ({{group.tasks.length}})</view>
      <view wx:for="{{group.tasks}}"
            wx:key="id"
            wx:for-item="t"
            class="task-row">
        <view class="row-body">
          <text class="row-content">{{t.content}}</text>
          <view class="row-chips">
            <text wx:if="{{t.dueDateLabel}}" class="chip range-chip">{{t.dueDateLabel}}</text>
            <text wx:if="{{t.estimatedMinutes > 0}}" class="chip est-chip">{{t.estimatedMinutesLabel}}</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="bottom-actions">
    <button class="full-btn share-btn"
            open-type="share"
            disabled="{{totalCount === 0}}">
      {{shareBtnLabel}}
    </button>
  </view>
</view>
