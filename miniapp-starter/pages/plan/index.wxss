.stats-row {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #6b7785;
  display: flex;
  justify-content: space-between;
}

.timeline-item {
  display: flex;
  margin-top: 24rpx;
}

.time-col {
  width: 110rpx;
  padding-top: 8rpx;
}

.time-start {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.time-end {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8794;
}

.timeline-body {
  flex: 1;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.task-title {
  font-size: 30rpx;
  font-weight: 700;
}

.task-content {
  display: block;
  margin: 12rpx 0;
  font-size: 28rpx;
  line-height: 1.6;
}

.start-btn {
  background: #245bdb;
  color: #ffffff;
}

.finish-btn {
  background: #07c160;
  color: #ffffff;
}
