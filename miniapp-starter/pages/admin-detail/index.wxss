.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* === profile === */
.profile-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eef4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-img { width: 100%; height: 100%; display: block; }
.avatar-fallback {
  color: #245bdb;
  font-size: 44rpx;
  font-weight: 600;
}
.profile-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.nick {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}
.openid-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.openid {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 22rpx;
  color: #8a94a4;
  word-break: break-all;
  flex: 1;
}
.copy-hint {
  font-size: 22rpx;
  color: #245bdb;
  flex-shrink: 0;
}

/* === meta grid === */
.meta-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}
.meta-item {
  background: #f7f9fc;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.meta-label {
  font-size: 22rpx;
  color: #8a94a4;
}
.meta-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.meta-value.coin {
  color: #b26a00;
}

/* === pet === */
.pet-block {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.pet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.pet-emoji {
  font-size: 60rpx;
}
.pet-name-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.pet-name {
  font-size: 30rpx;
  font-weight: 600;
}
.pet-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}
.pet-stat {
  background: #f7f9fc;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pet-stat-label {
  font-size: 24rpx;
  color: #6b7785;
}
.pet-stat-value {
  font-size: 28rpx;
  font-weight: 600;
}

/* === sync info === */
.info-rows {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.info-label {
  font-size: 24rpx;
  color: #6b7785;
}
.info-value {
  font-size: 24rpx;
  color: #1f2329;
  flex-shrink: 0;
  text-align: right;
}
.info-value.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 22rpx;
  word-break: break-all;
  text-align: right;
  max-width: 60%;
}

/* === coin adjust form === */
.quick-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.quick-btn {
  margin: 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 0 20rpx;
  line-height: 56rpx;
  height: 56rpx;
  border: none;
}
.quick-btn.add {
  background: #e8f7ee;
  color: #067647;
}
.quick-btn.sub {
  background: #fff1f0;
  color: #e54545;
}

.field-label {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #6b7785;
}

.inbox-note {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  padding: 16rpx;
}
.inbox-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #245bdb;
}
.inbox-text {
  font-size: 22rpx;
  color: #4a5d7a;
  line-height: 1.5;
}

.log-status-block {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.claim-pill {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.claim-pill.claimed {
  background: #e8f7ee;
  color: #067647;
}
.claim-pill.pending {
  background: #fff5e6;
  color: #b26a00;
}

.submit-btn {
  margin-top: 22rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* === logs === */
.log-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.log-row {
  background: #f7f9fc;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.log-row.tight {
  gap: 4rpx;
}
.log-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.log-line.top {
  margin-bottom: 4rpx;
}
.log-delta {
  font-size: 30rpx;
  font-weight: 700;
}
.log-delta.add { color: #067647; }
.log-delta.sub { color: #e54545; }
.log-reason {
  font-size: 24rpx;
  color: #1f2329;
  line-height: 1.5;
  word-break: break-all;
}
.log-reason.admin {
  color: #b26a00;
}

.ledger-kind-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.ledger-kind {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.error-card { margin-top: 16rpx; }
.error-text {
  color: #e54545;
  font-size: 26rpx;
  line-height: 1.5;
}
