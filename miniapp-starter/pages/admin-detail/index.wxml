<view class="page">
  <view wx:if="{{loading}}" class="empty-block">{{t.admind_loading}}</view>

  <view wx:elif="{{error}}" class="card error-card">
    <text class="error-text">{{error}}</text>
  </view>

  <block wx:else>
    <!-- 基本信息 -->
    <view class="card">
      <view class="profile-row">
        <view class="avatar-wrap">
          <image wx:if="{{summary.avatar}}" class="avatar-img" src="{{summary.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar-fallback">{{summary.avatarInitial}}</view>
        </view>
        <view class="profile-info">
          <text class="nick">{{summary.displayName}}</text>
          <view class="openid-row" bindtap="handleCopyOpenid">
            <text class="openid">{{summary.openid}}</text>
            <text class="copy-hint">{{t.admind_copyHint}}</text>
          </view>
        </view>
      </view>

      <view class="meta-grid">
        <view class="meta-item">
          <text class="meta-label">{{t.admind_metaCoins}}</text>
          <text class="meta-value coin">🪙 {{summary.coins}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">{{t.admind_metaStreak}}</text>
          <text class="meta-value">{{metaStreakLabel}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">{{t.admind_metaNotebooks}}</text>
          <text class="meta-value">{{metaNotebooksLabel}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">{{t.admind_metaTasks}}</text>
          <text class="meta-value">{{metaTasksLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 宠物状态 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">{{t.admind_petSection}}</text>
      </view>
      <view wx:if="{{summary.pet}}" class="pet-block">
        <view class="pet-head">
          <text class="pet-emoji">{{summary.pet.emoji}}</text>
          <view class="pet-name-block">
            <text class="pet-name">{{summary.petDisplayName}}</text>
            <text class="subtle">{{summary.pet.species}} · Lv.{{summary.pet.level}}</text>
          </view>
        </view>
        <view class="pet-stats">
          <view class="pet-stat">
            <text class="pet-stat-label">{{t.admind_petStatHappy}}</text>
            <text class="pet-stat-value">{{summary.pet.happiness}}</text>
          </view>
          <view class="pet-stat">
            <text class="pet-stat-label">{{t.admind_petStatFull}}</text>
            <text class="pet-stat-value">{{summary.pet.fullness}}</text>
          </view>
          <view class="pet-stat">
            <text class="pet-stat-label">{{t.admind_petStatClean}}</text>
            <text class="pet-stat-value">{{summary.pet.cleanliness}}</text>
          </view>
          <view class="pet-stat">
            <text class="pet-stat-label">{{t.admind_petStatHealth}}</text>
            <text class="pet-stat-value">{{summary.pet.health}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-block">{{t.admind_noPet}}</view>
    </view>

    <!-- 同步状态 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">{{t.admind_syncSection}}</text>
      </view>
      <view class="info-rows">
        <view class="info-row">
          <text class="info-label">{{t.admind_syncLastWrite}}</text>
          <text class="info-value">{{updatedAtDisplay}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.admind_syncSessionId}}</text>
          <text class="info-value mono">{{sessionId ? sessionId : '—'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.admind_syncClaimed}}</text>
          <text class="info-value">{{claimedAtDisplay}}</text>
        </view>
      </view>
    </view>

    <!-- 调整金币 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">{{t.admind_adjustSection}}</text>
        <text class="subtle">{{adjustCurrentLabel}}</text>
      </view>

      <view class="quick-row">
        <button class="quick-btn add" size="mini" data-delta="10" bindtap="handleQuickDelta">+10</button>
        <button class="quick-btn add" size="mini" data-delta="50" bindtap="handleQuickDelta">+50</button>
        <button class="quick-btn add" size="mini" data-delta="100" bindtap="handleQuickDelta">+100</button>
        <button class="quick-btn sub" size="mini" data-delta="-10" bindtap="handleQuickDelta">-10</button>
        <button class="quick-btn sub" size="mini" data-delta="-50" bindtap="handleQuickDelta">-50</button>
        <button class="quick-btn sub" size="mini" data-delta="-100" bindtap="handleQuickDelta">-100</button>
      </view>

      <text class="field-label">{{t.admind_adjustFieldLabel}}</text>
      <input class="input"
             type="number"
             placeholder="{{t.admind_adjustPlaceholder}}"
             value="{{deltaInput}}"
             bindinput="handleDeltaInput" />

      <text class="field-label">{{t.admind_adjustReasonLabel}}</text>
      <input class="input"
             placeholder="{{t.admind_adjustReasonPlaceholder}}"
             maxlength="100"
             value="{{reasonInput}}"
             bindinput="handleReasonInput" />

      <view class="inbox-note">
        <text class="inbox-title">{{t.admind_inboxTitle}}</text>
        <text class="inbox-text">{{t.admind_inboxBody}}</text>
      </view>

      <button class="primary-btn submit-btn"
              loading="{{submitting}}"
              disabled="{{submitting}}"
              bindtap="handleSubmit">{{t.admind_submitBtn}}</button>
    </view>

    <!-- 审计日志 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">{{t.admind_auditSection}}</text>
        <text class="subtle">{{auditRecentLabel}}</text>
      </view>
      <view wx:if="{{adjustments.length === 0}}" class="empty-block">{{t.admind_auditEmpty}}</view>
      <view wx:else class="log-list">
        <view wx:for="{{adjustments}}" wx:key="_id" class="log-row">
          <view class="log-line top">
            <text class="log-delta {{item.delta > 0 ? 'add' : 'sub'}}">{{item.signed}}</text>
            <view class="log-status-block">
              <text class="claim-pill {{item.claimed ? 'claimed' : 'pending'}}">{{item.claimLabel}}</text>
              <text class="subtle">{{item.createdAtDisplay}}</text>
            </view>
          </view>
          <text class="log-reason">{{item.reason ? item.reason : item.noReasonLabel}}</text>
          <view class="log-line">
            <text class="subtle">{{item.adminPrefix}}</text>
            <text wx:if="{{item.claimed}}" class="subtle">{{item.claimedAtLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- coin_ledger:服务端权威金币账本(全部事件:任务/宠物/管理员/分享…) -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">{{t.admind_ledgerSection}}</text>
        <text class="subtle">{{ledgerCountLabel}}</text>
      </view>
      <view wx:if="{{ledger.length === 0}}" class="empty-block">{{t.admind_ledgerEmpty}}</view>
      <view wx:else class="log-list">
        <view wx:for="{{ledger}}" wx:key="_id" class="log-row">
          <view class="log-line top">
            <view class="ledger-kind-block">
              <text class="ledger-kind">{{item.kindLabel}}</text>
              <text class="subtle">{{item.createdAtDisplay}}</text>
            </view>
            <text class="log-delta {{item.delta > 0 ? 'add' : 'sub'}}">{{item.signed}}</text>
          </view>
          <view class="log-line">
            <text class="subtle">{{item.balanceAfterLabel}}</text>
            <text wx:if="{{item.metaSummary}}" class="subtle">{{item.metaSummary}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- coinLogs (客户端镜像,留作对账参考;coin_ledger 才是权威源) -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">{{t.admind_localSection}}</text>
        <text class="subtle">{{localCountLabel}}</text>
      </view>
      <view wx:if="{{coinLogs.length === 0}}" class="empty-block">{{t.admind_localEmpty}}</view>
      <view wx:else class="log-list">
        <view wx:for="{{coinLogs}}" wx:key="at" class="log-row tight">
          <view class="log-line top">
            <text class="log-delta {{item.delta > 0 ? 'add' : 'sub'}}">{{item.signed}}</text>
            <text class="subtle">{{item.atDisplay}}</text>
          </view>
          <text class="log-reason {{item.isAdmin ? 'admin' : ''}}">{{item.reason}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
