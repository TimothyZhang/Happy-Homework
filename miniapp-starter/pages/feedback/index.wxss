.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.intro { margin: 8rpx 8rpx 18rpx; font-size: 24rpx; color: #8a94a0; line-height: 1.6; }

.card {
  background: #ffffff; border-radius: 20rpx; padding: 24rpx 22rpx;
  margin-bottom: 18rpx; box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}

.ta {
  width: 100%; min-height: 240rpx; font-size: 30rpx; color: #1f2329; line-height: 1.6;
}
.count { margin-top: 10rpx; text-align: right; font-size: 22rpx; color: #aab2bd; }

.contact-label { display: block; font-size: 24rpx; color: #6b7785; margin-bottom: 12rpx; }
.contact-input {
  width: 100%; height: 72rpx; background: #f4f6fa; border-radius: 14rpx;
  padding: 0 20rpx; box-sizing: border-box; font-size: 28rpx; color: #1f2329;
}

.submit {
  margin-top: 12rpx; height: 92rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  background: #245bdb; color: #ffffff; font-size: 31rpx; font-weight: 700;
}
.submit-hover { background: #1e4fc0; }
.submit.off { background: #b7c0cd; }
