<view class="page">
  <view class="intro">{{t.fb_intro}}</view>

  <view class="card">
    <textarea class="ta" placeholder="{{t.fb_placeholder}}" maxlength="{{textMax}}"
              value="{{text}}" bindinput="onText" auto-height show-confirm-bar="{{false}}" />
    <view class="count">{{countLabel}}</view>
  </view>

  <view class="card">
    <text class="contact-label">{{t.fb_contact_label}}</text>
    <input class="contact-input" placeholder="{{t.fb_contact_placeholder}}" maxlength="100"
           value="{{contact}}" bindinput="onContact" />
  </view>

  <view class="submit {{(text || submitting) ? '' : 'off'}}" bindtap="submit" hover-class="submit-hover">
    {{submitting ? t.fb_submitting : t.fb_submit}}
  </view>
</view>
