<view class="page">
  <!-- 语言 -->
  <view class="card set-card">
    <text class="set-head">{{t.set_language}}</text>
    <view class="lang-toggle">
      <view class="lang-opt {{lang === 'en' ? 'on' : ''}}" data-lang="en" bindtap="setLang" hover-class="lang-opt-hover">English</view>
      <view class="lang-opt {{lang === 'zh' ? 'on' : ''}}" data-lang="zh" bindtap="setLang" hover-class="lang-opt-hover">中文</view>
    </view>
  </view>

  <!-- 作业组织标签 -->
  <view class="card set-entry" bindtap="goOrgTags" hover-class="set-entry-hover">
    <view class="set-entry-text">
      <text class="set-entry-title">{{t.set_org}}</text>
      <text class="set-entry-sub">{{t.set_orgSub}}</text>
    </view>
    <text class="set-entry-chev">›</text>
  </view>

  <!-- 数据恢复(同步 / 本地+云端备份 / 恢复 / 登录记录) -->
  <view class="card set-entry" bindtap="goDataRecovery" hover-class="set-entry-hover">
    <view class="set-entry-text">
      <text class="set-entry-title">{{t.set_dataRecovery}}</text>
      <text class="set-entry-sub">{{t.set_dataRecoverySub}}</text>
    </view>
    <text class="set-entry-chev">›</text>
  </view>
</view>
