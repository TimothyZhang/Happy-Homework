.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

/* === selected day list === */
.list-card {
  margin-top: 24rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 16rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.list-count {
  font-size: 22rpx;
  color: #8a96a3;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #8a96a3;
}

