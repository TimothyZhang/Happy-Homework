/* See pages/home/index.wxss — same locked-page + inner scroll-view pattern so
   the long-press drag in <task-list> can stop scrolling mid-gesture. */
/* 见 home/index.wxss page 规则:page-meta 在 iOS 拦不住 WebView 文档级橡皮筋回弹,
   给根 page 加 overflow:hidden 在渲染层锁死,内部 scroll-view 照常滚。iOS 真机特有。 */
page {
  height: 100%;
  overflow: hidden;
}
.page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7f9fc 0%, #eef4ff 100%);
}

.scroll-area {
  /* 见 home/index.wxss 同名规则:flex:1 撑满整屏,内容不满一屏时拖拽/左滑
     会触发 bounce 回弹带动整屏(scroll-y=false 拦不住无内容回弹)。改 flex:0
     1 auto + max-height:100%,短内容贴合不回弹、长内容收缩照常滚 + 软锁生效。 */
  flex: 0 1 auto;
  max-height: 100%;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
}

/* === selected day list === */
.list-card { margin-top: 24rpx; }

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 16rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.list-count {
  font-size: 22rpx;
  color: #8a96a3;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #8a96a3;
}

