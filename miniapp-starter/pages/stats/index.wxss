/* 周/月 切换 */
.period-switch {
  display: flex;
  background: #eef2f7;
  border-radius: 999rpx;
  padding: 4rpx;
}

.period-tab {
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: #6b7785;
  border-radius: 999rpx;
}

.period-tab.is-active {
  background: #245bdb;
  color: #ffffff;
  font-weight: 600;
}

/* chart card */
.chart-card {
  padding-bottom: 24rpx;
}

.chart-scroll {
  margin-top: 16rpx;
  width: 100%;
}

.bar-row {
  display: flex;
  align-items: flex-end;
  padding: 0 4rpx;
  box-sizing: border-box;
  width: 100%;
  position: relative;
}

/* 月模式参考线 —— bar 区内的 25/50/75% 水平虚线 */
.grid-line {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  height: 0;
  border-top: 1rpx dashed rgba(31, 35, 41, 0.32);
  pointer-events: none;
  z-index: 0;
}

/* 参考线数值标签 —— 浮在虚线右上方 */
.grid-label {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  font-size: 18rpx;
  line-height: 1;
  color: rgba(31, 35, 41, 0.55);
  background: rgba(255, 255, 255, 0.85);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.grid-label-neg {
  color: rgba(181, 64, 64, 0.75);
}

.bar-row.is-week {
  justify-content: space-around;
}

.bar-row.is-month {
  justify-content: space-between;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.bar-stack {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  width: 100%;
}

.bar {
  width: 40rpx;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.25s ease;
}

/* 月模式 30 根挤一屏:每根用百分比占满列,留 4rpx 视觉间隙 */
.bar-row.is-month .bar {
  width: 80%;
  max-width: 16rpx;
  border-radius: 4rpx 4rpx 0 0;
}

.bar-count {
  background: linear-gradient(180deg, #5b8def 0%, #245bdb 100%);
}

.bar-minutes {
  background: linear-gradient(180deg, #ffc56b 0%, #ff9933 100%);
}

.bar-finish {
  background: linear-gradient(180deg, #b08bee 0%, #7c3aed 100%);
}

.bar-coin-gain {
  background: linear-gradient(180deg, #6dd58c 0%, #1aab50 100%);
  border-radius: 8rpx 8rpx 0 0;
}

.bar-coin-spend {
  background: linear-gradient(0deg, #f08585 0%, #d94343 100%);
  border-radius: 0 0 8rpx 8rpx;
}

.bar.is-today {
  box-shadow: 0 0 0 4rpx rgba(36, 91, 219, 0.18);
}

.bar-value {
  font-size: 20rpx;
  color: #4a5566;
  line-height: 1;
  margin-bottom: 6rpx;
}

.bar-value-neg {
  color: #b54040;
  margin-top: 6rpx;
  margin-bottom: 0;
}

/* 月模式数字塞不下,隐藏每根 bar 上的数字,看总计即可 */
.bar-row.is-month .bar-value {
  display: none;
}

.bar-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7b8794;
  line-height: 1.2;
}

.bar-row.is-month .bar-label {
  font-size: 18rpx;
  min-height: 22rpx;
}

.bar-label.is-today {
  color: #245bdb;
  font-weight: 600;
}

/* 金币图:zero line 居中,上下两半 */
.coin-row {
  align-items: stretch;
}

.coin-col {
  justify-content: flex-start;
}

.bar-half {
  display: flex;
  flex-direction: column;
  width: 100%;
  align-items: center;
}

.bar-half-pos {
  justify-content: flex-end;
}

.bar-half-neg {
  justify-content: flex-start;
}

.zero-line {
  width: 100%;
  height: 2rpx;
  background: #d4dae3;
}

.coin-col .bar-label {
  margin-top: 8rpx;
}
