<view class="page">
  <view class="card">
    <view class="section-header">
      <text class="section-title">{{t.stats_navtitle}}</text>
      <view class="period-switch">
        <view class="period-tab {{period === 'week' ? 'is-active' : ''}}"
              data-period="week" bindtap="onSwitchPeriod">{{t.stats_period_week}}</view>
        <view class="period-tab {{period === 'month' ? 'is-active' : ''}}"
              data-period="month" bindtap="onSwitchPeriod">{{t.stats_period_month}}</view>
      </view>
    </view>
  </view>

  <view class="card section-card chart-card">
    <view class="section-header">
      <text class="section-title">{{t.stats_section_finish}}</text>
      <text class="subtle">{{statsAvgLabel}}</text>
    </view>
    <view class="chart-scroll">
      <view class="bar-row {{period === 'month' ? 'is-month' : 'is-week'}}"
            style="height: {{barAreaRpx + 60}}rpx;">
        <block wx:if="{{period === 'month'}}">
          <view class="grid-line" style="bottom: 84rpx;"><text class="grid-label">{{finishTimeQ1}}</text></view>
          <view class="grid-line" style="bottom: 134rpx;"><text class="grid-label">{{finishTimeQ2}}</text></view>
          <view class="grid-line" style="bottom: 184rpx;"><text class="grid-label">{{finishTimeQ3}}</text></view>
        </block>
        <view wx:for="{{finishTimeBars}}" wx:key="date" class="bar-col">
          <view class="bar-stack" style="height: {{barAreaRpx}}rpx;">
            <text wx:if="{{item.value > 0}}" class="bar-value">{{item.displayValue}}</text>
            <view class="bar bar-finish {{item.isToday ? 'is-today' : ''}}"
                  style="height: {{item.heightRpx}}rpx;"></view>
          </view>
          <text class="bar-label {{item.isToday ? 'is-today' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card section-card chart-card">
    <view class="section-header">
      <text class="section-title">{{t.stats_section_count}}</text>
      <text class="subtle">{{statsCountSubtitle}}</text>
    </view>
    <view class="chart-scroll">
      <view class="bar-row {{period === 'month' ? 'is-month' : 'is-week'}}"
            style="height: {{barAreaRpx + 60}}rpx;">
        <block wx:if="{{period === 'month'}}">
          <view class="grid-line" style="bottom: 84rpx;"><text class="grid-label">{{countQ1}}</text></view>
          <view class="grid-line" style="bottom: 134rpx;"><text class="grid-label">{{countQ2}}</text></view>
          <view class="grid-line" style="bottom: 184rpx;"><text class="grid-label">{{countQ3}}</text></view>
        </block>
        <view wx:for="{{countBars}}" wx:key="date" class="bar-col">
          <view class="bar-stack" style="height: {{barAreaRpx}}rpx;">
            <text wx:if="{{item.value > 0}}" class="bar-value">{{item.value}}</text>
            <view class="bar bar-count {{item.isToday ? 'is-today' : ''}}"
                  style="height: {{item.heightRpx}}rpx;"></view>
          </view>
          <text class="bar-label {{item.isToday ? 'is-today' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card section-card chart-card">
    <view class="section-header">
      <text class="section-title">{{t.stats_section_duration}}</text>
      <text class="subtle">{{statsDurSummary}}</text>
    </view>
    <view class="legend">
      <text class="legend-item"><text class="legend-dot base"></text>{{t.stats_legend_actual}}</text>
      <text class="legend-item"><text class="legend-dot under"></text>{{t.stats_legend_under}}</text>
      <text class="legend-item"><text class="legend-dot over"></text>{{t.stats_legend_over}}</text>
    </view>
    <view class="chart-scroll">
      <view class="bar-row {{period === 'month' ? 'is-month' : 'is-week'}}"
            style="height: {{barAreaRpx + 60}}rpx;">
        <block wx:if="{{period === 'month'}}">
          <view class="grid-line" style="bottom: 84rpx;"><text class="grid-label">{{minutesQ1}}</text></view>
          <view class="grid-line" style="bottom: 134rpx;"><text class="grid-label">{{minutesQ2}}</text></view>
          <view class="grid-line" style="bottom: 184rpx;"><text class="grid-label">{{minutesQ3}}</text></view>
        </block>
        <view wx:for="{{minutesBars}}" wx:key="date" class="bar-col">
          <view class="bar-stack" style="height: {{barAreaRpx}}rpx;">
            <text wx:if="{{item.hasData}}" class="bar-value">{{item.act}}<text wx:if="{{item.diffLabel}}" class="bar-diff-tag {{item.over ? 'over' : 'under'}}"> {{item.diffLabel}}</text></text>
            <view wx:if="{{item.diffHeightRpx > 0}}" class="bar bar-est-diff {{item.over ? 'over' : 'under'}}"
                  style="height: {{item.diffHeightRpx}}rpx;"></view>
            <view class="bar bar-est-base {{item.diffHeightRpx > 0 ? 'flat-top' : ''}} {{item.isToday ? 'is-today' : ''}}"
                  style="height: {{item.baseHeightRpx}}rpx;"></view>
          </view>
          <text class="bar-label {{item.isToday ? 'is-today' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card section-card chart-card">
    <view class="section-header">
      <text class="section-title">{{t.stats_section_coins}}</text>
      <text class="subtle">{{statsCoinsSubtitle}}</text>
    </view>
    <view class="chart-scroll">
      <view class="bar-row coin-row {{period === 'month' ? 'is-month' : 'is-week'}}"
            style="height: {{barAreaRpx * 2 + 80}}rpx;">
        <block wx:if="{{period === 'month'}}">
          <view class="grid-line" style="bottom: 380rpx;"><text class="grid-label">+{{coinHalf}}</text></view>
          <view class="grid-line" style="bottom: 178rpx;"><text class="grid-label grid-label-neg">-{{coinHalf}}</text></view>
        </block>
        <view wx:for="{{coinBars}}" wx:key="date" class="bar-col coin-col">
          <view class="bar-half bar-half-pos" style="height: {{barAreaRpx}}rpx;">
            <text wx:if="{{item.gain > 0}}" class="bar-value">+{{item.gain}}</text>
            <view wx:if="{{item.gain > 0}}" class="bar bar-coin-gain {{item.isToday ? 'is-today' : ''}}"
                  style="height: {{item.gainHeightRpx}}rpx;"></view>
          </view>
          <view class="zero-line"></view>
          <view class="bar-half bar-half-neg" style="height: {{barAreaRpx}}rpx;">
            <view wx:if="{{item.spend > 0}}" class="bar bar-coin-spend {{item.isToday ? 'is-today' : ''}}"
                  style="height: {{item.spendHeightRpx}}rpx;"></view>
            <text wx:if="{{item.spend > 0}}" class="bar-value bar-value-neg">-{{item.spend}}</text>
          </view>
          <text class="bar-label {{item.isToday ? 'is-today' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
