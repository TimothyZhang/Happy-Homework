<view class="page">
  <view class="card">
    <view class="section-header">
      <text class="section-title">学习统计</text>
    </view>
  </view>

  <view class="card section-card">
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{stats.todayTotal}}</text>
        <text class="stat-label">今日总作业</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.todayDone}}</text>
        <text class="stat-label">今日已完成</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.totalMinutes}}</text>
        <text class="stat-label">预计总分钟</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.coins}}</text>
        <text class="stat-label">当前金币</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.lifetimeDone}}</text>
        <text class="stat-label">累计完成</text>
      </view>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-header">
      <text class="section-title">完成记录</text>
      <text class="subtle">最近 30 条</text>
    </view>

    <view wx:if="{{doneList.length}}">
      <view wx:for="{{doneList}}" wx:key="id" class="history-item">
        <view class="row-between">
          <text class="history-title">{{item.notebookName}}</text>
          <text class="status-badge status-done">{{item.doneOn || '已完成'}}</text>
        </view>
        <text class="task-content">{{item.content}}</text>
      </view>
    </view>
    <view wx:else class="empty-block">
      <text class="tip-text">还没有完成记录，先去首页打卡一项看看。</text>
    </view>
  </view>
</view>
