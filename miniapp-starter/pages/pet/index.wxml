<view class="page">
  <view class="card pet-card">
    <view class="section-header">
      <text class="section-title">电子宠物</text>
      <text class="coin-balance">金币 {{coins}}</text>
    </view>

    <view class="pet-hero">
      <text class="pet-avatar">{{pet.emoji}}</text>
      <text class="pet-name">{{pet.name}}</text>
      <text class="subtle">Lv.{{pet.level}} · 成长值 {{pet.growth}} / {{pet.nextLevelGrowth}}</text>
    </view>

    <view class="pet-stat-block">
      <text class="field-label">开心值</text>
      <progress percent="{{pet.happiness}}" stroke-width="10" activeColor="#ffb648" backgroundColor="#edf0f3" />
    </view>
    <view class="pet-stat-block">
      <text class="field-label">饱腹值</text>
      <progress percent="{{pet.fullness}}" stroke-width="10" activeColor="#07c160" backgroundColor="#edf0f3" />
    </view>
  </view>

  <view class="card section-card">
    <view class="section-header">
      <text class="section-title">宠物商店</text>
      <text class="subtle">用金币换成长反馈</text>
    </view>

    <view wx:for="{{shopItems}}" wx:key="id" class="shop-item-card">
      <view>
        <text class="shop-name">{{item.emoji}} {{item.name}}</text>
        <text class="shop-effect">{{item.effect}}</text>
      </view>
      <button class="mini-btn buy-btn" size="mini" data-id="{{item.id}}" bindtap="handleBuyItem">{{item.price}} 金币</button>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-header">
      <text class="section-title">我为什么这么设计</text>
    </view>
    <text class="subtle">先让金币有明确出口，再做更复杂的装扮、宠物互动和社交展示。不然奖励体系会很空。</text>
  </view>
</view>