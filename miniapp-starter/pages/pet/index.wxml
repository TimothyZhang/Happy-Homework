<view class="page">
  <block wx:if="{{mode === 'setup'}}">
    <view class="card setup-card">
      <view class="setup-title">选一只想养的宠物吧</view>
      <view class="setup-sub">陪你一起完成作业，每天都会和你互动哦</view>

      <view class="species-grid">
        <view wx:for="{{speciesOptions}}"
              wx:key="id"
              class="species-item {{setupSpecies === item.id ? 'on' : ''}}"
              data-id="{{item.id}}"
              bindtap="handlePickSpecies">
          <image class="species-art" src="/assets/pets/{{item.id}}.svg" mode="aspectFit" />
          <text class="species-label">{{item.label}}</text>
        </view>
      </view>

      <view class="setup-name-row">
        <text class="setup-name-label">取个名字</text>
        <input class="setup-name-input"
               placeholder="比如：豆豆"
               maxlength="12"
               value="{{setupName}}"
               bindinput="handleSetupName" />
      </view>

      <button class="setup-confirm" bindtap="handleConfirmSetup">确定，就是它！</button>
    </view>
  </block>

  <block wx:else>
    <!-- 全屏室内房间(fixed 背景):宠物在地板上以侧面朝向四向行走。点空地板
         宠物走过去,点宠物本身按心情互动。控制卡片在下面的 .sheet 里,往上滚
         盖住下半截房间。 -->
    <view class="scene-clip">
    <view class="room theme-{{roomTheme}}" bindtap="handleSceneTap"
          style="transform: translateX({{cameraTx}}px); transition-duration: {{moveDurMs}}ms">
      <view class="room-wall"></view>
      <view class="room-window">
        <view class="room-cloud"></view>
        <view class="room-window-bar room-window-bar-v"></view>
        <view class="room-window-bar room-window-bar-h"></view>
      </view>
      <view class="room-picture room-poster">
        <text class="poster-line">好好学习</text>
        <text class="poster-line">天天向上</text>
      </view>
      <view class="room-baseboard"></view>
      <view class="room-floor"></view>
      <view class="room-rug"></view>

      <!-- 学习小书桌(房间角落):点它弹「背单词」菜单 -->
      <view class="room-desk" catchtap="openDeskMenu" hover-class="room-desk-hover">
        <view class="desk-hint">📖 背单词</view>
        <image class="room-desk-art" src="/assets/room/desk.svg" mode="aspectFit" />
      </view>

      <!-- 城堡(白天·金碧辉煌)专属装饰:金吊灯 + 两侧金柱 -->
      <block wx:if="{{roomTheme === 'castle'}}">
        <view class="castle-pillar castle-pillar-l"></view>
        <view class="castle-pillar castle-pillar-r"></view>
        <image class="castle-chandelier" src="/assets/room/chandelier.svg" mode="aspectFit" />
      </block>

      <view wx:if="{{pet.species}}"
            class="pet-actor face-{{actorFace}} {{actorMoving ? 'moving' : (spriteAnim ? '' : 'still')}} anim-{{animState}} {{spriteAnim ? 'do-' + spriteAnim : ''}}"
            style="left: {{actorX}}%; top: {{actorY}}%; transform: translate(-50%, -100%) scale({{actorScale}}); z-index: {{actorZ}}; transition-duration: {{moveDurMs}}ms"
            catchtap="handleTapPet">
        <view class="actor-shadow"></view>
        <view class="actor-facing">
          <view class="actor-sprite has-rig">
            <!-- 全物种骨骼分层 rig:头/耳/尾/腿/眼各一层,绕自己的关节(rigPivot)动;
                 果冻缓动(挤压/过冲/眨眼/摆尾/迈腿)见 wxss .pet-rig.* -->
            <view class="pet-rig {{actorMoving ? 'walking' : 'idle'}} {{spriteAnim ? 'do-' + spriteAnim : ''}}">
              <image class="cr-layer cr-tail" style="transform-origin: {{rigPivot.tail}}" src="/assets/pets/{{pet.species}}-rig-tail.svg" mode="aspectFit" />
              <image class="cr-layer cr-leg-back" style="transform-origin: {{rigPivot.legBack}}" src="/assets/pets/{{pet.species}}-rig-leg-back.svg" mode="aspectFit" />
              <image class="cr-layer cr-body" style="transform-origin: {{rigPivot.body}}" src="/assets/pets/{{pet.species}}-rig-body.svg" mode="aspectFit" />
              <image class="cr-layer cr-leg-front" style="transform-origin: {{rigPivot.legFront}}" src="/assets/pets/{{pet.species}}-rig-leg-front.svg" mode="aspectFit" />
              <view class="cr-head-grp" style="transform-origin: {{rigPivot.head}}">
                <image class="cr-layer cr-head" src="/assets/pets/{{pet.species}}-rig-head.svg" mode="aspectFit" />
                <image class="cr-layer cr-eye" style="transform-origin: {{rigPivot.eye}}" src="/assets/pets/{{pet.species}}-rig-eye.svg" mode="aspectFit" />
              </view>
            </view>
          </view>
        </view>
        <text wx:if="{{animState === 'hungry'}}"  class="state-icon hungry-icon">🍖</text>
        <text wx:if="{{animState === 'dirty'}}"   class="state-icon dirty-icon">💨</text>
        <text wx:if="{{animState === 'sick'}}"    class="state-icon sick-icon">🤒</text>
        <text wx:if="{{animState === 'sad'}}"     class="state-icon sad-icon">💧</text>
        <text wx:if="{{animState === 'happy'}}"   class="state-icon happy-icon">💖</text>
        <text wx:for="{{hearts}}" wx:key="id" class="love-heart" style="left: {{item.x}}%; animation-duration: {{item.dur}}ms">{{item.g}}</text>
        <view wx:if="{{showBubble}}" class="speech-bubble">{{bubbleText}}</view>
      </view>
    </view>
    </view>

    <!-- 固定顶栏:名字 + 等级徽章 + 金币;金币下面是 商店 + (可升级时)升级 按钮 -->
    <view class="top-hud">
      <text class="hud-name">{{pet.name}} {{levelBadge}}</text>
      <view class="hud-right">
        <view class="hud-coin" catchtap="handleOpenCoinHistory">
          <text class="hud-coin-text">金币 {{coins}}</text>
          <text class="coin-chev">›</text>
        </view>
        <view class="hud-btns">
          <view class="hud-btn shop-btn" catchtap="openShopPanel">🛒 商店</view>
          <view wx:if="{{canLevelUp}}" class="hud-btn levelup-btn" catchtap="handleLevelUp">⬆️ 可升级</view>
        </view>
      </view>
    </view>

    <!-- 透明状态浮窗:紧凑 4 条状态条,半透明浮在房间上 -->
    <view class="status-hud">
      <view class="status-meta">
        <text>Lv.{{pet.level}}</text><text class="dot">·</text><text>{{ageDays}} 天大</text>
      </view>
      <view class="status-know-line">📚 词汇量 {{vocab}}</view>
      <view class="svrow">
        <text class="svlabel">开心</text>
        <view class="sbar"><view class="sbar-fill" style="width: {{pet.happiness}}%; background: #ffb648"></view></view>
        <text class="svnum">{{pet.happiness}}</text>
      </view>
      <view class="svrow">
        <text class="svlabel">饱腹</text>
        <view class="sbar"><view class="sbar-fill" style="width: {{pet.fullness}}%; background: #07c160"></view></view>
        <text class="svnum">{{pet.fullness}}</text>
      </view>
      <view class="svrow">
        <text class="svlabel">清洁</text>
        <view class="sbar"><view class="sbar-fill" style="width: {{pet.cleanliness}}%; background: #3ea2ff"></view></view>
        <text class="svnum">{{pet.cleanliness}}</text>
      </view>
      <view class="svrow">
        <text class="svlabel">健康</text>
        <view class="sbar"><view class="sbar-fill" style="width: {{pet.health}}%; background: #e15c5c"></view></view>
        <text class="svnum">{{pet.health}}</text>
      </view>
      <view class="svrow">
        <text class="svlabel">努力</text>
        <view class="sbar"><view class="sbar-fill" style="width: {{pet.effort}}%; background: #7a5af0"></view></view>
        <text class="svnum">{{pet.effort}}</text>
      </view>
    </view>

    <!-- 沉底控制卡已全部收进「🛒商店」弹窗(商店 + 改名/换宠物/换背景),房间全屏显示。 -->
  </block>

  <!-- 升级动画覆盖层 — 由 handleLevelUp 触发,2.4s 后自动消失。
       全屏暗色背景 + 中央大字 "Lv.X" 弹出 + 星星散开。catchtap 防穿透。 -->
  <view wx:if="{{showLevelUpAnim}}" class="level-up-overlay" catchtap="">
    <view class="level-up-burst">
      <text class="level-up-star star-1">✨</text>
      <text class="level-up-star star-2">⭐</text>
      <text class="level-up-star star-3">✨</text>
      <text class="level-up-star star-4">⭐</text>
      <text class="level-up-star star-5">✨</text>
      <text class="level-up-star star-6">⭐</text>
    </view>
    <view class="level-up-text">
      <text class="level-up-line-1">LEVEL UP!</text>
      <text class="level-up-line-2">Lv.{{levelUpToLevel}}</text>
    </view>
  </view>

  <view wx:if="{{showSwitchPanel}}" class="switch-mask" bindtap="handleCloseSwitchPanel" catchtouchmove="noop">
    <view class="switch-sheet" catchtap="" catchtouchmove="noop">
      <view class="switch-sheet-title">选一只想换的</view>
      <view class="switch-sheet-sub">花 {{switchCost}} 金币 · 当前 {{coins}}</view>
      <view class="switch-grid">
        <view wx:for="{{speciesOptions}}"
              wx:key="id"
              class="switch-item {{pet.species === item.id ? 'current' : ''}}"
              data-id="{{item.id}}"
              bindtap="handlePickSwitchSpecies">
          <image class="switch-art" src="/assets/pets/{{item.id}}.svg" mode="aspectFit" />
          <text class="switch-label">{{item.emoji}} {{item.label}}</text>
          <text wx:if="{{pet.species === item.id}}" class="switch-current-tag">当前</text>
        </view>
      </view>
      <button class="switch-cancel" bindtap="handleCloseSwitchPanel">取消</button>
    </view>
  </view>

  <!-- 点书桌弹出的「学习角」菜单(非模态):透明层接收外部点击关闭。点宠物本身=直接摸摸它 -->
  <view wx:if="{{showDeskMenu}}" class="popover-catch" bindtap="closeDeskMenu" catchtouchmove="noop">
    <view class="desk-popover" catchtap="" catchtouchmove="noop">
      <view class="desk-popover-title">📚 学习角</view>
      <block wx:if="{{reciteLeft > 0}}">
        <view class="pet-popover-item" bindtap="menuStartRecite" hover-class="pet-popover-item-hover">
          <text class="pmi-emoji">🎯</text>
          <text>单词挑战</text>
        </view>
        <view class="pet-popover-divider"></view>
        <view class="pet-popover-item" bindtap="menuStartDictation" hover-class="pet-popover-item-hover">
          <text class="pmi-emoji">🎧</text>
          <text>听写单词</text>
        </view>
        <view class="pet-popover-divider"></view>
      </block>
      <view wx:else class="desk-popover-note">今天挑战 / 听写次数用完啦,明天再来~</view>
      <view class="pet-popover-item" bindtap="menuWordBooks" hover-class="pet-popover-item-hover">
        <text class="pmi-emoji">📚</text>
        <text>我的单词本</text>
      </view>
    </view>
  </view>

  <!-- 商店弹窗(点金币下的「🛒商店」按钮弹出) -->
  <view wx:if="{{showShopPanel}}" class="shop-panel-mask" bindtap="closeShopPanel" catchtouchmove="noop">
    <view class="shop-panel" catchtap="" catchtouchmove="noop">
      <view class="shop-panel-head">
        <text class="shop-panel-title">🛒 商店 · 管理</text>
        <text class="shop-panel-coin">金币 {{coins}}</text>
      </view>
      <scroll-view scroll-y class="shop-panel-list">
        <view class="shop-panel-section">用金币照顾它</view>
        <view wx:for="{{shopItems}}" wx:key="id" class="shop-item-card">
          <view class="shop-item-text">
            <text class="shop-name">{{item.emoji}} {{item.name}}</text>
            <text class="shop-effect">{{item.effect}}</text>
          </view>
          <button class="mini-btn buy-btn" size="mini" data-id="{{item.id}}" bindtap="handleBuyItem">{{item.price}} 金币</button>
        </view>

        <view class="shop-panel-section">管理</view>
        <view class="sp-manage" catchtap="handleOpenRename" hover-class="sp-manage-hover">
          <text class="sp-manage-emoji">✏️</text>
          <view class="sp-manage-text">
            <text class="sp-manage-title">改宠物名字</text>
            <text class="sp-manage-sub">{{renameCost}} 金币更改名字，旧名字会被清空</text>
          </view>
          <text class="sp-manage-chev">›</text>
        </view>
        <view class="sp-manage" catchtap="handleOpenSwitchPanel" hover-class="sp-manage-hover">
          <text class="sp-manage-emoji">🔄</text>
          <view class="sp-manage-text">
            <text class="sp-manage-title">换宠物</text>
            <text class="sp-manage-sub">{{switchCost}} 金币更换种类，属性和名字都保留</text>
          </view>
          <text class="sp-manage-chev">›</text>
        </view>
        <view class="sp-manage" catchtap="openRoomPicker" hover-class="sp-manage-hover">
          <text class="sp-manage-emoji">🏰</text>
          <view class="sp-manage-text">
            <text class="sp-manage-title">换房间背景</text>
            <text class="sp-manage-sub">{{roomTheme === 'castle' ? '当前:城堡' : '当前:温馨小屋'}} · 免费切换</text>
          </view>
          <text class="sp-manage-chev">›</text>
        </view>
      </scroll-view>
      <view class="shop-panel-close" bindtap="closeShopPanel">关闭</view>
    </view>
  </view>

  <!-- 选房间背景 -->
  <view wx:if="{{showRoomPicker}}" class="room-picker-mask" bindtap="closeRoomPicker" catchtouchmove="noop">
    <view class="room-picker" catchtap="" catchtouchmove="noop">
      <view class="room-picker-title">选个房间背景</view>
      <view class="room-picker-grid">
        <view class="rp-item {{roomTheme === 'cozy' ? 'on' : ''}}" data-theme="cozy" bindtap="pickRoom" hover-class="rp-hover">
          <view class="rp-thumb rp-thumb-cozy"></view>
          <text class="rp-name">温馨小屋</text>
          <text class="rp-tag {{roomTheme === 'cozy' ? '' : 'ghost'}}">{{roomTheme === 'cozy' ? '当前' : '选它'}}</text>
        </view>
        <view class="rp-item {{roomTheme === 'castle' ? 'on' : ''}}" data-theme="castle" bindtap="pickRoom" hover-class="rp-hover">
          <view class="rp-thumb rp-thumb-castle"></view>
          <text class="rp-name">城堡</text>
          <text class="rp-tag {{roomTheme === 'castle' ? '' : 'ghost'}}">{{roomTheme === 'castle' ? '当前' : '选它'}}</text>
        </view>
      </view>
      <view class="room-picker-close" bindtap="closeRoomPicker">关闭</view>
    </view>
  </view>
</view>
