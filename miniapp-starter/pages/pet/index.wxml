<view class="page">
  <block wx:if="{{mode === 'setup'}}">
    <view class="card setup-card">
      <view class="setup-title">选一只想养的宠物吧</view>
      <view class="setup-sub">陪你一起完成作业，每天都会和你互动哦</view>

      <view class="species-grid">
        <view wx:for="{{speciesOptions}}"
              wx:key="id"
              class="species-item {{setupSpecies === item.id ? 'on' : ''}}"
              data-id="{{item.id}}"
              bindtap="handlePickSpecies">
          <image class="species-art" src="/assets/pets/{{item.id}}.svg" mode="aspectFit" />
          <text class="species-label">{{item.label}}</text>
        </view>
      </view>

      <view class="setup-name-row">
        <text class="setup-name-label">取个名字</text>
        <input class="setup-name-input"
               placeholder="比如：豆豆"
               maxlength="12"
               value="{{setupName}}"
               bindinput="handleSetupName" />
      </view>

      <button class="setup-confirm" bindtap="handleConfirmSetup">确定，就是它！</button>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="section-header">
        <text class="section-title">{{pet.name}} {{levelBadge}}</text>
        <view class="coin-link" bindtap="handleOpenCoinHistory">
          <text class="coin-balance">金币 {{coins}}</text>
          <text class="coin-chev">›</text>
        </view>
      </view>

      <view class="pet-stage" bindtap="handleTapPet">
        <view class="pet-shadow"></view>
        <!-- Parrot uses a layered SVG rig so each part can animate independently.
             Other species keep the single-image render below. -->
        <view wx:if="{{pet.species === 'parrot'}}"
              class="pet-figure parrot-figure parrot-anim-{{currentAnim}}">
          <view class="parrot-stage">
            <!-- Front rig: idle / sleeping / celebrating -->
            <image class="part rig-front part-body"       src="/assets/pets/parrot-body.svg"       mode="aspectFit" />
            <image class="part rig-front part-wing-left"  src="/assets/pets/parrot-wing-left.svg"  mode="aspectFit" />
            <image class="part rig-front part-wing-right" src="/assets/pets/parrot-wing-right.svg" mode="aspectFit" />
            <image class="part rig-front part-head"       src="/assets/pets/parrot-head.svg"       mode="aspectFit" />
            <image class="part rig-front part-eyes"       src="/assets/pets/parrot-eyes.svg"       mode="aspectFit" />
            <!-- Side rig: walking / flying / eating. side-flip wraps so the
                 walking direction can mirror via scaleX without fighting the
                 per-part transforms. -->
            <view class="rig-side">
              <view class="side-flip">
                <image class="part part-side-leg-back"  src="/assets/pets/parrot-side-leg-back.svg"  mode="aspectFit" />
                <image class="part part-side-body"      src="/assets/pets/parrot-side-body.svg"      mode="aspectFit" />
                <image class="part part-side-wing"      src="/assets/pets/parrot-side-wing.svg"      mode="aspectFit" />
                <image class="part part-side-leg-front" src="/assets/pets/parrot-side-leg-front.svg" mode="aspectFit" />
                <image class="part part-side-head"      src="/assets/pets/parrot-side-head.svg"      mode="aspectFit" />
                <image class="part part-side-eye"       src="/assets/pets/parrot-side-eye.svg"       mode="aspectFit" />
              </view>
            </view>
          </view>
          <text wx:if="{{animState === 'hungry'}}"  class="state-icon hungry-icon">🍖</text>
          <text wx:if="{{animState === 'dirty'}}"   class="state-icon dirty-icon">💨</text>
          <text wx:if="{{animState === 'sick'}}"    class="state-icon sick-icon">🤒</text>
          <text wx:if="{{animState === 'sad'}}"     class="state-icon sad-icon">💧</text>
          <text wx:if="{{animState === 'happy'}}"   class="state-icon happy-icon">💖</text>
        </view>
        <view wx:elif="{{pet.species}}"
              class="pet-figure species-{{pet.species}} pet-anim-{{currentAnim}} anim-{{animState}}">
          <image class="pet-art" src="/assets/pets/{{pet.species}}.svg" mode="aspectFit" />
          <text wx:if="{{animState === 'hungry'}}"  class="state-icon hungry-icon">🍖</text>
          <text wx:if="{{animState === 'dirty'}}"   class="state-icon dirty-icon">💨</text>
          <text wx:if="{{animState === 'sick'}}"    class="state-icon sick-icon">🤒</text>
          <text wx:if="{{animState === 'sad'}}"     class="state-icon sad-icon">💧</text>
          <text wx:if="{{animState === 'happy'}}"   class="state-icon happy-icon">💖</text>
        </view>
        <view wx:if="{{showBubble}}" class="speech-bubble">{{bubbleText}}</view>
        <view wx:if="{{devAnimLabelVisible}}" class="dev-anim-label">{{devAnimLabel}}</view>
      </view>

      <view class="pet-meta">
        <text>Lv.{{pet.level}}</text>
        <text class="dot">·</text>
        <text>{{ageDays}} 天大</text>
      </view>

      <view class="level-block">
        <block wx:if="{{isMaxLevel}}">
          <view class="level-row">
            <text class="level-label">已满级 Lv.{{levelMax}}</text>
            <text class="level-cost">MAX</text>
          </view>
          <view class="xp-bar xp-bar-max">
            <view class="xp-bar-fill" style="width: 100%"></view>
          </view>
          <text class="level-hint">恭喜达到最高等级,继续每天陪它吧～</text>
        </block>
        <block wx:else>
          <view class="level-row">
            <text class="level-label">升到 Lv.{{pet.level + 1}}</text>
            <text class="level-cost">{{xp}} / {{xpNeeded}} XP</text>
          </view>
          <view class="xp-bar {{canLevelUp ? 'xp-bar-ready' : ''}}">
            <view class="xp-bar-fill" style="width: {{xpPercent}}%"></view>
          </view>
          <text class="xp-rate">每小时 +{{xpPerHour}} XP · 满速 {{xpPerHourMax}}(照顾好宠物可以加快)</text>
          <button class="level-up-btn {{canLevelUp ? '' : 'disabled'}}" bindtap="handleLevelUp">
            {{canLevelUp ? '升级!' : '经验值还不够'}}
          </button>
        </block>
      </view>

      <view class="stat-block">
        <view class="stat-row">
          <text class="field-label">开心度</text>
          <text class="stat-num">{{pet.happiness}}</text>
        </view>
        <progress percent="{{pet.happiness}}" stroke-width="10" activeColor="#ffb648" backgroundColor="#edf0f3" />
      </view>
      <view class="stat-block">
        <view class="stat-row">
          <text class="field-label">饱腹度</text>
          <text class="stat-num">{{pet.fullness}}</text>
        </view>
        <progress percent="{{pet.fullness}}" stroke-width="10" activeColor="#07c160" backgroundColor="#edf0f3" />
      </view>
      <view class="stat-block">
        <view class="stat-row">
          <text class="field-label">清洁度</text>
          <text class="stat-num">{{pet.cleanliness}}</text>
        </view>
        <progress percent="{{pet.cleanliness}}" stroke-width="10" activeColor="#3ea2ff" backgroundColor="#edf0f3" />
      </view>
      <view class="stat-block">
        <view class="stat-row">
          <text class="field-label">健康度</text>
          <text class="stat-num">{{pet.health}}</text>
        </view>
        <progress percent="{{pet.health}}" stroke-width="10" activeColor="#e15c5c" backgroundColor="#edf0f3" />
      </view>
    </view>

    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">宠物商店</text>
        <text class="subtle">用金币照顾它</text>
      </view>

      <view wx:for="{{shopItems}}" wx:key="id" class="shop-item-card">
        <view class="shop-item-text">
          <text class="shop-name">{{item.emoji}} {{item.name}}</text>
          <text class="shop-effect">{{item.effect}}</text>
        </view>
        <button class="mini-btn buy-btn" size="mini" data-id="{{item.id}}" bindtap="handleBuyItem">{{item.price}} 金币</button>
      </view>
    </view>

    <view class="card switch-card" bindtap="handleOpenSwitchPanel">
      <view class="switch-row">
        <text class="switch-emoji">🔄</text>
        <view class="switch-text">
          <text class="switch-title">换宠物</text>
          <text class="switch-sub">{{switchCost}} 金币更换种类，属性和名字都保留</text>
        </view>
        <text class="switch-chev">›</text>
      </view>
    </view>
  </block>

  <!-- 升级动画覆盖层 — 由 handleLevelUp 触发,2.4s 后自动消失。
       全屏暗色背景 + 中央大字 "Lv.X" 弹出 + 星星散开。catchtap 防穿透。 -->
  <view wx:if="{{showLevelUpAnim}}" class="level-up-overlay" catchtap="">
    <view class="level-up-burst">
      <text class="level-up-star star-1">✨</text>
      <text class="level-up-star star-2">⭐</text>
      <text class="level-up-star star-3">✨</text>
      <text class="level-up-star star-4">⭐</text>
      <text class="level-up-star star-5">✨</text>
      <text class="level-up-star star-6">⭐</text>
    </view>
    <view class="level-up-text">
      <text class="level-up-line-1">LEVEL UP!</text>
      <text class="level-up-line-2">Lv.{{levelUpToLevel}}</text>
    </view>
  </view>

  <view wx:if="{{showSwitchPanel}}" class="switch-mask" bindtap="handleCloseSwitchPanel">
    <view class="switch-sheet" catchtap="">
      <view class="switch-sheet-title">选一只想换的</view>
      <view class="switch-sheet-sub">花 {{switchCost}} 金币 · 当前 {{coins}}</view>
      <view class="switch-grid">
        <view wx:for="{{speciesOptions}}"
              wx:key="id"
              class="switch-item {{pet.species === item.id ? 'current' : ''}}"
              data-id="{{item.id}}"
              bindtap="handlePickSwitchSpecies">
          <image class="switch-art" src="/assets/pets/{{item.id}}.svg" mode="aspectFit" />
          <text class="switch-label">{{item.emoji}} {{item.label}}</text>
          <text wx:if="{{pet.species === item.id}}" class="switch-current-tag">当前</text>
        </view>
      </view>
      <button class="switch-cancel" bindtap="handleCloseSwitchPanel">取消</button>
    </view>
  </view>
</view>
