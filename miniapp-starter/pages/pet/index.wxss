.page {
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
}

/* === setup === */
.setup-card { padding: 36rpx 28rpx; }
.setup-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2329;
  text-align: center;
}
.setup-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7785;
  text-align: center;
}
.species-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.species-item {
  padding: 18rpx 6rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
  border: 2rpx solid transparent;
  transition: transform 0.15s, background 0.15s, border-color 0.15s;
}
.species-item.on {
  background: #fff7e0;
  border-color: #ffb648;
  transform: scale(1.04);
}
.species-art {
  display: block;
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto;
}
.species-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #44505e;
}
.setup-name-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
}
.setup-name-label {
  font-size: 28rpx;
  color: #44505e;
  font-weight: 600;
  margin-right: 16rpx;
}
.setup-name-input {
  flex: 1;
  font-size: 28rpx;
}
.setup-confirm {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* === pet stage === */
.pet-stage {
  position: relative;
  margin-top: 22rpx;
  height: 340rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fff7e0 0%, #ffe1a8 60%, #ffce85 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.pet-shadow {
  position: absolute;
  bottom: 36rpx;
  left: 50%;
  width: 220rpx;
  height: 22rpx;
  margin-left: -110rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.18);
  filter: blur(4rpx);
  animation: shadow-pulse 2.4s ease-in-out infinite;
}
.pet-figure {
  position: relative;
  z-index: 1;
}
.pet-art {
  width: 280rpx;
  height: 280rpx;
  display: block;
  transform-origin: center bottom;
}
.state-icon {
  position: absolute;
  font-size: 56rpx;
  line-height: 1;
}
.hungry-icon { top: -16rpx; right: -64rpx; animation: float-up 1.6s ease-in-out infinite; }
.dirty-icon  { top: -10rpx; right: -56rpx; animation: drift 2s ease-in-out infinite; }
.sick-icon   { top: -10rpx; right: -56rpx; animation: tremble 0.5s ease-in-out infinite; }
.sad-icon    {  top: 24rpx; right: -42rpx; animation: drip 2.2s ease-in infinite; }
.happy-icon  { top: -16rpx; right: -56rpx; animation: pop-heart 1.2s ease-out infinite; }

.speech-bubble {
  position: absolute;
  top: 18rpx;
  right: 24rpx;
  max-width: 360rpx;
  background: #ffffff;
  color: #1f2329;
  font-size: 26rpx;
  line-height: 1.4;
  padding: 14rpx 22rpx;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
  animation: bubble-pop 0.25s ease-out;
}

/* === per-state pet animations === */
.anim-idle    .pet-art { animation: breath        2.4s ease-in-out infinite; }
.anim-happy   .pet-art { animation: bounce-happy  0.7s ease-in-out infinite; }
.anim-sad     .pet-art { animation: droop         2.6s ease-in-out infinite; filter: grayscale(0.3); }
.anim-hungry  .pet-art { animation: jitter        0.5s ease-in-out infinite; }
.anim-dirty   .pet-art { animation: wobble        1.2s ease-in-out infinite; filter: brightness(0.9); }
.anim-sick    .pet-art { animation: tremble-slow  0.7s ease-in-out infinite; filter: hue-rotate(-30deg) brightness(0.92); }
.anim-talking .pet-art { animation: talk-pop      0.5s ease-in-out infinite; }

@keyframes breath {
  0%, 100% { transform: scale(1)    translateY(0); }
  50%      { transform: scale(1.04) translateY(-6rpx); }
}
@keyframes bounce-happy {
  0%, 100% { transform: translateY(0)      rotate(-3deg); }
  50%      { transform: translateY(-30rpx) rotate(3deg); }
}
@keyframes droop {
  0%, 100% { transform: translateY(8rpx)  rotate(-2deg); }
  50%      { transform: translateY(14rpx) rotate(2deg); }
}
@keyframes jitter {
  0%, 100% { transform: translateX(0)      rotate(-2deg); }
  25%      { transform: translateX(-8rpx)  rotate(2deg); }
  75%      { transform: translateX(8rpx)   rotate(-3deg); }
}
@keyframes wobble {
  0%, 100% { transform: rotate(-5deg); }
  50%      { transform: rotate(5deg); }
}
@keyframes tremble-slow {
  0%, 100% { transform: translate(0, 0); }
  25%      { transform: translate(-3rpx, 1rpx); }
  50%      { transform: translate(2rpx, -2rpx); }
  75%      { transform: translate(-1rpx, 2rpx); }
}
@keyframes talk-pop {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.06); }
}
@keyframes shadow-pulse {
  0%, 100% { transform: scaleX(1);    opacity: 0.18; }
  50%      { transform: scaleX(0.85); opacity: 0.12; }
}
@keyframes float-up {
  0%   { transform: translateY(0);     opacity: 0; }
  20%  { opacity: 1; }
  100% { transform: translateY(-40rpx); opacity: 0; }
}
@keyframes drift {
  0%, 100% { transform: translateY(-6rpx) rotate(-10deg); opacity: 0.5; }
  50%      { transform: translateY(6rpx)  rotate(10deg);  opacity: 1; }
}
@keyframes tremble {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(-2rpx, 2rpx); }
}
@keyframes drip {
  0%   { transform: translateY(-10rpx); opacity: 0; }
  50%  { opacity: 1; }
  100% { transform: translateY(20rpx);  opacity: 0; }
}
@keyframes pop-heart {
  0%   { transform: scale(0.6); opacity: 0; }
  50%  { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0; }
}
@keyframes bubble-pop {
  0%   { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1);   opacity: 1; }
}

/* === stats === */
.pet-meta {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  color: #6b7785;
  justify-content: center;
}
.pet-meta .dot { color: #c7cdd6; }

.level-block {
  margin-top: 18rpx;
  padding: 18rpx 20rpx 16rpx;
  background: #f7f8fa;
  border-radius: 18rpx;
}
.level-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.level-label {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 600;
}
.level-cost {
  font-size: 24rpx;
  color: #6b7785;
  font-weight: 500;
}
.level-up-btn {
  margin-top: 14rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0 24rpx;
}
.level-up-btn.disabled {
  background: #c7cdd6;
  color: #ffffff;
  opacity: 1;  /* override default disabled-opacity so the label stays readable */
}

.stat-block { margin-top: 18rpx; }
.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.stat-num {
  font-size: 24rpx;
  color: #44505e;
  font-weight: 600;
}

/* === shop === */
.shop-item-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.shop-item-text { flex: 1; }
.shop-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}
.shop-effect {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.buy-btn {
  background: #245bdb;
  color: #ffffff;
}
