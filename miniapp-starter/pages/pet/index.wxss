@import "./pet-anim.wxss";

.page {
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
}

/* === setup === */
.setup-card { padding: 36rpx 28rpx; }
.setup-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2329;
  text-align: center;
}
.setup-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7785;
  text-align: center;
}
.species-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.species-item {
  padding: 18rpx 6rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
  border: 2rpx solid transparent;
  transition: transform 0.15s, background 0.15s, border-color 0.15s;
}
.species-item.on {
  background: #fff7e0;
  border-color: #ffb648;
  transform: scale(1.04);
}
.species-art {
  display: block;
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto;
}
.species-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #44505e;
}
.setup-name-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
}
.setup-name-label {
  font-size: 28rpx;
  color: #44505e;
  font-weight: 600;
  margin-right: 16rpx;
}
.setup-name-input {
  flex: 1;
  font-size: 28rpx;
}
.setup-confirm {
  width: 100%;
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* === pet stage === */
.pet-stage {
  position: relative;
  margin-top: 22rpx;
  height: 340rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fff7e0 0%, #ffe1a8 60%, #ffce85 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.pet-shadow {
  position: absolute;
  bottom: 36rpx;
  left: 50%;
  width: 220rpx;
  height: 22rpx;
  margin-left: -110rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.18);
  filter: blur(4rpx);
  animation: shadow-pulse 2.4s ease-in-out infinite;
}
.pet-figure {
  position: relative;
  z-index: 1;
}
.pet-art {
  width: 280rpx;
  height: 280rpx;
  display: block;
  transform-origin: center bottom;
}
.state-icon {
  position: absolute;
  font-size: 56rpx;
  line-height: 1;
}
.hungry-icon { top: -16rpx; right: -64rpx; animation: float-up 1.6s ease-in-out infinite; }
.dirty-icon  { top: -10rpx; right: -56rpx; animation: drift 2s ease-in-out infinite; }
.sick-icon   { top: -10rpx; right: -56rpx; animation: tremble 0.5s ease-in-out infinite; }
.sad-icon    {  top: 24rpx; right: -42rpx; animation: drip 2.2s ease-in infinite; }
.happy-icon  { top: -16rpx; right: -56rpx; animation: pop-heart 1.2s ease-out infinite; }

.speech-bubble {
  position: absolute;
  top: 18rpx;
  right: 24rpx;
  max-width: 360rpx;
  background: #ffffff;
  color: #1f2329;
  font-size: 26rpx;
  line-height: 1.4;
  padding: 14rpx 22rpx;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
  animation: bubble-pop 0.25s ease-out;
}

/* === vital-state filters ===
   Body animations now live in pet-anim.wxss (Standard) / parrot-anim-* (Premium);
   these `.anim-*` rules only carry the color/filter "mood" tint that overlays
   the canonical action set. See V1-PET-ANIMATION-SPEC §5.5. */
.anim-sad   .pet-art { filter: grayscale(0.3); }
.anim-dirty .pet-art { filter: brightness(0.9); }
.anim-sick  .pet-art { filter: hue-rotate(-30deg) brightness(0.92); }
@keyframes shadow-pulse {
  0%, 100% { transform: scaleX(1);    opacity: 0.18; }
  50%      { transform: scaleX(0.85); opacity: 0.12; }
}
@keyframes float-up {
  0%   { transform: translateY(0);     opacity: 0; }
  20%  { opacity: 1; }
  100% { transform: translateY(-40rpx); opacity: 0; }
}
@keyframes drift {
  0%, 100% { transform: translateY(-6rpx) rotate(-10deg); opacity: 0.5; }
  50%      { transform: translateY(6rpx)  rotate(10deg);  opacity: 1; }
}
@keyframes tremble {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(-2rpx, 2rpx); }
}
@keyframes drip {
  0%   { transform: translateY(-10rpx); opacity: 0; }
  50%  { opacity: 1; }
  100% { transform: translateY(20rpx);  opacity: 0; }
}
@keyframes pop-heart {
  0%   { transform: scale(0.6); opacity: 0; }
  50%  { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0; }
}
@keyframes bubble-pop {
  0%   { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1);   opacity: 1; }
}

/* ============================================================
   Parrot — layered rig prototype for V1-PET-ANIMATION-SPEC.
   Other species keep using `.pet-art` + `anim-{{animState}}`.
   The parrot uses two nested transform layers so locomotion
   (whole-figure translate) and posture (stage breath/bounce)
   can compose without fighting over `transform`. Per-part
   transforms (wing flap, head nod, eye blink) live on the
   inner <image class="part …"> elements.
   ============================================================ */
.parrot-figure {
  width: 280rpx;
  height: 280rpx;
}
.parrot-stage {
  position: relative;
  width: 100%;
  height: 100%;
  transform-origin: center bottom;
}
.parrot-figure .part {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}
/* Pivot points are expressed as percentages of the 200-unit viewBox so
   they line up with the original parrot.svg coordinates. */
.part-wing-left  { transform-origin: 29% 65%; } /* shoulder ≈ (58,130)  */
.part-wing-right { transform-origin: 71% 65%; } /* shoulder ≈ (142,130) */
.part-head       { transform-origin: 50% 56%; } /* neck base ≈ (100,112) */
.part-eyes       { transform-origin: 50% 35%; } /* eye row  ≈ (100,70)  */
.part-body       { transform-origin: 50% 70%; }

/* === IDLE: gentle breath + occasional blink + tiny wing flutter === */
.parrot-anim-idle .parrot-stage     { animation: parrot-breath      3.0s ease-in-out infinite; }
.parrot-anim-idle .part-eyes        { animation: parrot-blink       4.5s ease-in-out infinite; }
.parrot-anim-idle .part-wing-left   { animation: parrot-flutter-l   3.0s ease-in-out infinite; }
.parrot-anim-idle .part-wing-right  { animation: parrot-flutter-r   3.0s ease-in-out infinite; }

/* === WALKING: figure translates X, stage bobs Y, wings flutter faster === */
.parrot-anim-walking                { animation: parrot-walk-x      9s   ease-in-out infinite; }
.parrot-anim-walking .parrot-stage  { animation: parrot-walk-bounce 0.55s ease-in-out infinite; }
.parrot-anim-walking .part-wing-left  { animation: parrot-flutter-l 0.55s ease-in-out infinite; }
.parrot-anim-walking .part-wing-right { animation: parrot-flutter-r 0.55s ease-in-out infinite; }
.parrot-anim-walking .part-eyes     { animation: parrot-blink       4.5s ease-in-out infinite; }

/* === FLYING: cross-screen X arc, Y rise, wings flap fast === */
.parrot-anim-flying                 { animation: parrot-fly-x       3.5s ease-in-out 1; }
.parrot-anim-flying .parrot-stage   { animation: parrot-fly-y       3.5s ease-in-out 1; }
.parrot-anim-flying .part-wing-left  { animation: parrot-flap-l-fast 0.16s ease-in-out infinite; }
.parrot-anim-flying .part-wing-right { animation: parrot-flap-r-fast 0.16s ease-in-out infinite; }

/* === EATING: head nods, body sways === */
.parrot-anim-eating .part-head      { animation: parrot-nod         0.42s ease-in-out infinite; }
.parrot-anim-eating .part-eyes      { animation: parrot-nod         0.42s ease-in-out infinite; }
.parrot-anim-eating .parrot-stage   { animation: parrot-sway        0.84s ease-in-out infinite; }

/* === CELEBRATING: 3D-feel rotateY spin + two jumps + big wing flaps === */
/* rotateY (with perspective) sells a true 3D rotation: at 90°/270° the flat
   sprite flattens edge-on, suggesting the parrot is showing its side/back. */
.parrot-anim-celebrating              { animation: parrot-celebrate-rot-3d 2s ease-in-out 1; }
.parrot-anim-celebrating .parrot-stage{ animation: parrot-celebrate-jump   1s ease-in-out 2; }
.parrot-anim-celebrating .part-wing-left  { animation: parrot-flap-l-big 0.22s ease-in-out infinite; }
.parrot-anim-celebrating .part-wing-right { animation: parrot-flap-r-big 0.22s ease-in-out infinite; }

/* === SLEEPING: very slow breath, eyes squashed shut === */
.parrot-anim-sleeping .parrot-stage { animation: parrot-sleep-breath 4s   ease-in-out infinite; }
.parrot-anim-sleeping .part-eyes    { transform: scaleY(0.05); }

/* --- keyframes --- */
@keyframes parrot-breath {
  0%, 100% { transform: scale(1.00) translateY(0); }
  50%      { transform: scale(1.03) translateY(-4rpx); }
}
@keyframes parrot-blink {
  0%, 92%, 100% { transform: scaleY(1); }
  95%, 97%      { transform: scaleY(0.05); }
}
@keyframes parrot-flutter-l {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(-6deg); }
}
@keyframes parrot-flutter-r {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(6deg); }
}
@keyframes parrot-walk-x {
  0%,  100% { transform: translateX(0); }
  25%       { transform: translateX(-80rpx); }
  50%       { transform: translateX(0); }
  75%       { transform: translateX(80rpx); }
}
@keyframes parrot-walk-bounce {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}
@keyframes parrot-fly-x {
  0%   { transform: translateX(-260rpx); opacity: 0; }
  10%  { transform: translateX(-220rpx); opacity: 1; }
  90%  { transform: translateX(220rpx);  opacity: 1; }
  100% { transform: translateX(260rpx);  opacity: 0; }
}
@keyframes parrot-fly-y {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-60rpx); }
}
@keyframes parrot-flap-l-fast {
  0%, 100% { transform: rotate(15deg); }
  50%      { transform: rotate(-30deg); }
}
@keyframes parrot-flap-r-fast {
  0%, 100% { transform: rotate(-15deg); }
  50%      { transform: rotate(30deg); }
}
@keyframes parrot-flap-l-big {
  0%, 100% { transform: rotate(20deg); }
  50%      { transform: rotate(-50deg); }
}
@keyframes parrot-flap-r-big {
  0%, 100% { transform: rotate(-20deg); }
  50%      { transform: rotate(50deg); }
}
@keyframes parrot-nod {
  0%, 100% { transform: rotate(0deg)   translateY(0); }
  50%      { transform: rotate(-22deg) translateY(6rpx); }
}
@keyframes parrot-sway {
  0%, 100% { transform: translateX(0); }
  25%      { transform: translateX(-6rpx); }
  75%      { transform: translateX(6rpx); }
}
@keyframes parrot-celebrate-rot-3d {
  0%   { transform: perspective(600px) rotateY(0deg); }
  100% { transform: perspective(600px) rotateY(360deg); }
}
@keyframes parrot-celebrate-jump {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-50rpx); }
}
@keyframes parrot-sleep-breath {
  0%, 100% { transform: scale(1.00) translateY(0); }
  50%      { transform: scale(0.97) translateY(2rpx); }
}

/* ============================================================
   Parrot — side-view rig (V1-PET-ANIMATION-SPEC §1.1).
   walking / flying / eating swap from front to side so the
   parrot reads as a real 3D body, not a flat sprite. The
   side-flip wrapper handles direction reversal (scaleX) for
   walking; eating layers a small rotateY perspective so the
   peck angle reads as 3/4 view, not pure profile.
   ============================================================ */
.rig-side {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: none;
}
.rig-side .side-flip {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-origin: center bottom;
}
/* Side-rig pivots — percentages map back to the 200-unit viewBox of each
   side-* SVG so transforms hinge at the right anatomical point. */
.part-side-body      { transform-origin: 54% 65%; }
.part-side-head      { transform-origin: 61% 54%; } /* neck base ≈ (122,108) */
.part-side-eye       { transform-origin: 71% 37%; }
.part-side-wing      { transform-origin: 47% 50%; } /* shoulder ≈ (95,100)  */
.part-side-leg-front { transform-origin: 59% 88%; }
.part-side-leg-back  { transform-origin: 48% 88%; }

/* Show the side rig (and hide the front one) for states that use it. */
.parrot-anim-walking .rig-front,
.parrot-anim-flying  .rig-front,
.parrot-anim-eating  .rig-front  { display: none; }
.parrot-anim-walking .rig-side,
.parrot-anim-flying  .rig-side,
.parrot-anim-eating  .rig-side   { display: block; }

/* === WALKING (side): mirror at each direction reversal + step legs === */
.parrot-anim-walking .side-flip {
  /* Snap-flip aligned with parrot-walk-x: face-left → face-right → face-left.
     steps(1, jump-end) keeps each segment a constant scaleX. */
  animation: parrot-walk-flip 9s steps(1, jump-end) infinite;
}
.parrot-anim-walking .part-side-leg-front {
  animation: parrot-leg-step-a 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-leg-back {
  animation: parrot-leg-step-b 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-wing {
  animation: parrot-side-flutter 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-head {
  animation: parrot-side-head-bob 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-eye {
  animation: parrot-blink 4.5s ease-in-out infinite;
}

/* === FLYING (side): big wing flap, side rig stays facing right === */
.parrot-anim-flying .part-side-wing {
  animation: parrot-side-flap-fast 0.18s ease-in-out infinite;
}
.parrot-anim-flying .part-side-eye {
  animation: parrot-blink 4.5s ease-in-out infinite;
}

/* === EATING (side, 3/4 perspective): peck head down, body sways === */
.parrot-anim-eating .side-flip {
  transform: perspective(500px) rotateY(-22deg);
}
.parrot-anim-eating .part-side-head {
  animation: parrot-side-peck 0.42s ease-in-out infinite;
}
.parrot-anim-eating .part-side-eye {
  animation: parrot-side-peck 0.42s ease-in-out infinite;
  transform-origin: 61% 54%;  /* match head pivot so eye rides with the peck */
}

/* --- side-rig keyframes --- */
@keyframes parrot-walk-flip {
  0%   { transform: scaleX(-1); }  /* heading left from center */
  25%  { transform: scaleX(1);  }  /* turn at peak left, head back to right */
  75%  { transform: scaleX(-1); }  /* turn at peak right, head back to left */
}
@keyframes parrot-leg-step-a {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}
@keyframes parrot-leg-step-b {
  0%, 100% { transform: translateY(-6rpx); }
  50%      { transform: translateY(0); }
}
@keyframes parrot-side-flutter {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(-6deg); }
}
@keyframes parrot-side-head-bob {
  0%, 100% { transform: translateY(0)     rotate(0deg); }
  50%      { transform: translateY(-2rpx) rotate(-2deg); }
}
@keyframes parrot-side-flap-fast {
  0%, 100% { transform: rotate(20deg); }
  50%      { transform: rotate(-35deg); }
}
@keyframes parrot-side-peck {
  0%, 100% { transform: rotate(0deg)  translateY(0); }
  50%      { transform: rotate(28deg) translateY(8rpx); }
}

/* === stats === */
.pet-meta {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  color: #6b7785;
  justify-content: center;
}
.pet-meta .dot { color: #c7cdd6; }

.level-block {
  margin-top: 18rpx;
  padding: 18rpx 20rpx 16rpx;
  background: #f7f8fa;
  border-radius: 18rpx;
}
.level-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.level-label {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 600;
}
.level-cost {
  font-size: 24rpx;
  color: #6b7785;
  font-weight: 500;
}
.level-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7785;
  line-height: 1.5;
}

.level-up-btn {
  margin-top: 12rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: #245bdb;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  box-sizing: border-box;
}
.level-up-btn.disabled {
  background: #c7cdd6;
  color: #f7f8fa;
}
.level-up-btn::after { border: none; }

/* === XP progress bar — 替换原来的"花 N 金币"行 === */
.xp-bar {
  margin-top: 10rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #edf0f3;
  overflow: hidden;
  position: relative;
}
.xp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6aa6ff 0%, #245bdb 100%);
  border-radius: 999rpx;
  transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}
/* 经验值满 → 进度条变金色 + 微微脉动,提示"可以点升级了"。 */
.xp-bar-ready .xp-bar-fill {
  background: linear-gradient(90deg, #ffcf6a 0%, #ff9c1f 100%);
  animation: xp-ready-pulse 1.6s ease-in-out infinite;
}
.xp-bar-max .xp-bar-fill {
  background: linear-gradient(90deg, #ffd166 0%, #f5a623 100%);
}
@keyframes xp-ready-pulse {
  0%, 100% { filter: brightness(1);    box-shadow: 0 0 0 rgba(255, 156, 31, 0); }
  50%      { filter: brightness(1.15); box-shadow: 0 0 12rpx rgba(255, 156, 31, 0.5); }
}

/* 下一小时预览段:贴在主蓝条右侧,由 0 逐步长到 --preview-width(%),
   完成后停一小段再循环,看起来像"经验在慢慢涨"。border-radius 只取右端,
   防止跟主条左端拼接处出现圆角断层。
   颜色:左端 = 主条右端同色 #245bdb 实色(无缝衔接,消除原版的"白色间隙"
   视觉断层),向右渐变到非常浅的蓝色 #dceaff —— 距离越远越浅,直观体现
   "即将获得但还没拿到"。无 opacity 整体衰减(否则左端不是真的同色)。 */
.xp-bar-preview {
  position: absolute;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #245bdb 0%, #dceaff 100%);
  border-radius: 0 999rpx 999rpx 0;
  animation: xp-preview-grow 2.4s ease-in-out infinite;
}
/* width 补 +9rpx 是 wxml 里 left 减了 9rpx 的对应补偿 —— 让最终视觉上预览段
   还是 --preview-width %(下一小时实发 XP 长度),左端往左挪只是为了盖主条圆角。 */
@keyframes xp-preview-grow {
  0%   { width: 0;                                 opacity: 0; }
  10%  {                                           opacity: 1; }
  70%  { width: calc(var(--preview-width) + 9rpx); opacity: 1; }
  90%  { width: calc(var(--preview-width) + 9rpx); opacity: 0; }
  100% { width: 0;                                 opacity: 0; }
}

/* === 升级动画 overlay === */
.level-up-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at center, rgba(20, 30, 60, 0.55) 0%, rgba(20, 30, 60, 0.85) 100%);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: level-up-fade-in 0.18s ease-out;
}
@keyframes level-up-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.level-up-text {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.level-up-line-1 {
  font-size: 56rpx;
  font-weight: 900;
  color: #ffd166;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 18rpx rgba(255, 209, 102, 0.6),
               0 0 32rpx rgba(255, 209, 102, 0.45);
  animation: level-up-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.level-up-line-2 {
  font-size: 140rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 6rpx 24rpx rgba(255, 255, 255, 0.4),
               0 0 60rpx rgba(255, 209, 102, 0.55);
  animation: level-up-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}
@keyframes level-up-pop {
  0%   { transform: scale(0.2) rotate(-8deg); opacity: 0; }
  60%  { transform: scale(1.15) rotate(2deg); opacity: 1; }
  100% { transform: scale(1) rotate(0);       opacity: 1; }
}
.level-up-burst {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.level-up-star {
  position: absolute;
  top: 50%;
  left: 50%;
  font-size: 56rpx;
  line-height: 1;
  opacity: 0;
  animation: star-fly 1.6s ease-out 0.3s forwards;
}
/* 6 颗星呈放射状散开。每颗 angle / distance 不一样,通过 --tx --ty 自定义。 */
.star-1 { --tx: -340rpx; --ty: -260rpx; animation-delay: 0.30s; }
.star-2 { --tx:  340rpx; --ty: -260rpx; animation-delay: 0.36s; }
.star-3 { --tx: -380rpx; --ty:   40rpx; animation-delay: 0.42s; }
.star-4 { --tx:  380rpx; --ty:   40rpx; animation-delay: 0.48s; }
.star-5 { --tx: -300rpx; --ty:  280rpx; animation-delay: 0.54s; }
.star-6 { --tx:  300rpx; --ty:  280rpx; animation-delay: 0.60s; }
@keyframes star-fly {
  0%   { transform: translate(-50%, -50%) scale(0.4) rotate(0);    opacity: 0; }
  20%  { transform: translate(-50%, -50%) scale(1.4) rotate(40deg); opacity: 1; }
  100% {
    transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1) rotate(180deg);
    opacity: 0;
  }
}

.stat-block { margin-top: 18rpx; }
.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.stat-num {
  font-size: 24rpx;
  color: #44505e;
  font-weight: 600;
}
/* 开心度冻结提示 — 全完成后 12 小时内不下降的小标签。 */
.stat-hint {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e6f4ff;
  color: #1167b0;
  font-size: 22rpx;
  line-height: 1.5;
}

/* === shop === */
.shop-item-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.shop-item-text { flex: 1; }
.shop-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}
.shop-effect {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.buy-btn {
  background: #245bdb;
  color: #ffffff;
}

/* === switch-pet entry === */
.switch-card {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
}
.switch-row {
  display: flex;
  align-items: center;
}
.switch-emoji {
  font-size: 44rpx;
  margin-right: 18rpx;
}
.switch-text { flex: 1; }
.switch-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.switch-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7785;
}
.switch-chev {
  font-size: 40rpx;
  color: #c7cdd6;
  line-height: 1;
}

/* 顶部 "金币 X ›" 入口 — 点开金币记录 */
.coin-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff4d6;
}
.coin-link .coin-balance {
  color: #b45309;
  font-weight: 600;
}
.coin-link .coin-chev {
  font-size: 26rpx;
  line-height: 1;
  color: #b45309;
}

/* === switch-pet picker sheet === */
.switch-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
  animation: switch-fade 0.18s ease-out;
}
.switch-sheet {
  width: 100%;
  max-width: 720rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: switch-slide 0.22s ease-out;
}
.switch-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  text-align: center;
}
.switch-sheet-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7785;
  text-align: center;
}
.switch-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.switch-item {
  position: relative;
  padding: 18rpx 6rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
  border: 2rpx solid transparent;
}
.switch-item.current {
  background: #eceef2;
  border-color: #c7cdd6;
  opacity: 0.6;
}
.switch-art {
  display: block;
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto;
}
.switch-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #44505e;
}
.switch-current-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #6b7785;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}
.switch-cancel {
  margin-top: 22rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #f7f8fa;
  color: #44505e;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
@keyframes switch-fade {
  0%   { opacity: 0; }
  100% { opacity: 1; }
}
@keyframes switch-slide {
  0%   { transform: translateY(100%); }
  100% { transform: translateY(0); }
}
