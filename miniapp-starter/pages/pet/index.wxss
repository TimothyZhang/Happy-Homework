@import "./pet-anim.wxss";

.page {
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom));
}

/* === setup === */
.setup-card { padding: 36rpx 28rpx; }
.setup-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2329;
  text-align: center;
}
.setup-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7785;
  text-align: center;
}
.species-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.species-item {
  padding: 18rpx 6rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
  border: 2rpx solid transparent;
  transition: transform 0.15s, background 0.15s, border-color 0.15s;
}
.species-item.on {
  background: #fff7e0;
  border-color: #ffb648;
  transform: scale(1.04);
}
.species-art {
  display: block;
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto;
}
.species-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #44505e;
}
.setup-name-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
}
.setup-name-label {
  font-size: 28rpx;
  color: #44505e;
  font-weight: 600;
  margin-right: 16rpx;
}
.setup-name-input {
  flex: 1;
  font-size: 28rpx;
}
.setup-confirm {
  width: 100%;
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #245bdb 0%, #1546b5 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* === 全屏 2.5D 室内房间 ===
   .room 是 fixed 全屏背景:上半截墙(壁纸 + 窗 + 挂画),下半截木地板 + 地毯。
   宠物(.pet-actor)以脚底为锚点用 room 百分比定位(left/top 由 JS 设),深度
   缩放 + transition 时长走内联 style;CSS 管房间外观、侧面朝向翻转与姿态动画。
   控制卡片在 .sheet 里,顶部留 72vh 空当看房间,往上滚盖住下半截。 */
.room {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  overflow: hidden;
  z-index: 0;
  background: #f3e2cb;
}
.room-wall {
  position: absolute; left: 0; right: 0; top: 0; height: 34%;
  background:
    repeating-linear-gradient(90deg, rgba(255,255,255,0) 0, rgba(255,255,255,0) 58rpx, rgba(255,255,255,0.10) 58rpx, rgba(255,255,255,0.10) 60rpx),
    linear-gradient(180deg, #fce8d2 0%, #f1d6b4 100%);
}
/* 窗:框 + 蓝天 + 十字窗棂;overflow:hidden 让白云被裁在窗内 */
.room-window {
  position: absolute; top: 6%; right: 6%; width: 28%; height: 25%;
  box-sizing: border-box;
  overflow: hidden;
  border: 9rpx solid #fff7ec;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #a8defb 0%, #d3eeff 58%, #ecf8e8 100%);
  box-shadow: 0 8rpx 18rpx rgba(120,90,50,0.14);
}
/* 偶尔飘过的白云:从窗左飘到窗右,有一段在窗外(留间隔) */
.room-cloud {
  position: absolute; top: 24%; left: 0;
  width: 52%; height: 28%;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 16rpx 6rpx 0 -4rpx #ffffff, -14rpx 8rpx 0 -6rpx #ffffff;
  opacity: 0;
  animation: cloud-drift 22s linear infinite;
}
@keyframes cloud-drift {
  0%   { transform: translateX(-170%); opacity: 0; }
  14%  { opacity: 0.96; }
  50%  { transform: translateX(120%);  opacity: 0.96; }
  64%  { opacity: 0; }
  100% { transform: translateX(240%);  opacity: 0; }
}
.room-window-bar { position: absolute; background: #fff7ec; }
.room-window-bar-v { top: 0; bottom: 0; left: 50%; width: 8rpx; margin-left: -4rpx; }
.room-window-bar-h { left: 0; right: 0; top: 50%; height: 8rpx; margin-top: -4rpx; }
/* 墙上标语海报:好好学习,天天向上 */
.room-picture {
  position: absolute; top: 9%; left: 45%; width: 19%; height: 22%;
  box-sizing: border-box;
  border: 8rpx solid #fff7ec;
  border-radius: 8rpx;
  box-shadow: 0 6rpx 14rpx rgba(120,90,50,0.14);
}
.room-poster {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: linear-gradient(180deg, #fffaf0 0%, #fff1d8 100%);
}
.poster-line {
  font-size: 26rpx; font-weight: 800; letter-spacing: 6rpx;
  color: #d8442f; line-height: 1.55;
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.7);
}
/* 踢脚线:墙地分界 */
.room-baseboard {
  position: absolute; left: 0; right: 0; top: 34%; height: 20rpx; margin-top: -20rpx;
  background: linear-gradient(180deg, #d3ab7c 0%, #c2965f 100%);
}
/* 木地板:竖向木缝 + 由远向近的暖色渐变 */
.room-floor {
  position: absolute; left: 0; right: 0; top: 34%; bottom: 0;
  background:
    repeating-linear-gradient(90deg, rgba(120,80,40,0.12) 0, rgba(120,80,40,0.12) 2rpx, transparent 2rpx, transparent 96rpx),
    linear-gradient(180deg, #e9c89c 0%, #d9b07c 55%, #cca06b 100%);
  box-shadow: inset 0 12rpx 24rpx rgba(120,80,40,0.20);
}
/* 地毯 */
.room-rug {
  position: absolute; left: 50%; top: 58%; width: 70%; height: 30%; margin-left: -35%;
  border-radius: 50%;
  background: radial-gradient(ellipse at 50% 50%, #ffdcc6 0%, #ffc4a2 52%, #f0a886 100%);
  box-shadow: inset 0 0 0 8rpx rgba(255,255,255,0.45);
  opacity: 0.95;
}

/* ============================================================
   城堡房间主题(白天·金碧辉煌,.theme-castle 覆盖温馨小屋)
   ============================================================ */
.room.theme-castle { background: #efdcb0; }
/* 奶金大理石墙 + 竖向金壁柱条 */
.theme-castle .room-wall {
  background:
    repeating-linear-gradient(90deg, transparent 0, transparent 146rpx, rgba(201,158,62,0.28) 146rpx, rgba(201,158,62,0.28) 152rpx, transparent 152rpx, transparent 158rpx),
    linear-gradient(180deg, #fff7e6 0%, #f4e3bd 68%, #ecd6a6 100%);
}
/* 拱形金框窗 + 白天蓝天(保留飘云) */
.theme-castle .room-window {
  border-color: #dcb24e; border-width: 12rpx;
  border-radius: 50% 50% 8rpx 8rpx;
  background: linear-gradient(180deg, #74c4f4 0%, #aee0ff 52%, #e9f7ff 100%);
  box-shadow: 0 8rpx 18rpx rgba(120,90,30,0.22), inset 0 0 0 3rpx rgba(255,240,190,0.6);
}
.theme-castle .room-window-bar { background: #dcb24e; }
.castle-sun {
  position: absolute; top: 12%; right: 12%;
  width: 34%; height: 34%; border-radius: 50%;
  background: radial-gradient(circle at 42% 40%, #fffceb 0%, #ffe680 56%, #ffcf3a 100%);
  box-shadow: 0 0 30rpx 10rpx rgba(255,210,90,0.6);
}
/* 海报 → 金框红底挂旗(保留标语);左移让出顶部中央给吊灯 */
.theme-castle .room-picture { left: 7%; border-color: #d9b24e; border-width: 9rpx; box-shadow: 0 6rpx 16rpx rgba(150,110,30,0.28); }
.theme-castle .room-poster {
  background: linear-gradient(180deg, #c23046 0%, #97203a 100%);
  box-shadow: inset 0 0 0 4rpx rgba(255,236,176,0.7);
}
.theme-castle .poster-line { color: #ffe9b8; text-shadow: 0 1rpx 0 rgba(0,0,0,0.3); }
/* 踢脚线 → 金线 */
.theme-castle .room-baseboard { background: linear-gradient(180deg, #f0d27a 0%, #cba23a 100%); }
/* 抛光奶金大理石地 */
.theme-castle .room-floor {
  background:
    repeating-linear-gradient(90deg, rgba(170,130,50,0.10) 0, rgba(170,130,50,0.10) 2rpx, transparent 2rpx, transparent 118rpx),
    linear-gradient(180deg, #f7ecd0 0%, #ecd9ad 55%, #ddc492 100%);
  box-shadow: inset 0 12rpx 26rpx rgba(150,110,40,0.20);
}
/* 红毯(中间一条,金边) */
.theme-castle .room-rug {
  left: 50%; top: 50%; width: 44%; height: 46%; margin-left: -22%;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #c23046 0%, #97203a 100%);
  box-shadow: inset 0 0 0 8rpx rgba(232,196,92,0.9);
  opacity: 0.96;
}
/* 两侧金柱(撑起殿堂感) */
.castle-pillar {
  position: absolute; top: 0; bottom: 0; width: 48rpx; z-index: 3;
  background: linear-gradient(90deg, #c99a3a 0%, #fff0c0 34%, #e8c873 56%, #c0922f 100%);
  box-shadow: 0 0 14rpx rgba(120,80,20,0.25);
}
.castle-pillar-l { left: 0; }
.castle-pillar-r { right: 0; }
.castle-pillar::before {  /* 柱头 */
  content: ''; position: absolute; left: -6rpx; right: -6rpx; top: 30%; height: 22rpx;
  background: linear-gradient(180deg, #fff0c0 0%, #d9b657 100%);
  border-radius: 4rpx; box-shadow: 0 2rpx 6rpx rgba(120,80,20,0.25);
}
/* 金吊灯(顶部中央,轻轻摇) */
.castle-chandelier {
  position: absolute; top: -1%; left: 50%; margin-left: -92rpx;
  width: 184rpx; height: 164rpx; z-index: 5;
  transform-origin: 50% 4%;
  animation: chandelier-sway 4.2s ease-in-out infinite;
}
@keyframes chandelier-sway {
  0%, 100% { transform: rotate(-1.6deg); }
  50%      { transform: rotate(1.6deg); }
}

/* === 换房间背景弹窗 === */
.room-picker-mask {
  position: fixed; inset: 0; z-index: 140;
  background: rgba(20, 16, 28, 0.5);
  display: flex; align-items: center; justify-content: center;
}
.room-picker {
  width: 600rpx; background: #ffffff; border-radius: 28rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 18rpx 50rpx rgba(0,0,0,0.3);
}
.room-picker-title { font-size: 32rpx; font-weight: 800; color: #1f2329; text-align: center; }
.room-picker-grid { display: flex; gap: 20rpx; margin-top: 24rpx; }
.rp-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 14rpx 12rpx 18rpx; border-radius: 18rpx;
  box-shadow: inset 0 0 0 3rpx #eef1f5;
}
.rp-item.on { box-shadow: inset 0 0 0 4rpx #245bdb; background: #f5f8ff; }
.rp-hover { background: #f0f3f8; }
.rp-thumb { width: 100%; height: 150rpx; border-radius: 12rpx; }
.rp-thumb-cozy {
  background:
    linear-gradient(180deg, #fce8d2 0%, #f1d6b4 46%, transparent 46%),
    linear-gradient(180deg, transparent 46%, #e9c89c 46%, #cca06b 100%);
}
.rp-thumb-castle {
  background:
    linear-gradient(180deg, #fff7e6 0%, #ecd6a6 40%, transparent 40%),
    linear-gradient(180deg, transparent 40%, #f7ecd0 40%, #ddc492 100%);
  box-shadow: inset 0 0 0 3rpx rgba(217,178,78,0.6);
}
.rp-name { margin-top: 12rpx; font-size: 28rpx; font-weight: 700; color: #1f2329; }
.rp-tag {
  margin-top: 8rpx; font-size: 22rpx; font-weight: 700;
  color: #ffffff; background: #245bdb; border-radius: 999rpx; padding: 4rpx 18rpx;
}
.rp-tag.ghost { color: #245bdb; background: #eef4ff; }
.room-picker-close {
  margin-top: 26rpx; text-align: center; height: 80rpx; line-height: 80rpx;
  border-radius: 999rpx; background: #f1f3f6; color: #5a6573; font-size: 30rpx; font-weight: 700;
}

/* the walking pet — feet anchored at (left,top); JS sets translate+scale(depth)
   + per-move transition-duration inline so it glides between points. */
.pet-actor {
  position: absolute;
  width: 240rpx; height: 240rpx;
  transform-origin: 50% 100%;
  transition-property: left, top, transform;
  transition-timing-function: linear;
  transition-duration: 0ms;
  will-change: left, top, transform;
}
.actor-shadow {
  position: absolute; left: 50%; bottom: 4rpx;
  width: 150rpx; height: 26rpx; margin-left: -75rpx;
  border-radius: 50%;
  background: rgba(60, 45, 25, 0.26);
  filter: blur(5rpx);
}
/* side-view facing: left mirrors the sprite; right keeps原图。Flip on its own
   wrapper so it never fights the posture animation. */
.actor-facing { transform: scaleX(1); }
.pet-actor.face-left .actor-facing { transform: scaleX(-1); }
.actor-sprite { display: block; }
.pet-art {
  width: 240rpx; height: 240rpx;
  display: block;
  transform-origin: 50% 90%;
}

/* === 固定顶栏 HUD === */
.top-hud {
  position: fixed; left: 0; right: 0; top: 0;
  z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 14rpx) 28rpx 16rpx;
  background: linear-gradient(180deg, rgba(252,232,210,0.94) 0%, rgba(252,232,210,0) 100%);
}
.hud-name {
  font-size: 34rpx; font-weight: 800; color: #5a3d1e;
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.6);
}
.hud-coin {
  display: flex; align-items: center;
  background: rgba(255,255,255,0.9);
  border-radius: 999rpx; padding: 8rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(120,90,50,0.16);
}
.hud-coin-text { font-size: 26rpx; color: #c8862a; font-weight: 700; }
.hud-coin .coin-chev { color: #d9b48a; margin-left: 4rpx; }

/* === 控制卡片层(盖在房间上,可滚) === */
.sheet { position: relative; z-index: 10; }
/* 顶部留空看房间;往上滚,卡片盖住下半截房间。 */
.sheet .sheet-first { margin-top: 76vh; }
.sheet .card { background: rgba(255, 255, 255, 0.96); }

/* === 透明状态浮窗(紧凑 4 条状态条,半透明浮在房间上)=== */
.status-hud {
  position: fixed;
  left: 20rpx;
  top: calc(env(safe-area-inset-top) + 96rpx);
  width: 320rpx;
  z-index: 40;
  box-sizing: border-box;
  padding: 14rpx 18rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.40);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 6rpx 16rpx rgba(80, 60, 30, 0.12);
}
.status-meta {
  display: flex; align-items: center;
  font-size: 22rpx; color: #6b4a23; font-weight: 600;
  margin-bottom: 8rpx;
}
.status-meta .dot { margin: 0 8rpx; color: #b79a72; }
/* 知识单独一行 —— 跟 Lv/天大 挤一行会被浮窗宽度截掉看不到 */
.status-know-line { font-size: 22rpx; font-weight: 700; color: #7a5af0; }
.svrow { display: flex; align-items: center; margin-top: 9rpx; }
.svlabel { width: 52rpx; flex-shrink: 0; font-size: 20rpx; color: #5a3d1e; }
.sbar {
  flex: 1; height: 10rpx; margin: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(60, 45, 25, 0.18);
  overflow: hidden;
}
.sbar-fill { height: 100%; border-radius: 999rpx; }
.svnum { width: 42rpx; flex-shrink: 0; text-align: right; font-size: 20rpx; font-weight: 600; color: #5a3d1e; }

/* posture — kept off the actor's translate so locomotion never fights it. */
.pet-actor.still .pet-art       { animation: actor-breath 2.8s ease-in-out infinite; }
.pet-actor.moving .pet-art      { animation: actor-step 0.46s ease-in-out infinite; }
/* 静止时身体每 ~6s「活泼顶一下 + 小歪头」,叠在 .pet-art 的呼吸之上。两个动画挂
   不同层级元素(sprite / art),transform 各自独立不打架;一次性动作播放期间 actor
   既非 still 也非 moving,这条不跑,不会和 do-* 抢身体。 */
.pet-actor.still .actor-sprite  { transform-origin: bottom center; animation: actor-idle 6s ease-in-out infinite; }
.pet-actor.do-eating .pet-art      { animation: actor-eat 0.42s ease-in-out 4; }
.pet-actor.do-happy .pet-art       { animation: actor-pop 1.2s ease-out 1; }
.pet-actor.do-celebrating .pet-art { animation: actor-spin 1s ease-in-out 2; }

/* mood tint overlays (unwell) */
.pet-actor.anim-sad .pet-art   { filter: grayscale(0.3); }
.pet-actor.anim-dirty .pet-art { filter: brightness(0.9); }
.pet-actor.anim-sick .pet-art  { filter: hue-rotate(-30deg) brightness(0.92); }

@keyframes actor-breath {
  0%, 100% { transform: scale(1)    translateY(0); }
  50%      { transform: scale(1.03) translateY(-5rpx); }
}
@keyframes actor-step {
  0%, 100% { transform: translateY(0)     rotate(0deg); }
  25%      { transform: translateY(-9rpx) rotate(-3deg); }
  75%      { transform: translateY(-9rpx) rotate(3deg); }
}
@keyframes actor-idle {
  0%, 60%, 100% { transform: translateY(0)      rotate(0deg); }
  70%           { transform: translateY(-7rpx)  rotate(-3deg); }
  80%           { transform: translateY(-13rpx) rotate(2deg); }
  90%           { transform: translateY(0)      rotate(-1deg); }
}
@keyframes actor-eat {
  0%, 100% { transform: rotate(0deg)   translateY(0); }
  50%      { transform: rotate(-10deg) translateY(7rpx); }
}
@keyframes actor-pop {
  0%   { transform: scale(1)    translateY(0); }
  25%  { transform: scale(1.12) translateY(-26rpx); }
  50%  { transform: scale(0.96) translateY(0); }
  70%  { transform: scale(1.05) translateY(-10rpx); }
  100% { transform: scale(1)    translateY(0); }
}
@keyframes actor-spin {
  0%   { transform: perspective(600px) rotateY(0deg); }
  100% { transform: perspective(600px) rotateY(360deg); }
}

/* ============================================================
   猫·骨骼分层 rig —— DragonBones 那种「骨骼 articulation」,这里用分层 SVG +
   关键帧原生实现(零依赖、可被 face-left 整体镜像、跟深度缩放)。每层都是 240rpx
   同框、绕各自关节 transform-origin 转;头+眼包一层一起点头,眼再单独眨。
   仅 cat 启用;其他物种仍走扁平 .pet-art。
   ============================================================ */
.pet-rig { position: relative; width: 240rpx; height: 240rpx; transform-origin: 50% 96%; }
.pet-rig .cr-layer,
.pet-rig .cr-head-grp {
  position: absolute; left: 0; top: 0; width: 240rpx; height: 240rpx; display: block;
}
/* 关节 pivot(百分比对应每个分层 SVG 的 200 视口) */
.cr-tail      { transform-origin: 30% 57%; }
.cr-leg-back  { transform-origin: 54% 69%; }
.cr-body      { transform-origin: 52% 75%; }
.cr-leg-front { transform-origin: 54% 70%; }
.cr-head-grp  { transform-origin: 65% 56%; }
.cr-eye       { transform-origin: 79% 45%; }

/* 用 rig 时关掉父层 actor-sprite 的待机小跳(rig 自带更丰富的待机) */
.pet-actor.still .actor-sprite.has-rig { animation: none; }

/* 不适时给整只 rig 上色调滤镜,跟扁平 .pet-art 同款 */
.pet-actor.anim-sad .pet-rig   { filter: grayscale(0.3); }
.pet-actor.anim-dirty .pet-rig { filter: brightness(0.9); }
.pet-actor.anim-sick .pet-rig  { filter: hue-rotate(-30deg) brightness(0.92); }

/* —— 待机 —— 呼吸 + 慢点头 + 尾巴轻摆 + 偶尔眨眼 */
.pet-rig.idle .cr-body     { animation: cat-breath 2.8s ease-in-out infinite; }
.pet-rig.idle .cr-head-grp { animation: cat-head-idle 2.8s ease-in-out infinite; }
.pet-rig.idle .cr-tail     { animation: cat-tail 2.6s ease-in-out infinite; }
.pet-rig.idle .cr-eye      { animation: cat-blink 4.4s ease-in-out infinite; }

/* —— 走路 —— 四腿交替 + 身体上下颠 + 头点 + 尾巴快摆 */
.pet-rig.walking .cr-leg-front { animation: cat-leg-a 0.5s ease-in-out infinite; }
.pet-rig.walking .cr-leg-back  { animation: cat-leg-b 0.5s ease-in-out infinite; }
.pet-rig.walking .cr-body      { animation: cat-walk-bob 0.5s ease-in-out infinite; }
.pet-rig.walking .cr-head-grp  { animation: cat-head-walk 0.5s ease-in-out infinite; }
.pet-rig.walking .cr-tail      { animation: cat-tail 0.8s ease-in-out infinite; }
.pet-rig.walking .cr-eye       { animation: cat-blink 4.4s ease-in-out infinite; }

/* —— 一次性动作 —— 摸摸它=整只挤一下;开心=蹦两下;吃=低头啃 */
.pet-rig.do-happy        { animation: cat-squish 0.85s ease-in-out 1; }
.pet-rig.do-celebrating  { animation: cat-hop 0.6s ease-in-out 2; }
.pet-rig.do-eating .cr-head-grp { animation: cat-peck 0.42s ease-in-out 4; }

@keyframes cat-breath {
  0%, 100% { transform: scaleX(1)     scaleY(1); }
  45%      { transform: scaleX(0.985) scaleY(1.03) translateY(-3rpx); } /* 吸气:略瘦略高(保体积) */
  62%      { transform: scaleX(1.008) scaleY(0.992); }                  /* 小回弹,带点软软的惯性 */
}
@keyframes cat-head-idle {
  0%, 100% { transform: rotate(0deg) translateY(0); }
  50%      { transform: rotate(-1.5deg) translateY(-1rpx); }
}
@keyframes cat-tail {
  0%, 100% { transform: rotate(0deg); }
  35%      { transform: rotate(-12deg); }
  55%      { transform: rotate(-3deg); }   /* 甩过头再回摆 = 次级运动 */
  78%      { transform: rotate(-9deg); }
}
@keyframes cat-blink {
  0%, 90%, 100% { transform: scaleY(1); }
  95%           { transform: scaleY(0.08); }
}
@keyframes cat-leg-a {
  0%, 100% { transform: translateY(0)     rotate(0deg); }
  50%      { transform: translateY(-5rpx) rotate(7deg); }
}
@keyframes cat-leg-b {
  0%, 100% { transform: translateY(-5rpx) rotate(-7deg); }
  50%      { transform: translateY(0)     rotate(0deg); }
}
@keyframes cat-walk-bob {
  0%, 100% { transform: translateY(0)     scaleY(1)    scaleX(1); }
  25%      { transform: translateY(-5rpx) scaleY(1.03) scaleX(0.99); } /* 腾空:抻 */
  50%      { transform: translateY(0)     scaleY(0.97) scaleX(1.02); } /* 落地:压 */
  75%      { transform: translateY(-5rpx) scaleY(1.03) scaleX(0.99); }
}
@keyframes cat-head-walk {
  0%, 100% { transform: translateY(0)     rotate(0deg); }
  50%      { transform: translateY(-3rpx) rotate(-3deg); }
}
@keyframes cat-squish {
  0%   { transform: scaleX(1)    scaleY(1)    translateY(0); }
  12%  { transform: scaleX(0.96) scaleY(1.07) translateY(-7rpx); }   /* 预备:先轻轻抻一下 */
  34%  { transform: scaleX(1.20) scaleY(0.78) translateY(11rpx); }   /* 主挤:又扁又宽,压到脚 */
  54%  { transform: scaleX(0.89) scaleY(1.15) translateY(-19rpx); }  /* 过冲:弹得又高又瘦 */
  70%  { transform: scaleX(1.08) scaleY(0.95) translateY(2rpx); }    /* 回弹抖动 1 */
  84%  { transform: scaleX(0.98) scaleY(1.03) translateY(-4rpx); }   /* 回弹抖动 2(衰减) */
  100% { transform: scaleX(1)    scaleY(1)    translateY(0); }
}
@keyframes cat-hop {
  0%, 100% { transform: translateY(0)     scaleY(1); }
  35%      { transform: translateY(-22rpx) scaleY(1.06); }
  70%      { transform: translateY(0)     scaleY(0.95); }
}
@keyframes cat-peck {
  0%, 100% { transform: translateY(0)    rotate(0deg); }
  50%      { transform: translateY(6rpx) rotate(7deg); }
}

/* mood-emoji 浮在宠物「头部」一侧:头在脸朝的那边(face-right→右上 / face-left→
   左上),所以这里按朝向把图标摆到头那侧,转向后会跟着换边。 */
.state-icon {
  position: absolute;
  top: -8rpx;
  font-size: 42rpx;
  line-height: 1;
  z-index: 3;
}
.pet-actor.face-right .state-icon { right: 2rpx; left: auto; }
.pet-actor.face-left  .state-icon { left: 2rpx;  right: auto; }
.hungry-icon { animation: float-up 1.6s ease-in-out infinite; }
.dirty-icon  { animation: drift 2s ease-in-out infinite; }
.sick-icon   { animation: tremble 0.5s ease-in-out infinite; }
.sad-icon    { animation: drip 2.2s ease-in infinite; }
.happy-icon  { animation: pop-heart 1.2s ease-out infinite; }

/* 摸摸它飘出的爱心粒子:从宠物上半身往上飘、放大再淡出,带点左右摆。每颗的
   left 起点 / 时长由 JS 抖动;animation-fill:forwards 让它停在淡出末态等 JS 清除。 */
.love-heart {
  position: absolute;
  top: 22%;
  font-size: 38rpx;
  line-height: 1;
  z-index: 5;
  pointer-events: none;
  animation: love-heart 1.3s ease-out forwards;
  will-change: transform, opacity;
}
@keyframes love-heart {
  0%   { opacity: 0;    transform: translate(0, 8rpx)      scale(0.4); }
  14%  { opacity: 1;    transform: translate(0, -14rpx)    scale(1.18); }
  55%  { opacity: 0.95; transform: translate(-12rpx, -84rpx)  scale(1); }
  100% { opacity: 0;    transform: translate(12rpx, -156rpx)  scale(0.82); }
}

/* 说话气泡:挂在宠物头顶(.pet-actor 的子元素,随宠物移动 + 跟深度缩放;在
   actor-facing 之外,朝左时文字不会被镜像)。偏向脸朝的那侧 = 头部上方,
   下方小三角指向宠物。 */
.speech-bubble {
  position: absolute;
  left: 50%;
  bottom: 100%;
  margin-bottom: 12rpx;
  transform: translateX(-50%);
  transform-origin: 50% 100%;
  /* 单行不换行:气泡宽度跟文字走,不被「left 偏移后剩下的可用宽度」压窄
     (否则 face-right 时 left:64% 只剩 ~86rpx,中文被挤成很窄很高)。
     说话短句最长 8 字 ≈ 250rpx,远小于 max-width,不会溢出。 */
  white-space: nowrap;
  max-width: 460rpx;
  background: rgba(255, 255, 255, 0.97);
  color: #1f2329;
  font-size: 26rpx;
  line-height: 1.35;
  padding: 12rpx 22rpx;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.16);
  z-index: 10;
  animation: bubble-pop 0.25s ease-out;
}
.pet-actor.face-right .speech-bubble { left: 64%; }
.pet-actor.face-left  .speech-bubble { left: 36%; }
.speech-bubble::after {
  content: '';
  position: absolute;
  left: 50%; bottom: -12rpx; margin-left: -9rpx;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 14rpx solid rgba(255, 255, 255, 0.97);
}

/* === 点宠物弹出的气泡菜单(popover,非模态) === */
.popover-catch {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 130;
  background: transparent;   /* 不是遮罩,只用来接收外部点击关闭 */
}
.pet-popover {
  position: absolute;
  transform: translate(-50%, calc(-100% - 210rpx));   /* 浮到宠物头顶上方 */
  transform-origin: 50% 100%;
  min-width: 300rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 14rpx 36rpx rgba(60, 40, 15, 0.26);
  animation: popover-pop 0.18s ease-out;
}
.pet-popover::after {
  content: '';
  position: absolute; left: 50%; bottom: -14rpx; margin-left: -11rpx;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 16rpx solid #ffffff;
}
.pet-popover-item {
  white-space: nowrap;
  height: 88rpx; padding: 0 28rpx;
  display: flex; align-items: center;
  font-size: 30rpx; color: #1f2329; font-weight: 600;
  border-radius: 16rpx;
}
.pet-popover-item-hover { background: #f0f3f8; }
.pet-popover-divider { height: 2rpx; background: #eef1f5; margin: 0 16rpx; }
.pmi-emoji { font-size: 36rpx; margin-right: 14rpx; }
@keyframes popover-pop {
  0%   { opacity: 0; transform: translate(-50%, calc(-100% - 210rpx)) scale(0.7); }
  100% { opacity: 1; transform: translate(-50%, calc(-100% - 210rpx)) scale(1); }
}

/* === 房间小书桌(角落)+ 学习角菜单 === */
.room-desk {
  position: absolute; left: 1.5%; top: 40%;
  width: 168rpx;
  display: flex; flex-direction: column; align-items: center;
  /* z-index 跟深度挂钩(actorZ = 10 + y%):书桌底座 ≈ y49 → 58,宠物走到更近(y>49)
     时 actorZ>58 盖住书桌,走到更远时被书桌挡 —— 符合 2.5D 前后关系。 */
  z-index: 58;
}
.room-desk-art { width: 168rpx; height: 124rpx; display: block; }
.room-desk-hover { opacity: 0.82; }
.desk-hint {
  margin-bottom: 2rpx;
  font-size: 19rpx; color: #6b4f2a; font-weight: 700;
  background: rgba(255, 245, 224, 0.94); border-radius: 999rpx;
  padding: 3rpx 14rpx; line-height: 1.5;
  box-shadow: 0 2rpx 8rpx rgba(120, 90, 50, 0.18);
  animation: desk-hint-bob 2.2s ease-in-out infinite;
}
@keyframes desk-hint-bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-4rpx); }
}
.desk-popover {
  position: fixed; left: 24rpx; top: 26%;
  min-width: 300rpx; max-width: 70%;
  background: #ffffff; border-radius: 24rpx; padding: 10rpx 6rpx;
  box-shadow: 0 14rpx 36rpx rgba(60, 40, 15, 0.26);
  transform-origin: 18% 100%;
  animation: desk-pop 0.18s ease-out;
}
@keyframes desk-pop {
  0%   { opacity: 0; transform: scale(0.7); }
  100% { opacity: 1; transform: scale(1); }
}
.desk-popover-title {
  font-size: 23rpx; color: #8a94a4; font-weight: 700;
  padding: 10rpx 24rpx 8rpx;
}
.desk-popover-note {
  font-size: 23rpx; color: #9aa3ad;
  padding: 12rpx 24rpx; line-height: 1.5; white-space: normal;
}
@keyframes shadow-pulse {
  0%, 100% { transform: scaleX(1);    opacity: 0.18; }
  50%      { transform: scaleX(0.85); opacity: 0.12; }
}
@keyframes float-up {
  0%   { transform: translateY(0);     opacity: 0; }
  20%  { opacity: 1; }
  100% { transform: translateY(-40rpx); opacity: 0; }
}
@keyframes drift {
  0%, 100% { transform: translateY(-6rpx) rotate(-10deg); opacity: 0.5; }
  50%      { transform: translateY(6rpx)  rotate(10deg);  opacity: 1; }
}
@keyframes tremble {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(-2rpx, 2rpx); }
}
@keyframes drip {
  0%   { transform: translateY(-10rpx); opacity: 0; }
  50%  { opacity: 1; }
  100% { transform: translateY(20rpx);  opacity: 0; }
}
@keyframes pop-heart {
  0%   { transform: scale(0.6); opacity: 0; }
  50%  { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0; }
}
@keyframes bubble-pop {
  0%   { transform: translateX(-50%) scale(0.6); opacity: 0; }
  100% { transform: translateX(-50%) scale(1);   opacity: 1; }
}

/* ============================================================
   Parrot — layered rig prototype for V1-PET-ANIMATION-SPEC.
   Other species keep using `.pet-art` + `anim-{{animState}}`.
   The parrot uses two nested transform layers so locomotion
   (whole-figure translate) and posture (stage breath/bounce)
   can compose without fighting over `transform`. Per-part
   transforms (wing flap, head nod, eye blink) live on the
   inner <image class="part …"> elements.
   ============================================================ */
.parrot-figure {
  width: 280rpx;
  height: 280rpx;
}
.parrot-stage {
  position: relative;
  width: 100%;
  height: 100%;
  transform-origin: center bottom;
}
.parrot-figure .part {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}
/* Pivot points are expressed as percentages of the 200-unit viewBox so
   they line up with the original parrot.svg coordinates. */
.part-wing-left  { transform-origin: 29% 65%; } /* shoulder ≈ (58,130)  */
.part-wing-right { transform-origin: 71% 65%; } /* shoulder ≈ (142,130) */
.part-head       { transform-origin: 50% 56%; } /* neck base ≈ (100,112) */
.part-eyes       { transform-origin: 50% 35%; } /* eye row  ≈ (100,70)  */
.part-body       { transform-origin: 50% 70%; }

/* === IDLE: gentle breath + occasional blink + tiny wing flutter === */
.parrot-anim-idle .parrot-stage     { animation: parrot-breath      3.0s ease-in-out infinite; }
.parrot-anim-idle .part-eyes        { animation: parrot-blink       4.5s ease-in-out infinite; }
.parrot-anim-idle .part-wing-left   { animation: parrot-flutter-l   3.0s ease-in-out infinite; }
.parrot-anim-idle .part-wing-right  { animation: parrot-flutter-r   3.0s ease-in-out infinite; }

/* === WALKING: figure translates X, stage bobs Y, wings flutter faster === */
.parrot-anim-walking                { animation: parrot-walk-x      9s   ease-in-out infinite; }
.parrot-anim-walking .parrot-stage  { animation: parrot-walk-bounce 0.55s ease-in-out infinite; }
.parrot-anim-walking .part-wing-left  { animation: parrot-flutter-l 0.55s ease-in-out infinite; }
.parrot-anim-walking .part-wing-right { animation: parrot-flutter-r 0.55s ease-in-out infinite; }
.parrot-anim-walking .part-eyes     { animation: parrot-blink       4.5s ease-in-out infinite; }

/* === FLYING: cross-screen X arc, Y rise, wings flap fast === */
.parrot-anim-flying                 { animation: parrot-fly-x       3.5s ease-in-out 1; }
.parrot-anim-flying .parrot-stage   { animation: parrot-fly-y       3.5s ease-in-out 1; }
.parrot-anim-flying .part-wing-left  { animation: parrot-flap-l-fast 0.16s ease-in-out infinite; }
.parrot-anim-flying .part-wing-right { animation: parrot-flap-r-fast 0.16s ease-in-out infinite; }

/* === EATING: head nods, body sways === */
.parrot-anim-eating .part-head      { animation: parrot-nod         0.42s ease-in-out infinite; }
.parrot-anim-eating .part-eyes      { animation: parrot-nod         0.42s ease-in-out infinite; }
.parrot-anim-eating .parrot-stage   { animation: parrot-sway        0.84s ease-in-out infinite; }

/* === CELEBRATING: 3D-feel rotateY spin + two jumps + big wing flaps === */
/* rotateY (with perspective) sells a true 3D rotation: at 90°/270° the flat
   sprite flattens edge-on, suggesting the parrot is showing its side/back. */
.parrot-anim-celebrating              { animation: parrot-celebrate-rot-3d 2s ease-in-out 1; }
.parrot-anim-celebrating .parrot-stage{ animation: parrot-celebrate-jump   1s ease-in-out 2; }
.parrot-anim-celebrating .part-wing-left  { animation: parrot-flap-l-big 0.22s ease-in-out infinite; }
.parrot-anim-celebrating .part-wing-right { animation: parrot-flap-r-big 0.22s ease-in-out infinite; }

/* === SLEEPING: very slow breath, eyes squashed shut === */
.parrot-anim-sleeping .parrot-stage { animation: parrot-sleep-breath 4s   ease-in-out infinite; }
.parrot-anim-sleeping .part-eyes    { transform: scaleY(0.05); }

/* --- keyframes --- */
@keyframes parrot-breath {
  0%, 100% { transform: scale(1.00) translateY(0); }
  50%      { transform: scale(1.03) translateY(-4rpx); }
}
@keyframes parrot-blink {
  0%, 92%, 100% { transform: scaleY(1); }
  95%, 97%      { transform: scaleY(0.05); }
}
@keyframes parrot-flutter-l {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(-6deg); }
}
@keyframes parrot-flutter-r {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(6deg); }
}
@keyframes parrot-walk-x {
  0%,  100% { transform: translateX(0); }
  25%       { transform: translateX(-80rpx); }
  50%       { transform: translateX(0); }
  75%       { transform: translateX(80rpx); }
}
@keyframes parrot-walk-bounce {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}
@keyframes parrot-fly-x {
  0%   { transform: translateX(-260rpx); opacity: 0; }
  10%  { transform: translateX(-220rpx); opacity: 1; }
  90%  { transform: translateX(220rpx);  opacity: 1; }
  100% { transform: translateX(260rpx);  opacity: 0; }
}
@keyframes parrot-fly-y {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-60rpx); }
}
@keyframes parrot-flap-l-fast {
  0%, 100% { transform: rotate(15deg); }
  50%      { transform: rotate(-30deg); }
}
@keyframes parrot-flap-r-fast {
  0%, 100% { transform: rotate(-15deg); }
  50%      { transform: rotate(30deg); }
}
@keyframes parrot-flap-l-big {
  0%, 100% { transform: rotate(20deg); }
  50%      { transform: rotate(-50deg); }
}
@keyframes parrot-flap-r-big {
  0%, 100% { transform: rotate(-20deg); }
  50%      { transform: rotate(50deg); }
}
@keyframes parrot-nod {
  0%, 100% { transform: rotate(0deg)   translateY(0); }
  50%      { transform: rotate(-22deg) translateY(6rpx); }
}
@keyframes parrot-sway {
  0%, 100% { transform: translateX(0); }
  25%      { transform: translateX(-6rpx); }
  75%      { transform: translateX(6rpx); }
}
@keyframes parrot-celebrate-rot-3d {
  0%   { transform: perspective(600px) rotateY(0deg); }
  100% { transform: perspective(600px) rotateY(360deg); }
}
@keyframes parrot-celebrate-jump {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-50rpx); }
}
@keyframes parrot-sleep-breath {
  0%, 100% { transform: scale(1.00) translateY(0); }
  50%      { transform: scale(0.97) translateY(2rpx); }
}

/* ============================================================
   Parrot — side-view rig (V1-PET-ANIMATION-SPEC §1.1).
   walking / flying / eating swap from front to side so the
   parrot reads as a real 3D body, not a flat sprite. The
   side-flip wrapper handles direction reversal (scaleX) for
   walking; eating layers a small rotateY perspective so the
   peck angle reads as 3/4 view, not pure profile.
   ============================================================ */
.rig-side {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: none;
}
.rig-side .side-flip {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-origin: center bottom;
}
/* Side-rig pivots — percentages map back to the 200-unit viewBox of each
   side-* SVG so transforms hinge at the right anatomical point. */
.part-side-body      { transform-origin: 54% 65%; }
.part-side-head      { transform-origin: 61% 54%; } /* neck base ≈ (122,108) */
.part-side-eye       { transform-origin: 71% 37%; }
.part-side-wing      { transform-origin: 47% 50%; } /* shoulder ≈ (95,100)  */
.part-side-leg-front { transform-origin: 59% 88%; }
.part-side-leg-back  { transform-origin: 48% 88%; }

/* Show the side rig (and hide the front one) for states that use it. */
.parrot-anim-walking .rig-front,
.parrot-anim-flying  .rig-front,
.parrot-anim-eating  .rig-front  { display: none; }
.parrot-anim-walking .rig-side,
.parrot-anim-flying  .rig-side,
.parrot-anim-eating  .rig-side   { display: block; }

/* === WALKING (side): mirror at each direction reversal + step legs === */
.parrot-anim-walking .side-flip {
  /* Snap-flip aligned with parrot-walk-x: face-left → face-right → face-left.
     steps(1, jump-end) keeps each segment a constant scaleX. */
  animation: parrot-walk-flip 9s steps(1, jump-end) infinite;
}
.parrot-anim-walking .part-side-leg-front {
  animation: parrot-leg-step-a 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-leg-back {
  animation: parrot-leg-step-b 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-wing {
  animation: parrot-side-flutter 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-head {
  animation: parrot-side-head-bob 0.55s ease-in-out infinite;
}
.parrot-anim-walking .part-side-eye {
  animation: parrot-blink 4.5s ease-in-out infinite;
}

/* === FLYING (side): big wing flap, side rig stays facing right === */
.parrot-anim-flying .part-side-wing {
  animation: parrot-side-flap-fast 0.18s ease-in-out infinite;
}
.parrot-anim-flying .part-side-eye {
  animation: parrot-blink 4.5s ease-in-out infinite;
}

/* === EATING (side, 3/4 perspective): peck head down, body sways === */
.parrot-anim-eating .side-flip {
  transform: perspective(500px) rotateY(-22deg);
}
.parrot-anim-eating .part-side-head {
  animation: parrot-side-peck 0.42s ease-in-out infinite;
}
.parrot-anim-eating .part-side-eye {
  animation: parrot-side-peck 0.42s ease-in-out infinite;
  transform-origin: 61% 54%;  /* match head pivot so eye rides with the peck */
}

/* --- side-rig keyframes --- */
@keyframes parrot-walk-flip {
  0%   { transform: scaleX(-1); }  /* heading left from center */
  25%  { transform: scaleX(1);  }  /* turn at peak left, head back to right */
  75%  { transform: scaleX(-1); }  /* turn at peak right, head back to left */
}
@keyframes parrot-leg-step-a {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}
@keyframes parrot-leg-step-b {
  0%, 100% { transform: translateY(-6rpx); }
  50%      { transform: translateY(0); }
}
@keyframes parrot-side-flutter {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(-6deg); }
}
@keyframes parrot-side-head-bob {
  0%, 100% { transform: translateY(0)     rotate(0deg); }
  50%      { transform: translateY(-2rpx) rotate(-2deg); }
}
@keyframes parrot-side-flap-fast {
  0%, 100% { transform: rotate(20deg); }
  50%      { transform: rotate(-35deg); }
}
@keyframes parrot-side-peck {
  0%, 100% { transform: rotate(0deg)  translateY(0); }
  50%      { transform: rotate(28deg) translateY(8rpx); }
}

/* === stats === */
.pet-meta {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  color: #6b7785;
  justify-content: center;
}
.pet-meta .dot { color: #c7cdd6; }

.level-block {
  margin-top: 18rpx;
  padding: 18rpx 20rpx 16rpx;
  background: #f7f8fa;
  border-radius: 18rpx;
}
.level-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.level-label {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 600;
}
.level-cost {
  font-size: 24rpx;
  color: #6b7785;
  font-weight: 500;
}
.level-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7785;
  line-height: 1.5;
}

.level-up-btn {
  margin-top: 12rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: #245bdb;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  box-sizing: border-box;
}
.level-up-btn.disabled {
  background: #c7cdd6;
  color: #f7f8fa;
}
.level-up-btn::after { border: none; }

/* === XP progress bar — 替换原来的"花 N 金币"行 === */
.xp-bar {
  margin-top: 10rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #edf0f3;
  overflow: hidden;
  position: relative;
}
.xp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6aa6ff 0%, #245bdb 100%);
  border-radius: 999rpx;
  transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}
/* 经验值满 → 进度条变金色 + 微微脉动,提示"可以点升级了"。 */
.xp-bar-ready .xp-bar-fill {
  background: linear-gradient(90deg, #ffcf6a 0%, #ff9c1f 100%);
  animation: xp-ready-pulse 1.6s ease-in-out infinite;
}
.xp-bar-max .xp-bar-fill {
  background: linear-gradient(90deg, #ffd166 0%, #f5a623 100%);
}
@keyframes xp-ready-pulse {
  0%, 100% { filter: brightness(1);    box-shadow: 0 0 0 rgba(255, 156, 31, 0); }
  50%      { filter: brightness(1.15); box-shadow: 0 0 12rpx rgba(255, 156, 31, 0.5); }
}

/* 下一小时预览段:贴在主蓝条右侧,由 0 逐步长到 --preview-width(%),
   完成后停一小段再循环,看起来像"经验在慢慢涨"。border-radius 只取右端,
   防止跟主条左端拼接处出现圆角断层。
   颜色:左端 = 主条右端同色 #245bdb 实色(无缝衔接,消除原版的"白色间隙"
   视觉断层),向右渐变到非常浅的蓝色 #dceaff —— 距离越远越浅,直观体现
   "即将获得但还没拿到"。无 opacity 整体衰减(否则左端不是真的同色)。 */
.xp-bar-preview {
  position: absolute;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #245bdb 0%, #dceaff 100%);
  border-radius: 0 999rpx 999rpx 0;
  animation: xp-preview-grow 2.4s ease-in-out infinite;
}
/* width 补 +9rpx 是 wxml 里 left 减了 9rpx 的对应补偿 —— 让最终视觉上预览段
   还是 --preview-width %(下一小时实发 XP 长度),左端往左挪只是为了盖主条圆角。 */
@keyframes xp-preview-grow {
  0%   { width: 0;                                 opacity: 0; }
  10%  {                                           opacity: 1; }
  70%  { width: calc(var(--preview-width) + 9rpx); opacity: 1; }
  90%  { width: calc(var(--preview-width) + 9rpx); opacity: 0; }
  100% { width: 0;                                 opacity: 0; }
}

/* === 升级动画 overlay === */
.level-up-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at center, rgba(20, 30, 60, 0.55) 0%, rgba(20, 30, 60, 0.85) 100%);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: level-up-fade-in 0.18s ease-out;
}
@keyframes level-up-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.level-up-text {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.level-up-line-1 {
  font-size: 56rpx;
  font-weight: 900;
  color: #ffd166;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 18rpx rgba(255, 209, 102, 0.6),
               0 0 32rpx rgba(255, 209, 102, 0.45);
  animation: level-up-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.level-up-line-2 {
  font-size: 140rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 6rpx 24rpx rgba(255, 255, 255, 0.4),
               0 0 60rpx rgba(255, 209, 102, 0.55);
  animation: level-up-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}
@keyframes level-up-pop {
  0%   { transform: scale(0.2) rotate(-8deg); opacity: 0; }
  60%  { transform: scale(1.15) rotate(2deg); opacity: 1; }
  100% { transform: scale(1) rotate(0);       opacity: 1; }
}
.level-up-burst {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.level-up-star {
  position: absolute;
  top: 50%;
  left: 50%;
  font-size: 56rpx;
  line-height: 1;
  opacity: 0;
  animation: star-fly 1.6s ease-out 0.3s forwards;
}
/* 6 颗星呈放射状散开。每颗 angle / distance 不一样,通过 --tx --ty 自定义。 */
.star-1 { --tx: -340rpx; --ty: -260rpx; animation-delay: 0.30s; }
.star-2 { --tx:  340rpx; --ty: -260rpx; animation-delay: 0.36s; }
.star-3 { --tx: -380rpx; --ty:   40rpx; animation-delay: 0.42s; }
.star-4 { --tx:  380rpx; --ty:   40rpx; animation-delay: 0.48s; }
.star-5 { --tx: -300rpx; --ty:  280rpx; animation-delay: 0.54s; }
.star-6 { --tx:  300rpx; --ty:  280rpx; animation-delay: 0.60s; }
@keyframes star-fly {
  0%   { transform: translate(-50%, -50%) scale(0.4) rotate(0);    opacity: 0; }
  20%  { transform: translate(-50%, -50%) scale(1.4) rotate(40deg); opacity: 1; }
  100% {
    transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1) rotate(180deg);
    opacity: 0;
  }
}

.stat-block { margin-top: 18rpx; }
.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.stat-num {
  font-size: 24rpx;
  color: #44505e;
  font-weight: 600;
}
/* 开心度冻结提示 — 全完成后 12 小时内不下降的小标签。 */
.stat-hint {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e6f4ff;
  color: #1167b0;
  font-size: 22rpx;
  line-height: 1.5;
}

/* === shop === */
.shop-item-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.shop-item-text { flex: 1; }
.shop-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}
.shop-effect {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.buy-btn {
  background: #245bdb;
  color: #ffffff;
}

/* === switch-pet entry === */
.switch-card {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
}
.switch-row {
  display: flex;
  align-items: center;
}
.switch-emoji {
  font-size: 44rpx;
  margin-right: 18rpx;
}
.switch-text { flex: 1; }
.switch-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}
.switch-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7785;
}
.switch-chev {
  font-size: 40rpx;
  color: #c7cdd6;
  line-height: 1;
}

/* 顶部 "金币 X ›" 入口 — 点开金币记录 */
.coin-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff4d6;
}
.coin-link .coin-balance {
  color: #b45309;
  font-weight: 600;
}
.coin-link .coin-chev {
  font-size: 26rpx;
  line-height: 1;
  color: #b45309;
}

/* === switch-pet picker sheet === */
.switch-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
  animation: switch-fade 0.18s ease-out;
}
.switch-sheet {
  width: 100%;
  max-width: 720rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: switch-slide 0.22s ease-out;
}
.switch-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  text-align: center;
}
.switch-sheet-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7785;
  text-align: center;
}
.switch-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.switch-item {
  position: relative;
  padding: 18rpx 6rpx;
  border-radius: 22rpx;
  background: #f7f8fa;
  text-align: center;
  border: 2rpx solid transparent;
}
.switch-item.current {
  background: #eceef2;
  border-color: #c7cdd6;
  opacity: 0.6;
}
.switch-art {
  display: block;
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto;
}
.switch-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #44505e;
}
.switch-current-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #6b7785;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}
.switch-cancel {
  margin-top: 22rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #f7f8fa;
  color: #44505e;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
@keyframes switch-fade {
  0%   { opacity: 0; }
  100% { opacity: 1; }
}
@keyframes switch-slide {
  0%   { transform: translateY(100%); }
  100% { transform: translateY(0); }
}
