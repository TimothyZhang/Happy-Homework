.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}
.card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.08);
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 16rpx;
}
.desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.btn {
  background: #07c160;
  color: #fff;
  border: none;
  margin-bottom: 24rpx;
}
.tip {
  display: block;
  font-size: 28rpx;
  color: #333;
}
